@* Razor View: Laboratory/ReportDetails *@
<!-- HTML View: Laboratory/ReportDetails -->
@model DoctorAppointmentManagementSystem.Models.LabReport

@{
    ViewData["Title"] = "Lab Report Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Lab Report Details</h2>
    <a asp-action="Reports" class="btn btn-secondary">Back to List</a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Report Information</h5>
            </div>
            <div class="card-body">
<!-- Data Table Block -->
        <table class="table table-hover">
                    <tr>
                        <th style="width: 35%">Patient</th>
                        <td>@Model.Patient?.User?.Username</td>
                    </tr>
                    <tr>
                        <th>Patient Email</th>
                        <td>@Model.Patient?.User?.Email</td>
                    </tr>
                    <tr>
                        <th>Test Name</th>
                        <td>@Model.LabTest?.TestName</td>
                    </tr>
                    <tr>
                        <th>Test Price</th>
                        <td>৳@Model.LabTest?.Price</td>
                    </tr>
                    <tr>
                        <th>Report Date</th>
                        <td>@Model.ReportDate.ToString("dd MMM yyyy")</td>
                    </tr>
                    <tr>
                        <th>Result</th>
                        <td>@(string.IsNullOrEmpty(Model.Result) ? "Pending" : Model.Result)</td>
                    </tr>
                    <tr>
                        <th>Remarks</th>
                        <td>@(string.IsNullOrEmpty(Model.Remarks) ? "N/A" : Model.Remarks)</td>
                    </tr>
                </table>
            </div>
        </div>

        <div class="d-flex gap-2 justify-content-end">
            <a asp-action="EditReport" asp-route-id="@Model.Id" class="btn btn-warning">Edit Report</a>
            <a asp-action="DeleteReport" asp-route-id="@Model.Id" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this report?')">Delete Report</a>
        </div>
    </div>
</div>

