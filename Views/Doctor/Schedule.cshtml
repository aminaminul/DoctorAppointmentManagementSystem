@model List<DoctorAppointmentManagementSystem.Models.DoctorSchedule>
@{
    Layout = "_Layout";
    ViewData["Title"] = "My Schedule";
    int month      = ViewBag.Month;
    int year       = ViewBag.Year;
    int daysInMonth= ViewBag.DaysInMonth;
    int firstDay   = ViewBag.FirstDayOfWeek; // 0=Sun
    var bookedCounts = ViewBag.BookedCounts as Dictionary<DateTime, int>
                       ?? new Dictionary<DateTime, int>();

    // Build a lookup: date → schedule entry
    var scheduleByDate = Model.ToDictionary(s => s.AvailableDate.Date, s => s);

    // Prev/next month links
    var prevDate = new DateTime(year, month, 1).AddMonths(-1);
    var nextDate = new DateTime(year, month, 1).AddMonths(1);
}

<style>
.sched-wrapper { display:flex; min-height:calc(100vh - 72px); background:#f8fafc; }

/* ── Sidebar (reuse dashboard style) ─── */
.dash-sidebar {
    width:260px; flex-shrink:0;
    background:linear-gradient(180deg,#1e293b 0%,#0f172a 100%);
    padding:1.75rem 0;
    display:flex; flex-direction:column;
    position:sticky; top:0; height:100vh; overflow-y:auto;
}
.sidebar-profile { text-align:center; padding:0 1.5rem 1.5rem; border-bottom:1px solid rgba(255,255,255,.08); margin-bottom:1rem; }
.sidebar-avatar  { width:72px; height:72px; border-radius:50%; background:linear-gradient(135deg,#667eea,#764ba2); display:flex; align-items:center; justify-content:center; font-size:2rem; color:white; margin:0 auto .75rem; border:3px solid rgba(255,255,255,.15); }
.sidebar-name    { color:white; font-weight:700; font-size:.95rem; }
.sidebar-spec    { color:#94a3b8; font-size:.78rem; }
.nav-section-label { color:#475569; font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; padding:.5rem 1.5rem .25rem; }
.dash-nav-link { display:flex; align-items:center; gap:.75rem; padding:.65rem 1.5rem; color:#94a3b8; text-decoration:none; font-size:.875rem; font-weight:500; border-left:3px solid transparent; transition:all .2s; }
.dash-nav-link:hover { color:white; background:rgba(255,255,255,.05); }
.dash-nav-link.active { color:white; background:rgba(102,126,234,.15); border-left-color:#667eea; }
.dash-nav-link .nav-icon { width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:.9rem; flex-shrink:0; background:rgba(255,255,255,.05); }
.dash-nav-link.active .nav-icon { background:rgba(102,126,234,.3); }
.sidebar-footer { margin-top:auto; padding:1rem 1.5rem 0; }
.btn-logout { display:flex; align-items:center; justify-content:center; gap:.5rem; background:rgba(239,68,68,.1); color:#f87171; border:1px solid rgba(239,68,68,.2); border-radius:10px; padding:.6rem 1rem; width:100%; font-size:.875rem; font-weight:600; text-decoration:none; transition:all .2s; }
.btn-logout:hover { background:rgba(239,68,68,.2); color:#f87171; }

/* ── Main ──────────────────────────────────── */
.sched-main { flex:1; padding:2rem; overflow-y:auto; }

.sched-header { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1rem; margin-bottom:1.75rem; }
.sched-header h1 { font-size:1.4rem; font-weight:800; color:#1e293b; margin:0; }

/* Month nav */
.month-nav { display:flex; align-items:center; gap:.75rem; }
.month-nav-btn {
    width:36px; height:36px; border-radius:10px; border:2px solid #e2e8f0;
    background:white; display:flex; align-items:center; justify-content:center;
    text-decoration:none; color:#374151; font-size:.95rem; transition:all .2s;
}
.month-nav-btn:hover { border-color:#667eea; color:#667eea; }
.month-label { font-size:1.05rem; font-weight:700; color:#1e293b; min-width:160px; text-align:center; }

/* Calendar grid */
.cal-grid { background:white; border-radius:20px; box-shadow:0 2px 16px rgba(0,0,0,.07); overflow:hidden; margin-bottom:1.5rem; }
.cal-weekdays { display:grid; grid-template-columns:repeat(7,1fr); background:#f8fafc; border-bottom:1px solid #e2e8f0; }
.cal-weekday { padding:.75rem; text-align:center; font-size:.75rem; font-weight:700; color:#64748b; text-transform:uppercase; letter-spacing:.05em; }
.cal-days { display:grid; grid-template-columns:repeat(7,1fr); }
.cal-day {
    min-height:90px; padding:.5rem; border-right:1px solid #f1f5f9;
    border-bottom:1px solid #f1f5f9; position:relative;
    transition:background .15s;
}
.cal-day:hover { background:#fafbff; }
.cal-day.empty { background:#f9fafb; }
.cal-day.today { background:#fffbeb; }
.day-num {
    font-size:.82rem; font-weight:700; color:#94a3b8;
    display:inline-flex; align-items:center; justify-content:center;
    width:26px; height:26px; border-radius:50%;
}
.cal-day.today .day-num { background:#f59e0b; color:white; }

/* Slot chips inside calendar */
.slot-chip {
    display:block; border-radius:6px;
    padding:.18rem .45rem; font-size:.7rem; font-weight:600;
    margin-top:.25rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
    cursor:pointer; text-decoration:none;
}
.chip-available { background:#d1fae5; color:#065f46; }
.chip-vacation  { background:#ffedd5; color:#9a3412; }
.chip-booked    { background:#dbeafe; color:#1e40af; }
.chip-blocked   { background:#fee2e2; color:#991b1b; }

/* Legend */
.legend { display:flex; flex-wrap:wrap; gap:1rem; margin-bottom:1.5rem; }
.legend-item { display:flex; align-items:center; gap:.4rem; font-size:.78rem; font-weight:600; color:#374151; }
.legend-dot { width:12px; height:12px; border-radius:3px; }

/* List table */
.sched-table { width:100%; border-collapse:collapse; }
.sched-table th { padding:.75rem 1.25rem; text-align:left; font-size:.75rem; font-weight:700; color:#64748b; text-transform:uppercase; letter-spacing:.05em; background:#f8fafc; border-bottom:1px solid #f1f5f9; }
.sched-table td { padding:.875rem 1.25rem; border-bottom:1px solid #f8fafc; font-size:.875rem; color:#374151; vertical-align:middle; }
.sched-table tr:last-child td { border-bottom:none; }

/* Action buttons */
.btn-sm-action { display:inline-flex; align-items:center; gap:.25rem; padding:.3rem .65rem; border-radius:8px; font-size:.75rem; font-weight:600; border:none; cursor:pointer; text-decoration:none; transition:all .2s; }
.btn-edit { background:#fef3c7; color:#92400e; }
.btn-edit:hover { background:#fde68a; color:#78350f; }
.btn-del  { background:#fee2e2; color:#991b1b; }
.btn-del:hover  { background:#fecaca; color:#7f1d1d; }

/* Vacation panel */
.vacation-panel { background:white; border-radius:16px; box-shadow:0 2px 12px rgba(0,0,0,.06); padding:1.5rem; margin-bottom:1.5rem; }
.vacation-panel h3 { font-size:.95rem; font-weight:700; color:#1e293b; margin-bottom:1rem; display:flex; align-items:center; gap:.5rem; }

/* Alerts */
.dash-alert-success { background:#d1fae5; color:#065f46; border-radius:12px; padding:.85rem 1.2rem; margin-bottom:1.25rem; display:flex; align-items:center; gap:.6rem; font-weight:500; font-size:.875rem; }
.dash-alert-error   { background:#fee2e2; color:#991b1b; border-radius:12px; padding:.85rem 1.2rem; margin-bottom:1.25rem; display:flex; align-items:center; gap:.6rem; font-weight:500; font-size:.875rem; }

.form-control-sm2, .form-select-sm2 {
    border:2px solid #e2e8f0; border-radius:10px; padding:.45rem .85rem; font-size:.85rem;
}
.form-control-sm2:focus, .form-select-sm2:focus { border-color:#667eea; outline:none; box-shadow:0 0 0 3px rgba(102,126,234,.12); }

.btn-add-sched { display:inline-flex; align-items:center; gap:.5rem; background:linear-gradient(135deg,#667eea,#764ba2); color:white; border:none; border-radius:12px; padding:.65rem 1.5rem; font-weight:700; font-size:.875rem; cursor:pointer; text-decoration:none; transition:all .3s; }
.btn-add-sched:hover { transform:translateY(-2px); box-shadow:0 6px 20px rgba(102,126,234,.4); color:white; }

.empty-state { text-align:center; padding:3rem 1rem; color:#94a3b8; }
.empty-state i { font-size:3rem; display:block; margin-bottom:.75rem; }
</style>

<div class="sched-wrapper">

    <!-- ── SIDEBAR ── -->
    <aside class="dash-sidebar">
        <div class="sidebar-profile">
            <div class="sidebar-avatar"><i class="bi bi-person-circle"></i></div>
            <div class="sidebar-name">Dr. @ViewBag.DoctorName</div>
        </div>
        <span class="nav-section-label">Main</span>
        <a href="/Doctor/Dashboard" class="dash-nav-link">
            <span class="nav-icon"><i class="bi bi-speedometer2"></i></span>Overview
        </a>
        <a href="/Doctor/Dashboard?section=appointments" class="dash-nav-link">
            <span class="nav-icon"><i class="bi bi-calendar-check"></i></span>Appointments
        </a>
        <span class="nav-section-label">Schedule</span>
        <a href="/Doctor/Schedule" class="dash-nav-link active">
            <span class="nav-icon"><i class="bi bi-calendar3"></i></span>My Schedule
        </a>
        <a href="/Doctor/AddSchedule" class="dash-nav-link">
            <span class="nav-icon"><i class="bi bi-calendar-plus"></i></span>Add Schedule
        </a>
        <span class="nav-section-label">Account</span>
        <a href="/Doctor/Dashboard?section=profile" class="dash-nav-link">
            <span class="nav-icon"><i class="bi bi-person-badge"></i></span>My Profile
        </a>
        <div class="sidebar-footer">
            <a href="/Account/Logout" class="btn-logout">
                <i class="bi bi-box-arrow-right"></i>Logout
            </a>
        </div>
    </aside>

    <!-- ── MAIN ── -->
    <main class="sched-main">

        @if (TempData["Success"] != null)
        {
            <div class="dash-alert-success"><i class="bi bi-check-circle-fill"></i>@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="dash-alert-error"><i class="bi bi-exclamation-circle-fill"></i>@TempData["Error"]</div>
        }

        <!-- Header -->
        <div class="sched-header">
            <div>
                <h1><i class="bi bi-calendar3 me-2" style="color:#667eea;"></i>My Schedule</h1>
                <p style="color:#64748b;margin:0;font-size:.9rem;">Manage your availability, working hours, break times &amp; vacation</p>
            </div>
            <a href="/Doctor/AddSchedule" class="btn-add-sched">
                <i class="bi bi-plus-circle-fill"></i>Add Schedule
            </a>
        </div>

        <!-- Month navigation -->
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem;margin-bottom:1.25rem;">
            <div class="month-nav">
                <a href="/Doctor/Schedule?month=@prevDate.Month&year=@prevDate.Year" class="month-nav-btn">
                    <i class="bi bi-chevron-left"></i>
                </a>
                <span class="month-label">@ViewBag.MonthName</span>
                <a href="/Doctor/Schedule?month=@nextDate.Month&year=@nextDate.Year" class="month-nav-btn">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </div>
            <div class="legend">
                <span class="legend-item"><span class="legend-dot" style="background:#d1fae5;"></span>Available</span>
                <span class="legend-item"><span class="legend-dot" style="background:#ffedd5;"></span>Vacation</span>
                <span class="legend-item"><span class="legend-dot" style="background:#dbeafe;"></span>Booked</span>
                <span class="legend-item"><span class="legend-dot" style="background:#fee2e2;"></span>Blocked</span>
            </div>
        </div>

        <!-- Calendar grid -->
        <div class="cal-grid">
            <div class="cal-weekdays">
                @foreach (var day in new[] { "Sun","Mon","Tue","Wed","Thu","Fri","Sat" })
                {
                    <div class="cal-weekday">@day</div>
                }
            </div>
            <div class="cal-days">
                @* Empty leading cells *@
                @for (int i = 0; i < firstDay; i++) { <div class="cal-day empty"></div> }

                @for (int d = 1; d <= daysInMonth; d++)
                {
                    var date = new DateTime(year, month, d);
                    bool isToday = date.Date == DateTime.Today;
                    scheduleByDate.TryGetValue(date.Date, out var entry);
                    bookedCounts.TryGetValue(date.Date, out int booked);

                    <div class="cal-day @(isToday ? "today" : "")">
                        <span class="day-num">@d</span>

                        @if (entry != null)
                        {
                            if (entry.IsVacation)
                            {
                                <a href="/Doctor/EditSchedule/@entry.Id" class="slot-chip chip-vacation">
                                    <i class="bi bi-umbrella-fill me-1"></i>Vacation
                                </a>
                            }
                            else
                            {
                                <a href="/Doctor/EditSchedule/@entry.Id" class="slot-chip chip-available">
                                    <i class="bi bi-clock me-1"></i>@entry.StartTime–@entry.EndTime
                                </a>
                                @if (!string.IsNullOrEmpty(entry.BreakStartTime))
                                {
                                    <span class="slot-chip" style="background:#f3f4f6;color:#6b7280;">
                                        <i class="bi bi-cup-hot me-1"></i>Break @entry.BreakStartTime
                                    </span>
                                }
                            }
                        }

                        @if (booked > 0)
                        {
                            <span class="slot-chip chip-booked">
                                <i class="bi bi-people me-1"></i>@booked booked
                            </span>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Vacation Range Form -->
        <div class="vacation-panel">
            <h3><i class="bi bi-umbrella-fill" style="color:#f59e0b;"></i>Set Vacation / Leave Range</h3>
            <form method="post" action="/Doctor/SetVacationRange" style="display:flex;flex-wrap:wrap;gap:.75rem;align-items:flex-end;">
                @Html.AntiForgeryToken()
                <div>
                    <label style="font-size:.78rem;font-weight:600;color:#374151;display:block;margin-bottom:.3rem;">From</label>
                    <input type="date" name="from" class="form-control-sm2"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>
                <div>
                    <label style="font-size:.78rem;font-weight:600;color:#374151;display:block;margin-bottom:.3rem;">To</label>
                    <input type="date" name="to" class="form-control-sm2"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>
                <div style="flex:1;min-width:160px;">
                    <label style="font-size:.78rem;font-weight:600;color:#374151;display:block;margin-bottom:.3rem;">Reason (optional)</label>
                    <input type="text" name="notes" class="form-control-sm2" style="width:100%;"
                           placeholder="e.g. Public Holiday, Conference..." />
                </div>
                <button type="submit" style="display:inline-flex;align-items:center;gap:.4rem;background:linear-gradient(135deg,#f59e0b,#d97706);color:white;border:none;border-radius:10px;padding:.55rem 1.25rem;font-weight:700;font-size:.85rem;cursor:pointer;">
                    <i class="bi bi-umbrella"></i>Set Vacation
                </button>
            </form>
        </div>

        <!-- Schedule list table -->
        <div style="background:white;border-radius:16px;box-shadow:0 2px 12px rgba(0,0,0,.06);overflow:hidden;">
            <div style="padding:1.25rem 1.5rem;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;">
                <h2 style="font-size:1rem;font-weight:700;color:#1e293b;margin:0;display:flex;align-items:center;gap:.5rem;">
                    <i class="bi bi-list-ul" style="color:#667eea;"></i>
                    Schedule Entries — @ViewBag.MonthName
                </h2>
                <span style="font-size:.8rem;color:#94a3b8;">@Model.Count entries</span>
            </div>

            @if (Model.Any())
            {
                <table class="sched-table">
                    <thead><tr>
                        <th>Date</th><th>Day</th><th>Hours</th><th>Break</th><th>Type</th><th>Notes</th><th>Booked</th><th>Actions</th>
                    </tr></thead>
                    <tbody>
                    @foreach (var s in Model)
                    {
                        bookedCounts.TryGetValue(s.AvailableDate.Date, out int bc);
                        <tr>
                            <td><strong>@s.AvailableDate.ToString("MMM dd, yyyy")</strong></td>
                            <td>@s.AvailableDate.DayOfWeek</td>
                            <td>
                                @if (!s.IsVacation)
                                {
                                    <span>@s.StartTime – @s.EndTime</span>
                                }
                                else { <span style="color:#94a3b8;">—</span> }
                            </td>
                            <td style="font-size:.8rem;color:#64748b;">
                                @if (!string.IsNullOrEmpty(s.BreakStartTime))
                                { <span>@s.BreakStartTime – @s.BreakEndTime</span> }
                                else { <span>—</span> }
                            </td>
                            <td>
                                @if (s.IsVacation)
                                {
                                    <span style="background:#ffedd5;color:#9a3412;padding:.2rem .65rem;border-radius:20px;font-size:.73rem;font-weight:700;">
                                        <i class="bi bi-umbrella-fill me-1"></i>Vacation
                                    </span>
                                }
                                else
                                {
                                    <span style="background:#d1fae5;color:#065f46;padding:.2rem .65rem;border-radius:20px;font-size:.73rem;font-weight:700;">
                                        <i class="bi bi-check-circle me-1"></i>Available
                                    </span>
                                }
                            </td>
                            <td style="color:#64748b;font-size:.82rem;">@(s.Notes ?? "—")</td>
                            <td>
                                @if (bc > 0)
                                {
                                    <span style="background:#dbeafe;color:#1e40af;padding:.2rem .55rem;border-radius:20px;font-size:.73rem;font-weight:700;">
                                        @bc booked
                                    </span>
                                }
                                else { <span style="color:#94a3b8;font-size:.82rem;">0</span> }
                            </td>
                            <td style="white-space:nowrap;">
                                <a href="/Doctor/EditSchedule/@s.Id" class="btn-sm-action btn-edit">
                                    <i class="bi bi-pencil"></i>Edit
                                </a>
                                <form method="post" action="/Doctor/DeleteSchedule/@s.Id"
                                      style="display:inline;"
                                      onsubmit="return confirm('Remove this schedule entry?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-sm-action btn-del ms-1">
                                        <i class="bi bi-trash"></i>Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-calendar-x"></i>
                    <strong>No schedule entries for @ViewBag.MonthName.</strong>
                    <p class="mt-2" style="font-size:.875rem;">
                        <a href="/Doctor/AddSchedule" style="color:#667eea;">Add your first schedule →</a>
                    </p>
                </div>
            }
        </div>
    </main>
</div>
