@model DoctorAppointmentManagementSystem.Models.Prescription
@{
    Layout = null;
    ViewData["Title"] = "Prescription - #" + Model.Id;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Prescription - #@Model.Id</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        @@media print {
            .d-print-none { display: none !important; }
            body { background-color: #ffffff !important; padding: 0 !important; }
            .prescription-card { box-shadow: none !important; border: 1px solid #cbd5e1 !important; margin: 0 !important; width: 100% !important; max-width: 100% !important; padding: 20px !important; }
        }
        body { background-color: #f1f5f9; font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; color: #1e293b; }
        .prescription-card { max-width: 850px; margin: 25px auto; background: #ffffff; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.05); padding: 35px; border: 1px solid #e2e8f0; }
        .header-logo { width: 55px; height: 55px; background: #0d9488; color: white; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.75rem; }
        .seal-box { border: 2px dashed #cbd5e1; border-radius: 8px; height: 70px; display: flex; align-items: center; justify-content: center; color: #94a3b8; font-size: 0.8rem; font-weight: 600; }
    </style>
</head>
<body class="p-3">
    <div class="prescription-card position-relative">
        <!-- Header -->
        <div class="row border-bottom pb-4 mb-4 align-items-center">
            <div class="col-8 d-flex align-items-center gap-3">
                <div class="header-logo shadow-sm flex-shrink-0">
                    <i class="bi bi-hospital"></i>
                </div>
                <div>
                    <h3 class="fw-bold text-dark mb-0">Doctor Appointment Medical Center</h3>
                    <p class="text-muted small mb-0">Official Digital Medical Prescription &amp; Clinical Order</p>
                    <small class="text-muted">123 Healthcare Avenue, Medical District | Phone: +880 1700-000000</small>
                </div>
            </div>
            <div class="col-4 text-end">
                <div class="badge bg-success fs-6 mb-2"><i class="bi bi-prescription2 me-1"></i> Rx #@Model.Id</div>
                <div class="text-muted small">Date: @Model.PrescriptionDateTime.ToString("MMM dd, yyyy")</div>
                @if (Model.AppointmentId > 0)
                {
                    <div class="text-muted small">Appt #@Model.AppointmentId</div>
                }
            </div>
        </div>

        <!-- Doctor & Patient Info -->
        <div class="row bg-light p-3 rounded mb-4 border">
            <div class="col-md-6 border-end">
                <h6 class="text-secondary fw-bold text-uppercase mb-2">Prescribing Doctor</h6>
                <h5 class="fw-bold mb-1">@Model.Doctor?.User?.Username</h5>
                <p class="mb-1 text-primary small">@Model.Doctor?.Specialization</p>
                <small class="text-muted">@Model.Doctor?.Qualification | Experience: @Model.Doctor?.Experience yrs</small>
            </div>
            <div class="col-md-6 ps-md-4 mt-3 mt-md-0">
                <h6 class="text-secondary fw-bold text-uppercase mb-2">Patient Details</h6>
                <h5 class="fw-bold mb-1">@Model.Patient?.User?.Username</h5>
                <p class="mb-1 small text-muted">Gender: @Model.Patient?.Gender | Age: @Model.Patient?.Age yrs | Blood: @(Model.Patient?.BloodGroup ?? "N/A")</p>
                <small class="text-muted">Email: @Model.Patient?.User?.Email</small>
            </div>
        </div>

        <!-- Diagnosis & Vitals -->
        <div class="mb-4">
            <h6 class="fw-bold text-dark border-bottom pb-2 mb-2"><i class="bi bi-file-earmark-medical me-2"></i>Diagnosis & Clinical Notes</h6>
            <div class="p-3 bg-white border rounded">
                <strong>Diagnosis:</strong> @Model.Diagnosis
            </div>
        </div>

        <!-- Prescriptions Header & Medicines -->
        <div class="mb-4">
            <h4 class="fw-bold text-primary mb-3"><i class="bi bi-prescription me-2"></i>Prescribed Medicines</h4>
            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Medicine Details</th>
                            <th>Instructions / Frequency</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var meds = Model.Medicines.Split(new[] { '\n', ';' }, StringSplitOptions.RemoveEmptyEntries);
                            int index = 1;
                        }
                        @foreach (var med in meds)
                        {
                            <tr>
                                <td>@(index++)</td>
                                <td class="fw-bold text-dark">@med.Trim()</td>
                                <td>@(string.IsNullOrWhiteSpace(Model.Instructions) ? "As directed by physician" : Model.Instructions)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Footer & QR Code -->
        <div class="row pt-4 mt-4 border-top align-items-end">
            <div class="col-4">
                <div class="d-flex align-items-center gap-3">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=85x85&data=RX-@Model.Id-DOC-@Model.DoctorId-PAT-@Model.PatientId" alt="QR Code" class="img-thumbnail rounded" style="width: 80px; height: 80px;" />
                    <div>
                        <small class="fw-bold d-block text-dark">Digital Rx QR</small>
                        <small class="text-muted" style="font-size: 0.72rem;">Scan to verify validity</small>
                    </div>
                </div>
            </div>
            <div class="col-4 text-center">
                <div class="seal-box">
                    <i class="bi bi-patch-check-fill text-success me-1"></i> Hospital Digital Seal
                </div>
            </div>
            <div class="col-4 text-end">
                <div class="border-top pt-2 d-inline-block px-3">
                    <div class="fw-bold text-dark small">@(Model.Doctor?.User?.Username != null ? "Dr. " + Model.Doctor.User.Username : "Attending Physician")</div>
                    <div class="text-muted" style="font-size: 0.75rem;">Doctor's Digital Signature</div>
                </div>
            </div>
        </div>

        <div class="text-center text-muted mt-4 pt-3 border-top" style="font-size: 0.78rem;">
            This is a valid computer-generated medical prescription issued by Doctor Appointment Medical Center.
        </div>

        <!-- Print Action Buttons -->
        <div class="mt-4 pt-3 text-center d-print-none border-top">
            <button onclick="window.print()" class="btn btn-success px-4 py-2 me-2 rounded-pill fw-bold shadow-sm">
                <i class="bi bi-printer me-2"></i>Print Prescription / Save PDF
            </button>
            <button onclick="window.close()" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                <i class="bi bi-x-circle me-1"></i>Close Window
            </button>
        </div>
    </div>
</body>
</html>
