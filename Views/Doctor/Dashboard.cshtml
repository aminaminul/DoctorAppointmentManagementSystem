@model List<DoctorAppointmentManagementSystem.Models.Appointment>
@using DoctorAppointmentManagementSystem.Models

@{
    Layout = "_Layout";
    ViewData["Title"] = "Doctor Dashboard";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-3">
            @await Component.InvokeAsync("Sidebar")
        </div>
        <div class="col-md-9">
            <div class="card mb-3">
                <div class="card-body">
                    <h3 class="mb-0">Doctor Dashboard</h3>
                    <p class="text-muted small">Your upcoming appointments</p>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <ul class="list-group">
                        @foreach (var a in Model)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold">@a.Patient.User.Username</div>
                                    <small class="text-muted">@a.AppointmentDate.ToString("MMM dd, yyyy hh:mm tt")</small>
                                </div>
                                <span class="badge bg-primary">@a.AppointmentStatus</span>
                            </li>
                        }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">No upcoming appointments.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
