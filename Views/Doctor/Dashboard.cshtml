@model List<DoctorAppointmentManagementSystem.Models.Appointment>
@using DoctorAppointmentManagementSystem.Models

@{
    Layout = "_Layout";
    ViewData["Title"] = "Doctor Dashboard";
    string section = ViewBag.Section ?? "overview";
}

<style>
/* ── Dashboard Layout ─────────────────────────────────────── */
.dash-wrapper { display: flex; min-height: calc(100vh - 72px); background: #f8fafc; }

/* Sidebar */
.dash-sidebar {
    width: 260px; flex-shrink: 0;
    background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
    padding: 1.75rem 0;
    display: flex; flex-direction: column;
    position: sticky; top: 0; height: 100vh; overflow-y: auto;
}
.sidebar-profile {
    text-align: center; padding: 0 1.5rem 1.5rem;
    border-bottom: 1px solid rgba(255,255,255,.08); margin-bottom: 1rem;
}
.sidebar-avatar {
    width: 72px; height: 72px; border-radius: 50%;
    background: linear-gradient(135deg,#667eea,#764ba2);
    display: flex; align-items: center; justify-content: center;
    font-size: 2rem; color: white; margin: 0 auto .75rem;
    border: 3px solid rgba(255,255,255,.15);
}
.sidebar-name  { color: white; font-weight: 700; font-size: .95rem; margin-bottom: .15rem; }
.sidebar-spec  { color: #94a3b8; font-size: .78rem; }

.nav-section-label {
    color: #475569; font-size: .7rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: .1em;
    padding: .5rem 1.5rem .25rem;
}
.dash-nav-link {
    display: flex; align-items: center; gap: .75rem;
    padding: .65rem 1.5rem;
    color: #94a3b8; text-decoration: none;
    font-size: .875rem; font-weight: 500;
    border-left: 3px solid transparent;
    transition: all .2s;
}
.dash-nav-link:hover { color: white; background: rgba(255,255,255,.05); }
.dash-nav-link.active {
    color: white; background: rgba(102,126,234,.15);
    border-left-color: #667eea;
}
.dash-nav-link .nav-icon {
    width: 32px; height: 32px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: .9rem; flex-shrink: 0;
    background: rgba(255,255,255,.05);
}
.dash-nav-link.active .nav-icon { background: rgba(102,126,234,.3); }
.sidebar-footer { margin-top: auto; padding: 1rem 1.5rem 0; }
.btn-logout {
    display: flex; align-items: center; justify-content: center; gap: .5rem;
    background: rgba(239,68,68,.1); color: #f87171;
    border: 1px solid rgba(239,68,68,.2); border-radius: 10px;
    padding: .6rem 1rem; width: 100%;
    font-size: .875rem; font-weight: 600; text-decoration: none;
    transition: all .2s;
}
.btn-logout:hover { background: rgba(239,68,68,.2); color: #f87171; }

/* Main content */
.dash-main { flex: 1; padding: 2rem; overflow-y: auto; }
.dash-header { margin-bottom: 1.75rem; }
.dash-header h1 { font-size: 1.5rem; font-weight: 800; color: #1e293b; margin: 0 0 .2rem; }
.dash-header p  { color: #64748b; font-size: .9rem; margin: 0; }

/* Stat cards */
.stat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(175px,1fr)); gap: 1rem; margin-bottom: 2rem; }
.stat-card {
    background: white; border-radius: 16px;
    padding: 1.25rem 1.5rem;
    box-shadow: 0 2px 12px rgba(0,0,0,.06);
    display: flex; flex-direction: column; gap: .4rem;
    border-left: 4px solid transparent;
    transition: transform .2s;
}
.stat-card:hover { transform: translateY(-3px); }
.stat-card.blue   { border-left-color: #3b82f6; }
.stat-card.amber  { border-left-color: #f59e0b; }
.stat-card.green  { border-left-color: #10b981; }
.stat-card.purple { border-left-color: #8b5cf6; }
.stat-card.teal   { border-left-color: #06b6d4; }
.stat-icon {
    width: 40px; height: 40px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem; margin-bottom: .25rem;
}
.stat-icon.blue   { background:#dbeafe; color:#3b82f6; }
.stat-icon.amber  { background:#fef3c7; color:#f59e0b; }
.stat-icon.green  { background:#d1fae5; color:#10b981; }
.stat-icon.purple { background:#ede9fe; color:#8b5cf6; }
.stat-icon.teal   { background:#cffafe; color:#06b6d4; }
.stat-value { font-size: 1.75rem; font-weight: 800; color: #1e293b; line-height: 1; }
.stat-label { font-size: .78rem; color: #64748b; font-weight: 500; }

/* Content card */
.content-card {
    background: white; border-radius: 16px;
    box-shadow: 0 2px 12px rgba(0,0,0,.06); overflow: hidden;
}
.content-card-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid #f1f5f9;
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: .75rem;
}
.content-card-header h2 {
    font-size: 1rem; font-weight: 700; color: #1e293b;
    margin: 0; display: flex; align-items: center; gap: .5rem;
}

/* Table */
.dash-table { width: 100%; border-collapse: collapse; }
.dash-table th {
    padding: .75rem 1.25rem; text-align: left;
    font-size: .75rem; font-weight: 700; color: #64748b;
    text-transform: uppercase; letter-spacing: .05em;
    background: #f8fafc; border-bottom: 1px solid #f1f5f9;
}
.dash-table td {
    padding: .875rem 1.25rem;
    border-bottom: 1px solid #f8fafc; font-size: .875rem; color: #374151;
}
.dash-table tr:last-child td { border-bottom: none; }
.dash-table tr:hover td { background: #fafafa; }

/* Badges */
.badge-status {
    display: inline-flex; align-items: center; gap: .35rem;
    padding: .25rem .75rem; border-radius: 20px;
    font-size: .73rem; font-weight: 700; white-space: nowrap;
}
.bs-pending   { background:#fff7ed; color:#c2410c; }
.bs-confirmed { background:#d1fae5; color:#065f46; }
.bs-completed { background:#dbeafe; color:#1e40af; }
.bs-cancelled { background:#fee2e2; color:#991b1b; }
.bs-delayed   { background:#fef9c3; color:#713f12; }
.btn-delay    { background:#fef9c3; color:#713f12; }
.btn-delay:hover { background:#fde68a; color:#713f12; }

/* Action buttons */
.btn-action {
    display: inline-flex; align-items: center; gap: .3rem;
    padding: .3rem .75rem; border-radius: 8px;
    font-size: .78rem; font-weight: 600;
    border: none; cursor: pointer; text-decoration: none;
    transition: all .2s;
}
.btn-approve  { background:#d1fae5; color:#065f46; }
.btn-approve:hover  { background:#a7f3d0; color:#065f46; }
.btn-reject   { background:#fee2e2; color:#991b1b; }
.btn-reject:hover   { background:#fecaca; color:#991b1b; }
.btn-complete { background:#dbeafe; color:#1e40af; }
.btn-complete:hover { background:#bfdbfe; color:#1e40af; }
.btn-rx       { background:#ede9fe; color:#5b21b6; }
.btn-rx:hover       { background:#ddd6fe; color:#5b21b6; }

/* Alert */
.dash-alert-success {
    background:#d1fae5; color:#065f46; border-radius:12px;
    padding:.85rem 1.2rem; margin-bottom:1.25rem;
    display:flex; align-items:center; gap:.6rem;
    font-weight:500; font-size:.875rem;
}
.dash-alert-error {
    background:#fee2e2; color:#991b1b; border-radius:12px;
    padding:.85rem 1.2rem; margin-bottom:1.25rem;
    display:flex; align-items:center; gap:.6rem;
    font-weight:500; font-size:.875rem;
}

/* Empty state */
.empty-state { text-align:center; padding:3rem 1rem; color:#94a3b8; }
.empty-state i { font-size:3rem; display:block; margin-bottom:.75rem; }
</style>

<div class="doctor-dashboard-content">
    <!-- Note: shared sidebar is used from the site layout. Removed internal sidebar to rely on shared navigation. -->
    <div class="dash-main">

        @if (TempData["Success"] != null)
        {
            <div class="dash-alert-success">
                <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="dash-alert-error">
                <i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]
            </div>
        }

        <!-- ══ OVERVIEW ══════════════════════════════════════════════════════ -->
        @if (section == "overview")
        {
            <div class="dash-header">
                <h1>Welcome back, Dr. @ViewBag.DoctorName 👋</h1>
                <p>Here's your dashboard overview for today, @DateTime.Today.ToString("MMMM dd, yyyy")</p>
            </div>

            <div class="stat-grid">
                <div class="stat-card blue">
                    <div class="stat-icon blue"><i class="bi bi-calendar-week"></i></div>
                    <div class="stat-value">@ViewBag.TotalAppointments</div>
                    <div class="stat-label">Total Appointments</div>
                </div>
                <div class="stat-card amber">
                    <div class="stat-icon amber"><i class="bi bi-hourglass-split"></i></div>
                    <div class="stat-value">@ViewBag.PendingCount</div>
                    <div class="stat-label">Pending</div>
                </div>
                <div class="stat-card green">
                    <div class="stat-icon green"><i class="bi bi-check-circle"></i></div>
                    <div class="stat-value">@ViewBag.ConfirmedCount</div>
                    <div class="stat-label">Confirmed</div>
                </div>
                <div class="stat-card purple">
                    <div class="stat-icon purple"><i class="bi bi-patch-check"></i></div>
                    <div class="stat-value">@ViewBag.CompletedCount</div>
                    <div class="stat-label">Completed</div>
                </div>
                <div class="stat-card teal">
                    <div class="stat-icon teal"><i class="bi bi-clock-history"></i></div>
                    <div class="stat-value">@ViewBag.TodaySlots</div>
                    <div class="stat-label">Today's Slots</div>
                </div>
            </div>

            <!-- Recent appointments -->
            <div class="content-card">
                <div class="content-card-header">
                    <h2><i class="bi bi-clock-history text-primary"></i> Recent Appointments</h2>
                    <a href="/Doctor/Dashboard?section=appointments" class="btn-action btn-complete">View All</a>
                </div>
                <table class="dash-table">
                    <thead><tr>
                        <th>Patient</th><th>Date</th><th>Time</th><th>Reason</th><th>Status</th>
                    </tr></thead>
                    <tbody>
                    @foreach (var a in Model.Take(5))
                    {
                        <tr>
                            <td><strong>@a.Patient.User.Username</strong></td>
                            <td>@a.AppointmentDate.ToString("MMM dd, yyyy")</td>
                            <td>@a.AppointmentTime</td>
                            <td>@(a.ReasonForVisit ?? "—")</td>
                            <td>
                                <span class="badge-status @(a.AppointmentStatus == "Pending" ? "bs-pending" :
                                    a.AppointmentStatus == "Confirmed" || a.AppointmentStatus == "Approved" ? "bs-confirmed" :
                                    a.AppointmentStatus == "Completed" ? "bs-completed" :
                                    a.AppointmentStatus == "Delayed" ? "bs-delayed" : "bs-cancelled")">
                                    @(a.AppointmentStatus == "Delayed" ? "⏱ Delayed" : a.AppointmentStatus)
                                </span>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="empty-state">
                            <i class="bi bi-calendar-x"></i>No appointments yet.
                        </td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        <!-- ══ APPOINTMENTS ══════════════════════════════════════════════════ -->
        @if (section == "appointments")
        {
            <div class="dash-header">
                <h1><i class="bi bi-calendar-check me-2"></i>Appointments</h1>
                <p>Manage and track all patient appointments</p>
            </div>

            <div class="content-card">
                <div class="content-card-header">
                    <h2><i class="bi bi-list-ul text-primary"></i> All Appointments</h2>
                </div>
                <table class="dash-table">
                    <thead><tr>
                        <th>Patient</th><th>Date</th><th>Time</th><th>Reason</th><th>Status</th><th>Actions</th>
                    </tr></thead>
                    <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td><strong>@a.Patient.User.Username</strong></td>
                            <td>@a.AppointmentDate.ToString("MMM dd, yyyy")</td>
                            <td>@a.AppointmentTime</td>
                            <td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                @(a.ReasonForVisit ?? "—")
                            </td>
                            <td>
                                <span class="badge-status @(a.AppointmentStatus == "Pending" ? "bs-pending" :
                                    a.AppointmentStatus == "Confirmed" || a.AppointmentStatus == "Approved" ? "bs-confirmed" :
                                    a.AppointmentStatus == "Completed" ? "bs-completed" :
                                    a.AppointmentStatus == "Delayed" ? "bs-delayed" : "bs-cancelled")">
                                    @(a.AppointmentStatus == "Delayed" ? "⏱ Delayed" : a.AppointmentStatus)
                                </span>
                            </td>
                            <td style="white-space:nowrap;">
                                <a href="/EMR/PatientTimeline?patientId=@a.PatientId" class="btn-action" style="background:#e0f2fe;color:#0369a1;" title="View EMR Timeline">
                                    <i class="bi bi-folder-fill"></i> EMR
                                </a>
                                @if (a.AppointmentStatus == "Pending")
                                {
                                    <a href="/Doctor/Approve/@a.Id" class="btn-action btn-approve">
                                        <i class="bi bi-check-lg"></i>Approve
                                    </a>
                                    <a href="/Doctor/Reject/@a.Id" class="btn-action btn-reject ms-1">
                                        <i class="bi bi-x-lg"></i>Reject
                                    </a>
                                }
                                @if (a.AppointmentStatus == "Confirmed" || a.AppointmentStatus == "Approved")
                                {
                                    <a href="/Doctor/Complete/@a.Id" class="btn-action btn-complete">
                                        <i class="bi bi-patch-check"></i>Complete
                                    </a>
                                    <a href="/Doctor/Delay/@a.Id" class="btn-action btn-delay ms-1" title="Mark as Delayed">
                                        <i class="bi bi-clock"></i>Delay
                                    </a>
                                    <a href="/Doctor/AddPrescription?appointmentId=@a.Id" class="btn-action btn-rx ms-1">
                                        <i class="bi bi-file-earmark-medical"></i>Rx
                                    </a>
                                }
                                @if (a.AppointmentStatus == "Delayed")
                                {
                                    <a href="/Doctor/Approve/@a.Id" class="btn-action btn-approve" title="Re-Confirm">
                                        <i class="bi bi-arrow-clockwise"></i>Re-Confirm
                                    </a>
                                    <a href="/Doctor/Complete/@a.Id" class="btn-action btn-complete ms-1">
                                        <i class="bi bi-patch-check"></i>Complete
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6">
                            <div class="empty-state"><i class="bi bi-calendar-x"></i>No appointments found.</div>
                        </td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        <!-- ══ PROFILE ═══════════════════════════════════════════════════════ -->
        @if (section == "profile")
        {
            <div class="dash-header">
                <h1><i class="bi bi-person-badge me-2"></i>My Profile</h1>
                <p>Your professional information</p>
            </div>
            <div class="content-card" style="max-width:600px;">
                <div class="content-card-header">
                    <h2><i class="bi bi-person-circle text-primary"></i> Profile Details</h2>
                    <a href="/Doctor/EditProfile" class="btn-action" style="background:#fef3c7;color:#92400e;">
                        <i class="bi bi-pencil"></i>Edit
                    </a>
                </div>
                <div style="padding:1.5rem;">
                    @{
                        var rows = new [] {
                            ("Name",             ViewBag.DoctorName?.ToString()    ?? "—"),
                            ("Email",            ViewBag.Email?.ToString()         ?? "—"),
                            ("Specialization",   ViewBag.Specialization?.ToString()?? "—"),
                            ("Qualification",    ViewBag.Qualification?.ToString() ?? "—"),
                            ("Experience",       ViewBag.Experience + " years"),
                            ("Consultation Fee", "৳ " + ViewBag.Fee),
                            ("Available Days",   ViewBag.AvailableDays?.ToString() ?? "—"),
                        };
                    }
                    @foreach (var (label, value) in rows)
                    {
                        <div style="display:flex;justify-content:space-between;padding:.65rem 0;border-bottom:1px solid #f1f5f9;font-size:.875rem;">
                            <span style="color:#64748b;font-weight:500;">@label</span>
                            <span style="color:#1e293b;font-weight:600;">@value</span>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ══ LIVE QUEUE MANAGEMENT ════════════════════════════════════════ -->
        @if (section == "queue")
        {
            var queueEntries = ViewBag.QueueEntries as List<QueueEntry> ?? new List<QueueEntry>();
            var activeEntry = queueEntries.FirstOrDefault(q => q.Status == "Calling" || q.Status == "InConsultation");
            var waitingEntries = queueEntries.Where(q => q.Status == "Waiting").ToList();
            var completedOrSkipped = queueEntries.Where(q => q.Status == "Completed" || q.Status == "Skipped").ToList();

            <div class="dash-header d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h1>Live Queue Management</h1>
                    <p>Track tokens and manage consult flow for today: @DateTime.Today.ToString("dd MMMM yyyy")</p>
                </div>
                <div>
                    @if (ViewBag.DoctorStatus == "Serving Patients")
                    {
                        <span class="badge bg-success p-2.5 rounded-pill fs-6"><i class="bi bi-activity me-1 animate-pulse"></i> Serving Patients</span>
                    }
                    else if (ViewBag.DoctorStatus == "On Break")
                    {
                        <span class="badge bg-warning text-dark p-2.5 rounded-pill fs-6"><i class="bi bi-cup-hot me-1"></i> Lunch Break</span>
                    }
                    else if (ViewBag.DoctorStatus == "On Vacation")
                    {
                        <span class="badge bg-danger p-2.5 rounded-pill fs-6"><i class="bi bi-airplane me-1"></i> Vacation</span>
                    }
                    else if (ViewBag.DoctorStatus == "Available")
                    {
                        <span class="badge bg-success p-2.5 rounded-pill fs-6"><i class="bi bi-check-circle me-1"></i> Available</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary p-2.5 rounded-pill fs-6"><i class="bi bi-moon me-1"></i> Offline</span>
                    }
                </div>
            </div>

            @if (ViewBag.DoctorStatus == "On Vacation")
            {
                <div class="card border-0 shadow-sm rounded-4 text-center p-5 mt-4">
                    <div class="bg-light rounded-circle p-4 d-inline-flex align-items-center justify-content-center mb-4 mx-auto" style="width: 80px; height: 80px;">
                        <i class="bi bi-calendar-x fs-1 text-danger"></i>
                    </div>
                    <h4 class="fw-bold mb-2">Chamber Closed — Vacation</h4>
                    <p class="text-muted mb-0">Your schedule for today is marked as a vacation. The queue is inactive.</p>
                </div>
            }
            else
            {
                <!-- Queue Stats Row -->
                <div class="row g-3 mb-4 mt-2">
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm rounded-3 p-3 bg-light text-center">
                            <div class="text-muted small fw-semibold">Total Scheduled</div>
                            <h3 class="fw-bold mb-0 text-primary">@queueEntries.Count</h3>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm rounded-3 p-3 bg-light text-center">
                            <div class="text-muted small fw-semibold">Currently Waiting</div>
                            <h3 class="fw-bold mb-0 text-warning">@waitingEntries.Count</h3>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm rounded-3 p-3 bg-light text-center">
                            <div class="text-muted small fw-semibold">Completed</div>
                            <h3 class="fw-bold mb-0 text-success">@queueEntries.Count(q => q.Status == "Completed")</h3>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm rounded-3 p-3 bg-light text-center">
                            <div class="text-muted small fw-semibold">Skipped</div>
                            <h3 class="fw-bold mb-0 text-secondary">@queueEntries.Count(q => q.Status == "Skipped")</h3>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <!-- Left Column: Active Patient Panel -->
                    <div class="col-lg-5">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-header bg-dark text-white p-3">
                                <h5 class="mb-0 fw-bold"><i class="bi bi-person-workspace me-2 text-warning"></i>Active Consultation</h5>
                            </div>
                            <div class="card-body p-4 d-flex flex-column align-items-center justify-content-center text-center">
                                @if (activeEntry != null)
                                {
                                    <div class="w-100">
                                        <div class="text-secondary small fw-semibold mb-2">Token Number</div>
                                        <h1 class="display-3 fw-extrabold text-primary mb-3">#@activeEntry.TokenNumber</h1>
                                        
                                        @if (activeEntry.Appointment.IsEmergency)
                                        {
                                            <div class="mb-3">
                                                <span class="badge bg-danger text-white px-3 py-1.5 rounded-pill fw-bold"><i class="bi bi-exclamation-triangle-fill me-1"></i> EMERGENCY</span>
                                            </div>
                                        }

                                        <h4 class="fw-bold text-dark mb-1">@activeEntry.Appointment.Patient.User.Username</h4>
                                        <p class="text-muted mb-3">@activeEntry.Appointment.Patient.Gender, @activeEntry.Appointment.Patient.Age years</p>
                                        
                                        <div class="p-3 bg-light rounded-3 text-start mb-4">
                                            <span class="text-muted small d-block mb-1">Scheduled Time: <strong>@activeEntry.Appointment.AppointmentTime</strong></span>
                                            <span class="text-muted small d-block">Reason: <strong>@(activeEntry.Appointment.ReasonForVisit ?? "Not specified")</strong></span>
                                        </div>

                                        @if (activeEntry.Status == "Calling")
                                        {
                                            <div class="d-grid gap-2">
                                                <form method="post" action="/Queue/StartConsultation">
                                                    <input type="hidden" name="Id" value="@activeEntry.Id" />
                                                    <button type="submit" class="btn btn-success btn-lg w-100 rounded-pill"><i class="bi bi-play-fill me-1"></i> Start Consultation</button>
                                                </form>
                                                <form method="post" action="/Queue/SkipPatient">
                                                    <input type="hidden" name="Id" value="@activeEntry.Id" />
                                                    <button type="submit" class="btn btn-outline-danger w-100 rounded-pill"><i class="bi bi-x-circle me-1"></i> Skip / No Show</button>
                                                </form>
                                            </div>
                                        }
                                        else if (activeEntry.Status == "InConsultation")
                                        {
                                            <div class="d-grid gap-2">
                                                <form method="post" action="/Queue/CompleteConsultation">
                                                    <input type="hidden" name="Id" value="@activeEntry.Id" />
                                                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill"><i class="bi bi-check2-circle-fill me-1"></i> Complete & Write Rx</button>
                                                </form>
                                                <form method="post" action="/Queue/SkipPatient">
                                                    <input type="hidden" name="Id" value="@activeEntry.Id" />
                                                    <button type="submit" class="btn btn-outline-danger w-100 rounded-pill"><i class="bi bi-slash-circle me-1"></i> Skip / Terminate</button>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="py-4">
                                        <div class="bg-light rounded-circle p-4 d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px;">
                                            <i class="bi bi-person-fill-slash fs-1 text-muted"></i>
                                        </div>
                                        <h5 class="fw-bold mb-1">No Active Consultation</h5>
                                        <p class="text-muted small px-3">Call the next patient in line when you are ready to begin.</p>
                                        
                                        @if (waitingEntries.Any())
                                        {
                                            <form method="post" action="/Queue/CallNext">
                                                <input type="hidden" name="DoctorId" value="@ViewBag.DoctorId" />
                                                <button type="submit" class="btn btn-success btn-lg rounded-pill px-5 shadow-sm mt-3"><i class="bi bi-megaphone-fill me-2"></i> Call Next Patient</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button disabled class="btn btn-secondary btn-lg rounded-pill px-5 mt-3">Queue Empty</button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Queue list -->
                    <div class="col-lg-7">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-header bg-dark text-white p-3">
                                <h5 class="mb-0 fw-bold"><i class="bi bi-list-ol me-2 text-warning"></i>Waiting List</h5>
                            </div>
                            <div class="card-body p-0">
                                @if (waitingEntries.Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead>
                                                <tr class="table-light">
                                                    <th class="ps-3">Seq</th>
                                                    <th>Token</th>
                                                    <th>Patient</th>
                                                    <th>Scheduled Time</th>
                                                    <th>Priority</th>
                                                    <th class="pe-3 text-end">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in waitingEntries)
                                                {
                                                    <tr>
                                                        <td class="ps-3 fw-semibold">@item.SequenceNumber</td>
                                                        <td><span class="badge bg-primary rounded-pill">#@item.TokenNumber</span></td>
                                                        <td>
                                                            <div class="fw-bold">@item.Appointment.Patient.User.Username</div>
                                                            <div class="text-muted small">@item.Appointment.Patient.Gender, @item.Appointment.Patient.Age yrs</div>
                                                        </td>
                                                        <td>@item.Appointment.AppointmentTime</td>
                                                        <td>
                                                            @if (item.Appointment.IsEmergency)
                                                            {
                                                                <span class="badge bg-danger"><i class="bi bi-exclamation-triangle-fill me-1 animate-pulse"></i> EMERGENCY</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-secondary">Normal</span>
                                                            }
                                                        </td>
                                                        <td class="pe-3 text-end">
                                                            <div class="d-flex justify-content-end gap-1">
                                                                @if (!item.Appointment.IsEmergency)
                                                                {
                                                                    <form method="post" action="/Queue/BumpEmergency" style="display:inline;">
                                                                        <input type="hidden" name="Id" value="@item.Id" />
                                                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2.5" title="Mark as Emergency"><i class="bi bi-exclamation-octagon"></i> Bump</button>
                                                                    </form>
                                                                }
                                                                <form method="post" action="/Queue/SkipPatient" style="display:inline;">
                                                                    <input type="hidden" name="Id" value="@item.Id" />
                                                                    <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-2.5" title="Skip Patient"><i class="bi bi-slash-circle"></i> Skip</button>
                                                                </form>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="p-5 text-center text-muted">
                                        <i class="bi bi-check2-all fs-1 text-success mb-3 d-block"></i>
                                        <p class="mb-0 fw-semibold">No patients are waiting in the queue.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Queue History/Completed & Skipped -->
                    <div class="col-12 mt-3">
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-header bg-secondary text-white p-3">
                                <h6 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2"></i>Consultation History (Today)</h6>
                            </div>
                            <div class="card-body p-0">
                                @if (completedOrSkipped.Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead>
                                                <tr class="table-light">
                                                    <th class="ps-3">Token</th>
                                                    <th>Patient Name</th>
                                                    <th>Scheduled Time</th>
                                                    <th>Priority</th>
                                                    <th>Status</th>
                                                    <th class="pe-3">Processed Time</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in completedOrSkipped)
                                                {
                                                    <tr>
                                                        <td class="ps-3 fw-bold">#@item.TokenNumber</td>
                                                        <td>@item.Appointment.Patient.User.Username</td>
                                                        <td>@item.Appointment.AppointmentTime</td>
                                                        <td>
                                                            @if (item.Appointment.IsEmergency)
                                                            {
                                                                <span class="badge bg-danger">EMERGENCY</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-secondary">Normal</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (item.Status == "Completed")
                                                            {
                                                                <span class="badge bg-success">Completed</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-secondary">Skipped</span>
                                                            }
                                                        </td>
                                                        <td class="pe-3 text-muted small">
                                                            @(item.CompletionTime?.ToString("hh:mm tt") ?? "—")
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="p-4 text-center text-muted small">
                                        No patients processed yet today.
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }

        <!-- ══ NOTIFICATIONS ════════════════════════════════════════════════ -->
        @if (section == "notifications")
        {
            var notifications = ViewBag.Notifications as List<Notification> ?? new List<Notification>();

            <div class="dash-header d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h1>Notifications</h1>
                    <p>Track important alerts and system messages</p>
                </div>
                @if (notifications.Any(n => n.NotificationStatus == "Unread"))
                {
                    <form method="post" action="/Doctor/MarkAllNotificationsRead" style="margin: 0;">
                        <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                            Mark All as Read
                        </button>
                    </form>
                }
            </div>

            <div class="content-card mt-3">
                <div style="padding: 1.5rem;">
                    @if (notifications.Any())
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var n in notifications)
                            {
                                var isUnread = n.NotificationStatus == "Unread";
                                var (icon, bgStyle) = n.NotificationType switch {
                                    "Booking"      => ("📅", "background:#dbeafe; color:#3b82f6;"),
                                    "Confirmation" => ("✅", "background:#d1fae5; color:#10b981;"),
                                    "Cancellation" => ("❌", "background:#fee2e2; color:#ef4444;"),
                                    "Delay"        => ("⏱", "background:#fef3c7; color:#f59e0b;"),
                                    "Prescription" => ("💊", "background:#cffafe; color:#06b6d4;"),
                                    "Reminder"     => ("🔔", "background:#f1f5f9; color:#64748b;"),
                                    _              => ("💬", "background:#f1f5f9; color:#64748b;")
                                };

                                <div class="p-3 rounded-3 border d-flex align-items-start gap-3 transition-all hover-shadow @(isUnread ? "border-primary" : "bg-light")" 
                                     style="position: relative; border: 1px solid #e2e8f0; border-radius: 12px; @(isUnread ? "background: #f0f7ff;" : "")">
                                    <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" 
                                         style="width: 40px; height: 40px; font-size: 1.25rem; flex-shrink: 0; @bgStyle">
                                        @icon
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                            <h6 class="fw-bold mb-1 @(isUnread ? "text-primary" : "text-dark")" style="font-size: 0.95rem;">@n.Title</h6>
                                            <span class="text-muted small">@n.SentDateTime.ToString("dd MMM yyyy, hh:mm tt")</span>
                                        </div>
                                        <p class="mb-0 text-secondary" style="font-size: 0.88rem; line-height: 1.5;">@n.Message</p>
                                    </div>
                                    @if (isUnread)
                                    {
                                        <form method="post" action="/Doctor/MarkNotificationRead" class="ms-2" style="margin: 0;">
                                            <input type="hidden" name="id" value="@n.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill py-1 px-3" style="font-size: 0.78rem; white-space: nowrap; font-weight: 600;">
                                                Mark Read
                                            </button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-bell-slash"></i>No notifications found.
                        </div>
                    }
                </div>
            </div>
        }

    </div>
</div>
