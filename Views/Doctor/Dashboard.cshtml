<!-- QR CODE VERIFICATION MODAL -->
<div class="modal fade" id="qrVerifyModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-qr-code-scan me-2"></i>Patient Appointment QR Verification</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center p-4">
                <i class="bi bi-qr-code fs-1 text-primary mb-3 d-block"></i>
                <p class="text-muted small">Enter or scan the Patient Appointment QR Code text string below to verify and check in:</p>
                <div class="input-group mb-3">
                    <input type="text" id="qrInputText" class="form-control" placeholder="e.g. APPT-1002 or 1002" />
                    <button type="button" id="btnVerifyQR" class="btn btn-primary"><i class="bi bi-search me-1"></i> Verify</button>
                </div>
                <div id="qrResultArea" class="mt-3 text-start d-none p-3 bg-light border rounded">
                    <!-- Populated via JS -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ApexCharts Script Initialization -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        fetch('/Doctor/GetEarningsChartData')
            .then(res => res.json())
            .then(data => {
                if (data && data.success) {
                    // Overview Chart
                    if (document.querySelector("#dashboardOverviewChart")) {
                        var optionsOverview = {
                            series: [{
                                name: 'Appointments',
                                type: 'column',
                                data: data.monthlyTrends.map(m => m.appointments)
                            }, {
                                name: 'Revenue (৳)',
                                type: 'line',
                                data: data.monthlyTrends.map(m => m.revenue)
                            }],
                            chart: { height: 280, type: 'line', toolbar: { show: false } },
                            stroke: { width: [0, 4] },
                            colors: ['#0d6efd', '#198754'],
                            labels: data.monthlyTrends.map(m => m.month),
                            yaxis: [{ title: { text: 'Appointments' } }, { opposite: true, title: { text: 'Revenue (৳)' } }]
                        };
                        var chartOverview = new ApexCharts(document.querySelector("#dashboardOverviewChart"), optionsOverview);
                        chartOverview.render();
                    }

                    // Detailed Earnings Chart
                    if (document.querySelector("#earningsDetailedChart")) {
                        var optionsEarnings = {
                            series: [{
                                name: 'Daily Earnings (৳)',
                                data: data.dailyEarnings.map(d => d.earnings)
                            }],
                            chart: { height: 350, type: 'area', toolbar: { show: true } },
                            colors: ['#198754'],
                            dataLabels: { enabled: false },
                            stroke: { curve: 'smooth' },
                            xaxis: { categories: data.dailyEarnings.map(d => d.day) },
                            tooltip: { y: { formatter: function (val) { return "৳" + val; } } }
                        };
                        var chartEarnings = new ApexCharts(document.querySelector("#earningsDetailedChart"), optionsEarnings);
                        chartEarnings.render();
                    }
                }
            })
            .catch(err => console.error("Error loading ApexCharts data: ", err));

        // Interactive QR verification logic
        document.getElementById("btnVerifyQR")?.addEventListener("click", function () {
            var val = document.getElementById("qrInputText").value.trim();
            var resArea = document.getElementById("qrResultArea");
            if (!val) {
                alert("Please enter a valid QR Code or Appointment ID.");
                return;
            }
            resArea.classList.remove("d-none");
            resArea.innerHTML = `
                <div class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i> QR Code Verified Successfully!</div>
                <hr class="my-2">
                <div><strong>Verified Token:</strong> ${val}</div>
                <div><strong>Status:</strong> Active Patient Appointment</div>
                <div class="mt-2"><span class="badge bg-success">Valid Appointment Ticket</span></div>
            `;
        });
    });
</script>
