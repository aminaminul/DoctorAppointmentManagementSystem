@model DoctorAppointmentManagementSystem.Models.MedicalCertificate
@{
    Layout = null;
    ViewData["Title"] = Model.CertificateType + " - " + Model.CertificateNumber;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.CertificateType - @Model.CertificateNumber</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
</head>
<body class="bg-light p-4">
    <div class="container bg-white p-5 shadow border border-3 border-primary rounded-4 my-3 position-relative" style="max-width: 850px;">
        <!-- Watermark/Header -->
        <div class="text-center border-bottom pb-4 mb-4">
            <h1 class="text-primary fw-bold text-uppercase tracking-wide"><i class="bi bi-award me-2"></i>@Model.CertificateType</h1>
            <p class="text-secondary mb-0 fw-semibold">Doctor Appointment Medical Center & Healthcare System</p>
            <small class="text-muted">Certificate Ref: <strong class="text-dark">@Model.CertificateNumber</strong> | Issue Date: @Model.IssueDate.ToString("MMMM dd, yyyy")</small>
        </div>

        <!-- Body -->
        <div class="px-4 py-3 text-justify fs-5 lh-lg">
            <p>This is to certify that <strong>@Model.Patient?.User?.Username</strong> (Gender: @Model.Patient?.Gender, Age: @Model.Patient?.Age years) was under my professional medical care and examination.</p>
            
            <p><strong>Clinical Diagnosis / Cause:</strong> @Model.Diagnosis</p>

            <p>Based on medical evaluation, the patient has been advised medical leave / fitness period from <strong>@Model.StartDate.ToString("MMMM dd, yyyy")</strong> to <strong>@Model.EndDate.ToString("MMMM dd, yyyy")</strong>.</p>

            @if (!string.IsNullOrWhiteSpace(Model.Remarks))
            {
                <p><strong>Remarks / Recommendations:</strong> @Model.Remarks</p>
            }

            <p class="mt-4">The patient is fit to resume normal duties / normal activities effective <strong>@Model.EndDate.AddDays(1).ToString("MMMM dd, yyyy")</strong>.</p>
        </div>

        <!-- Footer -->
        <div class="row pt-5 mt-4 border-top align-items-end">
            <div class="col-6">
                <img src="https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=@Model.CertificateNumber-DOC-@Model.DoctorId" alt="QR Verification" class="img-thumbnail" />
                <div class="small text-muted mt-1">Official Verification Code</div>
            </div>
            <div class="col-6 text-end">
                <div class="border-top pt-2 d-inline-block px-4">
                    <h5 class="fw-bold mb-0 text-dark">@Model.Doctor?.User?.Username</h5>
                    <p class="mb-0 text-primary small">@Model.Doctor?.Specialization</p>
                    <small class="text-muted">Reg No / Qualification: @Model.Doctor?.Qualification</small>
                </div>
            </div>
        </div>

        <!-- Print Actions -->
        <div class="mt-5 text-center d-print-none">
            <button onclick="window.print()" class="btn btn-primary btn-lg me-2"><i class="bi bi-printer me-2"></i>Print Certificate</button>
            <button onclick="window.close()" class="btn btn-outline-secondary btn-lg"><i class="bi bi-x-circle me-2"></i>Close</button>
        </div>
    </div>
</body>
</html>
