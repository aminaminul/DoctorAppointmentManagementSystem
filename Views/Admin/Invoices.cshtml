@model IEnumerable<DoctorAppointmentManagementSystem.Models.Invoice>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Invoices & Billing";
}

<div class="container-fluid p-0">
    <!-- Header Banner -->
    <div class="card text-white shadow-sm mb-4 border-0 rounded-3 bg-dark border-start border-4 border-info">
        <div class="card-body p-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <h3 class="fw-bold mb-1 text-white"><i class="bi bi-receipt me-2 text-info"></i>Invoices &amp; Billing Management</h3>
                <p class="mb-0 text-white-50">Generate clinical fee invoices, manage payment settlements, and print patient receipts.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="CreateInvoice" class="btn btn-info text-white btn-sm fw-bold px-3">
                    <i class="bi bi-plus-circle me-1"></i>Create Invoice
                </a>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Invoices Table Card -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">
                Issued Invoices
                <span class="badge bg-info-subtle text-info rounded-pill ms-2">@Model.Count() Total</span>
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small">
                        <tr>
                            <th class="ps-4">Invoice #</th>
                            <th>Date Issued</th>
                            <th>Patient</th>
                            <th>Particulars / Description</th>
                            <th>Total Amount</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">#@item.Id</td>
                                    <td>
                                        <div class="fw-semibold text-dark small">@item.IssueDate.ToString("dd MMM yyyy")</div>
                                        <div class="text-muted small">@item.IssueDate.ToString("hh:mm tt")</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark small">
                                            @item.Patient?.User?.Username
                                        </div>
                                        <div class="text-muted small">@(item.Patient?.User?.PhoneNumber ?? "No Phone")</div>
                                    </td>
                                    <td>
                                        <div class="small text-dark">@item.Particulars</div>
                                        @if (item.AppointmentId.HasValue)
                                        {
                                            <span class="badge bg-light text-secondary border" style="font-size: 0.7rem;">Linked Appt #@item.AppointmentId</span>
                                        }
                                    </td>
                                    <td class="fw-bold text-success fs-6">
                                        ৳@item.TotalAmount.ToString("N2")
                                    </td>
                                    <td>
                                        @if (item.Status == "Paid" || item.Status == "Completed")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success"><i class="bi bi-check-circle me-1"></i>Paid</span>
                                        }
                                        else if (item.Status.Contains("Refund", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning"><i class="bi bi-arrow-counterclockwise me-1"></i>Refunded</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger">@item.Status</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            @if (item.AppointmentId.HasValue)
                                            {
                                                <a asp-controller="Doctor" asp-action="PrintInvoice" asp-route-id="@item.AppointmentId.Value" target="_blank" class="btn btn-outline-info" title="Print Official Bill">
                                                    <i class="bi bi-receipt me-1"></i>Print
                                                </a>
                                            }
                                            <a asp-action="EditInvoice" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Edit Invoice">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="DeleteInvoice" asp-route-id="@item.Id" class="btn btn-outline-danger" onclick="return confirm('Delete invoice #@item.Id?')" title="Delete Invoice">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-receipt-cutoff fs-2 d-block mb-2 text-secondary"></i>
                                    <span>No invoices generated yet.</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
