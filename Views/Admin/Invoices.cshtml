@model IEnumerable<DoctorAppointmentManagementSystem.Models.Invoice>

@{
    ViewData["Title"] = "Invoices";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Invoices</h2>
    <a asp-action="CreateInvoice" class="btn btn-primary">Create Invoice</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Date</th>
            <th>Patient</th>
            <th>Amount</th>
            <th>Particulars</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IssueDate.ToShortDateString()</td>
                <td>@item.Patient?.User?.Username</td>
                <td>à§³@item.TotalAmount.ToString("N2")</td>
                <td>@item.Particulars</td>
                <td>
                    <span class="badge @(item.Status == "Paid" ? "bg-success" : (item.Status == "Unpaid" ? "bg-danger" : "bg-secondary"))">
                        @item.Status
                    </span>
                </td>
                <td>
                    <a asp-action="EditInvoice" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="DeleteInvoice" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Delete invoice?')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
