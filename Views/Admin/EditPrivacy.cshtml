@* Razor View: Admin/EditPrivacy *@
<!-- HTML View: Admin/EditPrivacy -->
@model DoctorAppointmentManagementSystem.Models.PrivacyPolicy

@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Privacy Policy";
    ViewData["NavbarTheme"] = "white";
}

<div class="container py-4">
    <div class="card shadow-sm rounded-3">
        <div class="card-header" style="background-color:#4DA8DA;color:#fff;">
            <h5 class="mb-0">Edit Privacy Policy</h5>
        </div>
        <div class="card-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
<!-- Form Block -->
        <form method="post" asp-action="EditPrivacy">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Content (HTML)</label>
                    <textarea name="Content" class="form-control" rows="12">@Model.Content</textarea>
                </div>
                <button type="submit" class="btn btn-primary">Save Policy</button>
                <a asp-controller="Home" asp-action="Privacy" class="btn btn-outline-secondary ms-2">View</a>
            </form>
        </div>
    </div>
</div>

