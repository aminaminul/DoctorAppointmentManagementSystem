@using DoctorAppointmentManagementSystem.ViewModels
@model DoctorCreateViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Add New Doctor";
}

<div class="container-fluid p-0">
    <div class="card text-white shadow-sm mb-4 border-0 rounded-3 bg-dark border-start border-4 border-primary">
        <div class="card-body p-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <h3 class="fw-bold mb-1 text-white"><i class="bi bi-person-plus-fill me-2 text-primary"></i>Add New Doctor</h3>
                <p class="mb-0 text-white-50">Create a new specialist physician account with credentials, fee schedule, and chamber hours.</p>
            </div>
            <a asp-action="Doctors" class="btn btn-outline-light btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to Doctors</a>
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white border-0 py-3 px-4">
            <h5 class="fw-bold mb-0 text-dark">Physician Profile &amp; Practice Setup</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="AddDoctor" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-bold">Doctor Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Dr. Mahfuzur Rahman" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-bold">Email Address <span class="text-danger">*</span></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="doctor@clinic.com" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-bold">Account Password <span class="text-danger">*</span></label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Create temporary password" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label fw-bold">Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="e.g. 01712345678" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Specialization" class="form-label fw-bold">Specialization / Department <span class="text-danger">*</span></label>
                        <input asp-for="Specialization" class="form-control" placeholder="e.g. Cardiology, Neurology, Medicine" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Qualification" class="form-label fw-bold">Medical Qualification</label>
                        <input asp-for="Qualification" class="form-control" placeholder="e.g. MBBS, FCPS (Cardiology), MD" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Experience" class="form-label fw-bold">Experience (Years)</label>
                        <input asp-for="Experience" type="number" min="0" class="form-control" value="5" required />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ConsultationFee" class="form-label fw-bold">Consultation Fee (BDT ৳) <span class="text-danger">*</span></label>
                        <input asp-for="ConsultationFee" type="number" step="0.01" min="0" class="form-control" value="800" required />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="AvailableDays" class="form-label fw-bold">Available Days</label>
                        <input asp-for="AvailableDays" class="form-control" placeholder="e.g. Sat-Thu, Mon-Fri" value="Sat-Thu" />
                    </div>

                    <div class="col-12">
                        <label asp-for="Availability" class="form-label fw-bold">Daily Chamber Hours <span class="text-danger">*</span></label>
                        <input asp-for="Availability" class="form-control" placeholder="e.g. 05:00 PM - 09:00 PM" value="05:00 PM - 09:00 PM" required />
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Doctors" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-success fw-bold px-4"><i class="bi bi-check2-circle me-1"></i>Create Doctor Account</button>
                </div>
            </form>
        </div>
    </div>
</div>
