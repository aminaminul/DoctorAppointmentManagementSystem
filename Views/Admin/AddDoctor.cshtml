@using DoctorAppointmentManagementSystem.ViewModels
@model DoctorCreateViewModel
 

<h2>Add Doctor</h2>

<form method="post">

    <input type="text" name="Name" placeholder="Name" class="form-control" /><br />

    <input type="email" name="Email" placeholder="Email" class="form-control" /><br />

    <input type="password" name="Password" placeholder="Password" class="form-control" /><br />

    <input type="text" name="Specialization" placeholder="Specialization" class="form-control" /><br />

    <input type="text" name="Availability" placeholder="Availability" class="form-control" /><br />

    <button type="submit" class="btn btn-success">Add Doctor</button>

</form>