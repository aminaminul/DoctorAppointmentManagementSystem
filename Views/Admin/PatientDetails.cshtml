@model DoctorAppointmentManagementSystem.Models.Patient
@{
    Layout = "_Layout";
    ViewData["Title"] = "Patient Details";

    var appointments = ViewBag.Appointments as List<DoctorAppointmentManagementSystem.Models.Appointment> ?? new List<DoctorAppointmentManagementSystem.Models.Appointment>();
    var invoices = ViewBag.Invoices as List<DoctorAppointmentManagementSystem.Models.Invoice> ?? new List<DoctorAppointmentManagementSystem.Models.Invoice>();
}

<div class="container-fluid p-0">
    <!-- Header Banner -->
    <div class="card text-white shadow-sm mb-4 border-0 rounded-3 bg-dark border-start border-4 border-primary">
        <div class="card-body p-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-secondary text-white fw-bold d-flex align-items-center justify-content-center border border-3 border-light shadow-sm" style="width: 60px; height: 60px; min-width: 60px; font-size: 1.5rem;">
                    @(Model.User?.Username?.Substring(0, 1).ToUpper() ?? "P")
                </div>
                <div>
                    <h3 class="fw-bold mb-1 text-white">@Model.User?.Username</h3>
                    <p class="mb-0 text-white-50"><span class="badge bg-primary me-2">Patient</span> @Model.Gender, @Model.Age Years | Blood Group: <span class="badge bg-danger">@(string.IsNullOrEmpty(Model.BloodGroup) ? "N/A" : Model.BloodGroup)</span></p>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="EditPatient" asp-route-id="@Model.Id" class="btn btn-warning btn-sm"><i class="bi bi-pencil me-1"></i>Edit Profile</a>
                <a asp-action="Patients" class="btn btn-outline-light btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to Patients</a>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Demographics Card -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-white border-0 py-3 px-4">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-person-lines-fill me-2 text-primary"></i>Personal &amp; Contact Details</h5>
                </div>
                <div class="card-body p-4 pt-0">
                    <table class="table table-hover mb-0">
                        <tbody>
                            <tr>
                                <th class="text-muted fw-normal" style="width: 40%">Full Name</th>
                                <td class="fw-bold text-dark">@Model.User?.Username</td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Email Address</th>
                                <td>@Model.User?.Email</td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Phone Number</th>
                                <td class="font-monospace">@(Model.User?.PhoneNumber ?? "Not specified")</td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Date of Birth</th>
                                <td>@(Model.DateOfBirth != default ? Model.DateOfBirth.ToString("dd MMM yyyy") : "N/A")</td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Emergency Contact</th>
                                <td>@(Model.EmergencyContact ?? "None")</td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Address</th>
                                <td>@(Model.Address ?? "Not specified")</td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Account Status</th>
                                <td>
                                    @if (Model.ActiveStatus)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success"><i class="bi bi-check-circle me-1"></i>Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger"><i class="bi bi-pause-circle me-1"></i>Inactive</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Clinical Notes / Summary -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-white border-0 py-3 px-4">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-file-medical me-2 text-primary"></i>Medical History &amp; Allergies</h5>
                </div>
                <div class="card-body p-4 pt-0">
                    <div class="mb-3">
                        <label class="fw-bold small text-muted text-uppercase mb-1">Medical History / Chronic Conditions</label>
                        <div class="p-3 bg-light rounded-3 text-dark small">
                            @(string.IsNullOrEmpty(Model.MedicalHistory) ? "No medical history recorded." : Model.MedicalHistory)
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold small text-muted text-uppercase mb-1">Known Allergies</label>
                        <div class="p-3 bg-light rounded-3 text-danger small fw-semibold">
                            @(string.IsNullOrEmpty(Model.Allergies) ? "No known drug/food allergies recorded." : Model.Allergies)
                        </div>
                    </div>
                    <div class="p-3 bg-info-subtle text-dark rounded-3 small">
                        <i class="bi bi-info-circle me-1"></i> Total Recorded Appointments: <strong>@appointments.Count</strong> | Invoices: <strong>@invoices.Count</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Appointments & Billing Tables -->
    <div class="row g-4 mb-4">
        <div class="col-md-7">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden h-100">
                <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar-check me-2 text-primary"></i>Appointment History</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-secondary small">
                                <tr>
                                    <th class="ps-4">Appt #</th>
                                    <th>Date &amp; Time</th>
                                    <th>Doctor</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (appointments.Any())
                                {
                                    foreach (var a in appointments)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold">#@a.Id</td>
                                            <td class="small">@a.AppointmentDate.ToString("dd MMM yyyy") at @a.AppointmentTime</td>
                                            <td>Dr. @a.Doctor?.User?.Username</td>
                                            <td>
                                                <span class="badge @(a.AppointmentStatus == "Completed" ? "bg-success" : (a.AppointmentStatus == "Cancelled" ? "bg-danger" : "bg-primary"))">
                                                    @a.AppointmentStatus
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted small">No appointment records found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden h-100">
                <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-receipt me-2 text-primary"></i>Billing Invoices</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-secondary small">
                                <tr>
                                    <th class="ps-4">Date</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th class="text-end pe-4">Bill</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (invoices.Any())
                                {
                                    foreach (var inv in invoices)
                                    {
                                        <tr>
                                            <td class="ps-4 small">@inv.IssueDate.ToString("dd MMM yyyy")</td>
                                            <td class="fw-bold text-dark">৳@inv.TotalAmount.ToString("N2")</td>
                                            <td>
                                                <span class="badge @(inv.Status == "Paid" ? "bg-success" : "bg-danger")">@inv.Status</span>
                                            </td>
                                            <td class="text-end pe-4">
                                                @if (inv.AppointmentId.HasValue)
                                                {
                                                    <a asp-controller="Doctor" asp-action="PrintInvoice" asp-route-id="@inv.AppointmentId.Value" target="_blank" class="btn btn-outline-info btn-sm">
                                                        <i class="bi bi-receipt"></i>
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted small">No invoices recorded.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
