@model DoctorAppointmentManagementSystem.Models.Patient

@{
    ViewData["Title"] = "Patient Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Patient Details - @Model.User?.Username</h2>
    <a asp-action="Patients" class="btn btn-secondary">Back to List</a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Personal & Account Details</h5>
            </div>
            <div class="card-body">
                <table class="table table-hover">
                    <tr>
                        <th style="width: 40%">Username / Name</th>
                        <td>@Model.User?.Username</td>
                    </tr>
                    <tr>
                        <th>Email Address</th>
                        <td>@Model.User?.Email</td>
                    </tr>
                    <tr>
                        <th>Phone Number</th>
                        <td>@(Model.User?.PhoneNumber ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th>Date of Birth</th>
                        <td>@(Model.DateOfBirth != default ? Model.DateOfBirth.ToString("dd MMM yyyy") : "N/A")</td>
                    </tr>
                    <tr>
                        <th>Age</th>
                        <td>@Model.Age Years</td>
                    </tr>
                    <tr>
                        <th>Gender</th>
                        <td>@Model.Gender</td>
                    </tr>
                    <tr>
                        <th>Blood Group</th>
                        <td>@(string.IsNullOrEmpty(Model.BloodGroup) ? "N/A" : Model.BloodGroup)</td>
                    </tr>
                    <tr>
                        <th>Emergency Contact</th>
                        <td>@(Model.EmergencyContact ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th>Home Address</th>
                        <td>@(Model.Address ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th>Status</th>
                        <td>
                            @if (Model.ActiveStatus)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Medical Records Profile</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <h6><strong>Allergies:</strong></h6>
                    <p class="border p-2 bg-light rounded">@(string.IsNullOrEmpty(Model.Allergies) ? "No allergies recorded." : Model.Allergies)</p>
                </div>
                <div>
                    <h6><strong>Medical History:</strong></h6>
                    <p class="border p-2 bg-light rounded" style="white-space: pre-line;">@(string.IsNullOrEmpty(Model.MedicalHistory) ? "No medical history recorded." : Model.MedicalHistory)</p>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 justify-content-end">
            <a asp-action="EditPatient" asp-route-id="@Model.Id" class="btn btn-warning">Edit Profile</a>
            <a asp-action="DeletePatient" asp-route-id="@Model.Id" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete patient @Model.User?.Username?')" >Delete Profile</a>
        </div>
    </div>
</div>
