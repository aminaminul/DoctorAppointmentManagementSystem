@model DoctorAppointmentManagementSystem.Models.Patient

@{
    ViewData["Title"] = "Patient Details";
}

<div class="container py-4">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-dark text-white p-3 d-flex align-items-center justify-content-between">
            <h3 class="mb-0 fw-bold"><i class="bi bi-person-lines-fill me-2"></i>Patient Details</h3>
            <a href="/Admin/Dashboard?section=patients" class="btn btn-outline-light btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
        <div class="card-body p-4">
            <div class="row g-4">
                <!-- Personal Details Column -->
                <div class="col-md-6">
                    <h5 class="fw-bold text-primary mb-3"><i class="bi bi-person-vcard me-2"></i>Personal Info</h5>
                    <table class="table table-hover border-bottom">
                        <tr>
                            <th class="w-35 text-secondary">Full Name</th>
                            <td class="fw-semibold">@Model.User?.Username</td>
                        </tr>
                        <tr>
                            <th class="text-secondary">Email Address</th>
                            <td>@Model.User?.Email</td>
                        </tr>
                        <tr>
                            <th class="text-secondary">Date of Birth</th>
                            <td>@(Model.DateOfBirth != default ? Model.DateOfBirth.ToString("dd MMM yyyy") : "Not Specified")</td>
                        </tr>
                        <tr>
                            <th class="text-secondary">Age</th>
                            <td>@Model.Age years</td>
                        </tr>
                        <tr>
                            <th class="text-secondary">Gender</th>
                            <td>@Model.Gender</td>
                        </tr>
                        <tr>
                            <th class="text-secondary">Blood Group</th>
                            <td>
                                @if (!string.IsNullOrEmpty(Model.BloodGroup))
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2.5 py-1.5 rounded-pill fw-bold">
                                        <i class="bi bi-droplet-fill me-1"></i> @Model.BloodGroup
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted italic">Not Specified</span>
                                }
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- Contact & Emergency Details Column -->
                <div class="col-md-6">
                    <h5 class="fw-bold text-primary mb-3"><i class="bi bi-telephone-inbound me-2"></i>Contact Details</h5>
                    <table class="table table-hover border-bottom">
                        <tr>
                            <th class="w-35 text-secondary">Phone Number</th>
                            <td>@(Model.User?.PhoneNumber ?? "Not Provided")</td>
                        </tr>
                        <tr>
                            <th class="text-secondary">Emergency Contact</th>
                            <td class="text-danger fw-semibold">@(Model.EmergencyContact ?? "Not Provided")</td>
                        </tr>
                        <tr>
                            <th class="text-secondary">Home Address</th>
                            <td>@(Model.Address ?? "Not Provided")</td>
                        </tr>
                    </table>
                </div>

                <!-- Medical Profile Section -->
                <div class="col-12 mt-4">
                    <h5 class="fw-bold text-primary mb-3 border-bottom pb-2"><i class="bi bi-heart-pulse-fill me-2"></i>Medical Profile</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100">
                                <h6 class="fw-bold text-secondary mb-2"><i class="bi bi-journal-medical me-2"></i>Medical History</h6>
                                <p class="mb-0 text-dark" style="white-space: pre-line;">@(string.IsNullOrEmpty(Model.MedicalHistory) ? "No medical history recorded." : Model.MedicalHistory)</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            @if (!string.IsNullOrEmpty(Model.Allergies))
                            {
                                <div class="p-3 bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-3 h-100">
                                    <h6 class="fw-bold mb-2"><i class="bi bi-exclamation-triangle-fill me-2"></i>Allergies</h6>
                                    <p class="mb-0 fw-semibold" style="white-space: pre-line;">@Model.Allergies</p>
                                </div>
                            }
                            else
                            {
                                <div class="p-3 bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-3 h-100">
                                    <h6 class="fw-bold mb-2"><i class="bi bi-check-circle-fill me-2"></i>Allergies</h6>
                                    <p class="mb-0 fw-semibold">No known allergies</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a href="/Admin/EditPatient/@Model.Id" class="btn btn-warning px-4 rounded-pill">
                    <i class="bi bi-pencil-square me-1"></i> Edit Patient
                </a>
                <a href="/Admin/DeletePatient/@Model.Id" class="btn btn-danger px-4 rounded-pill" onclick="return confirm('Are you sure you want to delete this patient?');">
                    <i class="bi bi-trash-fill me-1"></i> Delete Patient
                </a>
            </div>
        </div>
    </div>
</div>