@* Razor View: Admin/DoctorDetails *@
<!-- HTML View: Admin/DoctorDetails -->
@model DoctorAppointmentManagementSystem.Models.Doctor

@{
    ViewData["Title"] = "Doctor Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Doctor Details - Dr. @Model.User?.Username</h2>
    <a asp-action="Doctors" class="btn btn-secondary">Back to List</a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Account & Professional Profile</h5>
            </div>
            <div class="card-body">
<!-- Data Table Block -->
        <table class="table table-hover">
                    <tr>
                        <th style="width: 40%">Username / Name</th>
                        <td>Dr. @Model.User?.Username</td>
                    </tr>
                    <tr>
                        <th>Email Address</th>
                        <td>@Model.User?.Email</td>
                    </tr>
                    <tr>
                        <th>Phone Number</th>
                        <td>@(Model.User?.PhoneNumber ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th>Specialization</th>
                        <td>@Model.Specialization</td>
                    </tr>
                    <tr>
                        <th>Qualification</th>
                        <td>@(string.IsNullOrEmpty(Model.Qualification) ? "N/A" : Model.Qualification)</td>
                    </tr>
                    <tr>
                        <th>Experience (Years)</th>
                        <td>@Model.Experience Years</td>
                    </tr>
                    <tr>
                        <th>Consultation Fee</th>
                        <td>à§³@Model.ConsultationFee</td>
                    </tr>
                    <tr>
                        <th>Status</th>
                        <td>
                            @if (Model.ActiveStatus)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Chamber & Availability Info</h5>
            </div>
            <div class="card-body">
<!-- Data Table Block -->
        <table class="table table-hover">
                    <tr>
                        <th style="width: 40%">Available Days</th>
                        <td>@(Model.AvailableDays ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th>Available Time</th>
                        <td>@(Model.Availability ?? "N/A")</td>
                    </tr>
                </table>
            </div>
        </div>

        <div class="d-flex gap-2 justify-content-end">
            <a asp-action="EditDoctor" asp-route-id="@Model.Id" class="btn btn-warning">Edit Profile</a>
            <a asp-action="DeleteDoctor" asp-route-id="@Model.Id" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete Dr. @Model.User?.Username?')" >Delete Profile</a>
        </div>
    </div>
</div>

