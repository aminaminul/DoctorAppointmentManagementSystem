@* Razor View: Admin/Doctors *@
<!-- HTML View: Admin/Doctors -->
@model IEnumerable<DoctorAppointmentManagementSystem.Models.Doctor>

@{
    ViewData["Title"] = "Doctor Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Doctor Management</h2>
    <a asp-action="AddDoctor" class="btn btn-primary">Add Doctor</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
<!-- Data Table Block -->
        <table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Specialization</th>
            <th>Qualification</th>
            <th>Experience</th>
            <th>Fee (BDT)</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var doctorDisplayName = item.User?.Username ?? "Doctor";
            if (!doctorDisplayName.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase))
            {
                doctorDisplayName = "Dr. " + doctorDisplayName;
            }
            <tr>
                <td>@doctorDisplayName</td>
                <td>@item.User?.Email</td>
                <td>@item.Specialization</td>
                <td>@(string.IsNullOrEmpty(item.Qualification) ? "N/A" : item.Qualification)</td>
                <td>@item.Experience Years</td>
                <td>৳@item.ConsultationFee</td>
                <td>
                    @if (item.ActiveStatus)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </td>
                <td>
                    <a asp-action="DoctorDetails" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Details</a>
                    <a asp-action="EditDoctor" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="DeleteDoctor" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete @doctorDisplayName?')" >Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

