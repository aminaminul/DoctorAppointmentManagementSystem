@{
    Layout = "_Layout";
    ViewData["Title"] = "Live Chamber Queue Monitor";

    var doctors = ViewBag.Doctors as List<DoctorAppointmentManagementSystem.Models.Doctor> ?? new List<DoctorAppointmentManagementSystem.Models.Doctor>();
    int selectedDoctorId = ViewBag.SelectedDoctorId ?? 0;
    var selectedDoctor = ViewBag.SelectedDoctor as DoctorAppointmentManagementSystem.Models.Doctor;
    var queueEntries = ViewBag.QueueEntries as List<DoctorAppointmentManagementSystem.Models.QueueEntry> ?? new List<DoctorAppointmentManagementSystem.Models.QueueEntry>();
    var doctorStatus = ViewBag.DoctorStatus;

    var currentDocName = selectedDoctor?.User?.Username ?? "Doctor";
    if (!currentDocName.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase))
    {
        currentDocName = "Dr. " + currentDocName;
    }
}

<div class="container-fluid p-0">
    <!-- Header Banner -->
    <div class="card text-white shadow-sm mb-4 border-0 rounded-3 bg-dark border-start border-4 border-primary">
        <div class="card-body p-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <h3 class="fw-bold mb-1 text-white"><i class="bi bi-people-fill me-2 text-primary"></i>Live Chamber Queue Monitor</h3>
                <p class="mb-0 text-white-50">Real-time supervision of active patient tokens, consult progression, and waiting room flow for today (@DateTime.Today.ToString("dd MMMM yyyy")).</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Queue" asp-route-doctorId="@selectedDoctorId" class="btn btn-outline-light btn-sm"><i class="bi bi-arrow-clockwise me-1"></i>Live Refresh</a>
                <a asp-controller="Queue" asp-action="Display" target="_blank" class="btn btn-info btn-sm text-white fw-bold"><i class="bi bi-display me-1"></i>Public Screen View</a>
            </div>
        </div>
    </div>

    <!-- Doctor Switcher Bar -->
    <div class="card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-body p-3">
            <form method="get" asp-action="Queue" class="row g-2 align-items-center">
                <div class="col-auto">
                    <label class="fw-bold text-dark small"><i class="bi bi-person-badge me-1"></i>Select Chamber Physician:</label>
                </div>
                <div class="col-md-4">
                    <select name="doctorId" class="form-select form-select-sm" onchange="this.form.submit()">
                        @foreach (var doc in doctors)
                        {
                            <option value="@doc.Id" selected="@(selectedDoctorId == doc.Id ? "selected" : null)">
                                Dr. @doc.User?.Username (@doc.Specialization)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <span class="badge bg-primary-subtle text-primary p-2">Today: @DateTime.Today.ToString("dd MMM yyyy")</span>
                </div>
            </form>
        </div>
    </div>

    @if (selectedDoctor != null)
    {
        <div class="row g-4 mb-4">
            <!-- Doctor Active Status Card -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100 rounded-3 border-start border-4 border-info">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center" style="width: 55px; height: 55px; font-size: 1.5rem;">
                                @(selectedDoctor.User?.Username?.Substring(0, 1).ToUpper() ?? "D")
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-0">@currentDocName</h5>
                                <span class="badge bg-secondary-subtle text-secondary">@selectedDoctor.Specialization</span>
                            </div>
                        </div>
                        <hr class="my-3 text-muted" />
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Consultation Fee:</span>
                            <span class="fw-bold text-dark small">৳@selectedDoctor.ConsultationFee</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Availability Hours:</span>
                            <span class="fw-semibold text-dark small">@selectedDoctor.Availability</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Total in Today's Queue:</span>
                            <span class="badge bg-primary rounded-pill">@queueEntries.Count</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted small">Completed Today:</span>
                            <span class="badge bg-success rounded-pill">@queueEntries.Count(q => q.Status == "Completed")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Queue Progression List -->
            <div class="col-md-8">
                <div class="card shadow-sm border-0 rounded-3 overflow-hidden h-100">
                    <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-list-ol me-2 text-primary"></i>Live Token Progression
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light text-secondary small">
                                    <tr>
                                        <th class="ps-4">Token #</th>
                                        <th>Patient</th>
                                        <th>Appt Slot</th>
                                        <th>Status</th>
                                        <th class="text-end pe-4">Details</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (queueEntries.Any())
                                    {
                                        foreach (var q in queueEntries)
                                        {
                                            string rowClass = "";
                                            if (q.Status == "Serving" || q.Status == "In Consultation") rowClass = "table-warning";
                                            else if (q.Status == "Completed") rowClass = "table-light text-muted";

                                            <tr class="@rowClass">
                                                <td class="ps-4">
                                                    <span class="badge bg-dark rounded-circle p-2 fs-6" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                                                        @q.SequenceNumber
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="fw-bold text-dark small">@q.Appointment?.Patient?.User?.Username</div>
                                                    <div class="text-muted small">@q.Appointment?.Patient?.Gender, @q.Appointment?.Patient?.Age yrs</div>
                                                </td>
                                                <td class="small fw-semibold text-dark">
                                                    @q.Appointment?.AppointmentTime
                                                </td>
                                                <td>
                                                    @switch (q.Status)
                                                    {
                                                        case "Serving":
                                                        case "In Consultation":
                                                            <span class="badge bg-warning text-dark"><i class="bi bi-stethoscope me-1"></i>Inside Chamber</span>
                                                            break;
                                                        case "Completed":
                                                            <span class="badge bg-success"><i class="bi bi-check2-all me-1"></i>Completed</span>
                                                            break;
                                                        case "Waiting":
                                                            <span class="badge bg-info text-dark"><i class="bi bi-hourglass-split me-1"></i>Waiting</span>
                                                            break;
                                                        case "Cancelled":
                                                            <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Cancelled</span>
                                                            break;
                                                        default:
                                                            <span class="badge bg-secondary">@q.Status</span>
                                                            break;
                                                    }
                                                </td>
                                                <td class="text-end pe-4">
                                                    <a asp-action="PatientDetails" asp-route-id="@q.Appointment?.PatientId" class="btn btn-outline-secondary btn-sm" title="View Patient Profile">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center py-5 text-muted">
                                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                                <span>No queue entries active for @currentDocName today.</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
