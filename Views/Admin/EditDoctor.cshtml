@model Doctor

<h2>Edit Doctor</h2>

<form method="post">

    <input type="hidden" name="Id" value="@Model.Id" />

    <input type="text" name="Specialization" value="@Model.Specialization" class="form-control" /><br />

    <input type="text" name="Availability" value="@Model.Availability" class="form-control" /><br />

    <button type="submit" class="btn btn-primary">Update</button>

</form>