@model DoctorAppointmentManagementSystem.Models.Patient

@{
    ViewData["Title"] = "Edit Patient";
}

<h2>Edit Patient</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="EditPatient">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserId" />

            <div class="mb-3">
                <label asp-for="User.Username" class="form-label">Patient Name</label>
                <input asp-for="User.Username" class="form-control" required />
            </div>
            
            <div class="mb-3">
                <label asp-for="User.Email" class="form-label">Email Address</label>
                <input asp-for="User.Email" type="email" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="User.PhoneNumber" class="form-label">Phone Number</label>
                <input asp-for="User.PhoneNumber" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
                <input asp-for="DateOfBirth" type="date" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="Gender" class="form-label">Gender</label>
                <select asp-for="Gender" class="form-control" required>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="BloodGroup" class="form-label">Blood Group</label>
                <select asp-for="BloodGroup" class="form-control">
                    <option value="">Select Blood Group</option>
                    <option value="A+">A+</option>
                    <option value="A-">A-</option>
                    <option value="B+">B+</option>
                    <option value="B-">B-</option>
                    <option value="AB+">AB+</option>
                    <option value="AB-">AB-</option>
                    <option value="O+">O+</option>
                    <option value="O-">O-</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="EmergencyContact" class="form-label">Emergency Contact</label>
                <input asp-for="EmergencyContact" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label">Address</label>
                <input asp-for="Address" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Allergies" class="form-label">Allergies</label>
                <textarea asp-for="Allergies" rows="2" class="form-control" placeholder="No known allergies"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="MedicalHistory" class="form-label">Medical History</label>
                <textarea asp-for="MedicalHistory" rows="3" class="form-control" placeholder="No medical history recorded"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="ActiveStatus" class="form-label">Account Status</label>
                <select asp-for="ActiveStatus" class="form-control">
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Update Patient</button>
            <a asp-action="Patients" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
