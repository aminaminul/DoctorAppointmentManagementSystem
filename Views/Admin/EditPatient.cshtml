@model Patient

@{
    ViewData["Title"] = "Edit Patient";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-dark text-white p-3 d-flex align-items-center justify-content-between">
                    <h3 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2 text-warning"></i>Edit Patient</h3>
                    <a href="/Admin/Dashboard?section=patients" class="btn btn-outline-light btn-sm rounded-pill px-3">
                        Cancel
                    </a>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UserId" />

                        <h5 class="fw-bold text-primary mb-3"><i class="bi bi-person-circle me-2"></i>Personal details</h5>
                        
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label text-secondary small fw-semibold">Full Name</label>
                                <input asp-for="User.Username" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-secondary small fw-semibold">Email Address</label>
                                <input asp-for="User.Email" type="email" class="form-control" required readonly style="background-color: #f8f9fa;" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-secondary small fw-semibold">Date of Birth</label>
                                <input asp-for="DateOfBirth" type="date" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-secondary small fw-semibold">Gender</label>
                                <select asp-for="Gender" class="form-select" required>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-secondary small fw-semibold">Blood Group</label>
                                <select asp-for="BloodGroup" class="form-select">
                                    <option value="">Select Blood Group</option>
                                    <option value="A+">A+</option>
                                    <option value="A-">A-</option>
                                    <option value="B+">B+</option>
                                    <option value="B-">B-</option>
                                    <option value="AB+">AB+</option>
                                    <option value="AB-">AB-</option>
                                    <option value="O+">O+</option>
                                    <option value="O-">O-</option>
                                </select>
                            </div>
                        </div>

                        <h5 class="fw-bold text-primary mb-3 border-top pt-4"><i class="bi bi-telephone-inbound me-2"></i>Contact Info</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label text-secondary small fw-semibold">Phone Number</label>
                                <input asp-for="User.PhoneNumber" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-secondary small fw-semibold">Emergency Contact</label>
                                <input asp-for="EmergencyContact" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label class="form-label text-secondary small fw-semibold">Home Address</label>
                                <input asp-for="Address" class="form-control" />
                            </div>
                        </div>

                        <h5 class="fw-bold text-primary mb-3 border-top pt-4"><i class="bi bi-heart-pulse-fill me-2"></i>Medical Profile</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label class="form-label text-secondary small fw-semibold">Allergies</label>
                                <textarea asp-for="Allergies" rows="2" class="form-control" placeholder="No known allergies"></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label text-secondary small fw-semibold">Medical History</label>
                                <textarea asp-for="MedicalHistory" rows="3" class="form-control" placeholder="No medical history recorded"></textarea>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a href="/Admin/Dashboard?section=patients" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>