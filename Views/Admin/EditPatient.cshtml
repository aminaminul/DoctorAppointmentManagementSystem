@model Patient

<h2>Edit Patient</h2>

<form method="post">

    <input type="hidden" name="Id" value="@Model.Id" />

    <input type="number" name="Age" value="@Model.Age" class="form-control" /><br />

    <input type="text" name="Gender" value="@Model.Gender" class="form-control" /><br />

    <button type="submit" class="btn btn-primary">Update</button>

</form>