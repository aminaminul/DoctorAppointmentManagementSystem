@using DoctorAppointmentManagementSystem.ViewModels
@model PatientCreateViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Add New Patient";
}

<div class="container-fluid p-0">
    <div class="card text-white shadow-sm mb-4 border-0 rounded-3 bg-dark border-start border-4 border-primary">
        <div class="card-body p-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <h3 class="fw-bold mb-1 text-white"><i class="bi bi-person-plus-fill me-2 text-primary"></i>Register New Patient</h3>
                <p class="mb-0 text-white-50">Create a clinical patient profile with medical demographics and emergency contact information.</p>
            </div>
            <a asp-action="Patients" class="btn btn-outline-light btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to Patients</a>
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white border-0 py-3 px-4">
            <h5 class="fw-bold mb-0 text-dark">Patient Demographics &amp; Account Setup</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="AddPatient" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-bold">Full Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Arif Hossain" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-bold">Email Address <span class="text-danger">*</span></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="patient@example.com" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-bold">Account Password <span class="text-danger">*</span></label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Temporary password" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label fw-bold">Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="e.g. 01812345678" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Age" class="form-label fw-bold">Age (Years) <span class="text-danger">*</span></label>
                        <input asp-for="Age" type="number" min="0" max="130" class="form-control" value="28" required />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Gender" class="form-label fw-bold">Gender <span class="text-danger">*</span></label>
                        <select asp-for="Gender" class="form-select" required>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="BloodGroup" class="form-label fw-bold">Blood Group</label>
                        <select asp-for="BloodGroup" class="form-select">
                            <option value="">Unknown / Select</option>
                            <option value="A+">A+</option>
                            <option value="A-">A-</option>
                            <option value="B+">B+</option>
                            <option value="B-">B-</option>
                            <option value="O+">O+</option>
                            <option value="O-">O-</option>
                            <option value="AB+">AB+</option>
                            <option value="AB-">AB-</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label asp-for="Address" class="form-label fw-bold">Residential Address</label>
                        <input asp-for="Address" class="form-control" placeholder="e.g. House 12, Road 4, Dhanmondi, Dhaka" />
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Patients" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-success fw-bold px-4"><i class="bi bi-check2-circle me-1"></i>Register Patient</button>
                </div>
            </form>
        </div>
    </div>
</div>
