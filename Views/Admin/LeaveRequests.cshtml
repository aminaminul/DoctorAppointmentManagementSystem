@model IEnumerable<DoctorAppointmentManagementSystem.Models.LeaveRequest>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Leave Requests";
}

<div class="container-fluid p-0">
    <!-- Header Banner -->
    <div class="card text-white shadow-sm mb-4 border-0 rounded-3 bg-dark border-start border-4 border-primary">
        <div class="card-body p-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <h3 class="fw-bold mb-1 text-white"><i class="bi bi-calendar-minus me-2 text-primary"></i>Staff &amp; Physician Leave Requests</h3>
                <p class="mb-0 text-white-50">Review and approve vacation time, medical leaves, and absence requests from clinic doctors and personnel.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="LeaveRequests" class="btn btn-outline-light btn-sm"><i class="bi bi-arrow-clockwise me-1"></i>Refresh</a>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Leave Requests Table Card -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">
                Leave Applications
                <span class="badge bg-primary-subtle text-primary rounded-pill ms-2">@Model.Count() Total</span>
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small">
                        <tr>
                            <th class="ps-4">Applicant</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Duration</th>
                            <th>Reason / Purpose</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                int durationDays = (item.EndDate - item.StartDate).Days + 1;
                                if (durationDays < 1) durationDays = 1;

                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark small">@item.User?.Username</div>
                                        <div class="text-muted small">@item.User?.Email</div>
                                    </td>
                                    <td class="small text-dark fw-semibold">
                                        @item.StartDate.ToString("dd MMM yyyy")
                                    </td>
                                    <td class="small text-dark fw-semibold">
                                        @item.EndDate.ToString("dd MMM yyyy")
                                    </td>
                                    <td class="small">
                                        <span class="badge bg-light text-dark border">@durationDays Day(s)</span>
                                    </td>
                                    <td>
                                        <div class="text-dark small" style="max-width: 350px;">
                                            @item.Reason
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.Status == "Approved")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success"><i class="bi bi-check-circle me-1"></i>Approved</span>
                                        }
                                        else if (item.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger"><i class="bi bi-x-circle me-1"></i>Rejected</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            @if (item.Status == "Pending")
                                            {
                                                <form asp-action="UpdateLeaveStatus" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="status" value="Approved" />
                                                    <button type="submit" class="btn btn-outline-success" title="Approve Request">
                                                        <i class="bi bi-check-lg me-1"></i>Approve
                                                    </button>
                                                </form>
                                                <form asp-action="UpdateLeaveStatus" method="post" class="d-inline ms-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="status" value="Rejected" />
                                                    <button type="submit" class="btn btn-outline-danger" title="Reject Request">
                                                        <i class="bi bi-x-lg me-1"></i>Reject
                                                    </button>
                                                </form>
                                            }
                                            <a asp-action="DeleteLeaveRequest" asp-route-id="@item.Id" class="btn btn-outline-secondary ms-1" onclick="return confirm('Delete leave request?')" title="Delete Record">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-calendar-check fs-2 d-block mb-2 text-secondary"></i>
                                    <span>No leave applications submitted.</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
