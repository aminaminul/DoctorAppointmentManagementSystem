@* Razor View: Admin/LeaveRequests *@
<!-- HTML View: Admin/LeaveRequests -->
@model IEnumerable<DoctorAppointmentManagementSystem.Models.LeaveRequest>

@{
    ViewData["Title"] = "Leave Requests";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Leave Requests</h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
<!-- Data Table Block -->
        <table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>User</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Reason</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.User?.Username</td>
                <td>@item.StartDate.ToShortDateString()</td>
                <td>@item.EndDate.ToShortDateString()</td>
                <td>@item.Reason</td>
                <td>
                    <span class="badge @(item.Status == "Approved" ? "bg-success" : (item.Status == "Pending" ? "bg-warning text-dark" : "bg-danger"))">
                        @item.Status
                    </span>
                </td>
                <td>
                    @if (item.Status == "Pending")
                    {
<!-- Form Block -->
        <form asp-action="UpdateLeaveStatus" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="status" value="Approved" />
                            <button type="submit" class="btn btn-sm btn-success">Approve</button>
                        </form>
<!-- Form Block -->
        <form asp-action="UpdateLeaveStatus" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="status" value="Rejected" />
                            <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                        </form>
                    }
                    <a asp-action="DeleteLeaveRequest" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this request?')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

