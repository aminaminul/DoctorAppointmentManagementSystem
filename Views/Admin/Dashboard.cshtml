@* Razor View: Admin/Dashboard *@
<!-- HTML View: Admin/Dashboard -->
@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin Dashboard";

    var greeting = "Welcome back";
    var hour = DateTime.Now.Hour;
    if (hour < 12) greeting = "Good morning";
    else if (hour < 18) greeting = "Good afternoon";
    else greeting = "Good evening";

    var recentAppointments = ViewBag.RecentAppointments as List<DoctorAppointmentManagementSystem.Models.Appointment> ?? new List<DoctorAppointmentManagementSystem.Models.Appointment>();
    var recentSchedules = ViewBag.RecentSchedules as List<DoctorAppointmentManagementSystem.Models.DoctorSchedule> ?? new List<DoctorAppointmentManagementSystem.Models.DoctorSchedule>();
    var adminName = ViewData["Username"] as string ?? "Admin";
}

<!-- JavaScript Block -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container-fluid p-0">
    
    <!-- Admin Hero Banner matching Doctor/Patient Dashboard Theme -->
    <div class="card text-white shadow-sm mb-4 border-0 rounded-3 bg-dark border-start border-4 border-primary">
        <div class="card-body p-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center border border-3 border-secondary shadow-sm flex-shrink-0" style="width: 65px; height: 65px; min-width: 65px; font-size: 1.75rem;">
                    @(!string.IsNullOrEmpty(adminName) ? adminName.Substring(0,1).ToUpper() : "A")
                </div>
                <div>
                    <h3 class="fw-bold mb-1 text-white">@greeting, @adminName!</h3>
                    <p class="mb-0 text-white-50"><span class="badge bg-primary me-2">Super Admin</span> DAMS Management System | Total Scheduled Appointments: <span class="badge bg-info text-dark">@ViewBag.TotalAppointmentsCount</span></p>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-info text-white btn-sm font-weight-bold">
                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                </a>
                <a asp-controller="Admin" asp-action="Doctors" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-person-badge me-1"></i> Doctors (@ViewBag.TotalDoctorsCount)
                </a>
                <a asp-controller="Admin" asp-action="Patients" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-people me-1"></i> Patients (@ViewBag.TotalPatientsCount)
                </a>
                <a asp-controller="Admin" asp-action="Complaints" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-bell me-1"></i> Complaints
                </a>
                <a asp-controller="Report" asp-action="Revenue" class="btn btn-sm btn-outline-light rounded-pill px-3">
                    <i class="bi bi-file-earmark-bar-graph me-1"></i> Revenue Reports
                </a>
            </div>
        </div>
    </div>

    <!-- Dashboard Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-6 col-lg-3">
            <a asp-controller="Report" asp-action="Revenue" class="card text-decoration-none h-100 shadow-sm border-0 border-start border-4 border-success">
                <div class="card-body d-flex flex-column justify-content-between p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-uppercase small fw-bold text-success">Total Revenue</span>
                        <i class="bi bi-wallet2 text-success fs-4"></i>
                    </div>
                    <div class="d-flex align-items-baseline gap-2 mt-3">
                        <h2 class="fw-bold text-success mb-0">৳@(ViewBag.TotalCollection ?? 0)</h2>
                        <span class="badge bg-success-subtle text-success">Live DB</span>
                    </div>
                    <span class="text-muted small">Total collections (Appts &amp; Tickets)</span>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a asp-controller="Report" asp-action="Appointment" class="card text-decoration-none h-100 shadow-sm border-0 border-start border-4 border-primary">
                <div class="card-body d-flex flex-column justify-content-between p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-uppercase small fw-bold text-primary">Appointments</span>
                        <i class="bi bi-calendar-check text-primary fs-4"></i>
                    </div>
                    <div class="d-flex align-items-baseline gap-2 mt-3">
                        <h2 class="fw-bold text-dark mb-0">@ViewBag.TotalAppointmentsCount</h2>
                        <span class="badge bg-primary-subtle text-primary">Booked</span>
                    </div>
                    <span class="text-muted small">Scheduled appointments</span>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a asp-controller="Admin" asp-action="Doctors" class="card text-decoration-none h-100 shadow-sm border-0 border-start border-4 border-info">
                <div class="card-body d-flex flex-column justify-content-between p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-uppercase small fw-bold text-info">Active Doctors</span>
                        <i class="bi bi-person-badge text-info fs-4"></i>
                    </div>
                    <div class="d-flex align-items-baseline gap-2 mt-3">
                        <h2 class="fw-bold text-dark mb-0">@ViewBag.TotalDoctorsCount</h2>
                        <span class="badge bg-info-subtle text-info">Active</span>
                    </div>
                    <span class="text-muted small">Verified specialists</span>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a asp-controller="Admin" asp-action="Patients" class="card text-decoration-none h-100 shadow-sm border-0 border-start border-4 border-teal">
                <div class="card-body d-flex flex-column justify-content-between p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-uppercase small fw-bold text-secondary">Patients</span>
                        <i class="bi bi-people text-secondary fs-4"></i>
                    </div>
                    <div class="d-flex align-items-baseline gap-2 mt-3">
                        <h2 class="fw-bold text-dark mb-0">@ViewBag.TotalPatientsCount</h2>
                        <span class="badge bg-secondary-subtle text-dark">Registered</span>
                    </div>
                    <span class="text-muted small">Registered clinic profiles</span>
                </div>
            </a>
        </div>
    </div>

    <!-- Charts & Recent Appointments Section -->
    <div class="row g-4 mb-4">
        
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-dark m-0">Patients Overview</h5>
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-outline-secondary active">Week</button>
                            <button type="button" class="btn btn-outline-secondary">Month</button>
                            <button type="button" class="btn btn-outline-secondary">Year</button>
                        </div>
                    </div>
                    <div class="chart-container">
                        <canvas id="patientsOverviewChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark m-0">Recent Appointments</h5>
                    <a asp-controller="Report" asp-action="Appointment" class="small text-primary text-decoration-none">See all</a>
                </div>
                <div class="card-body px-4 pb-4 pt-2">
                    <div class="appointments-vertical-list">
                        @if (recentAppointments.Any())
                        {
                            foreach (var appt in recentAppointments)
                            {
                                var docName = appt.Doctor?.User?.Username ?? "Doctor";
                                if (!docName.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase))
                                {
                                    docName = "Dr. " + docName;
                                }
                                <div class="appointment-item d-flex justify-content-between align-items-center py-2 border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center p-2">
                                            @(appt.Patient?.User?.Username?.Substring(0,1).ToUpper() ?? "P")
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark small">
                                                <a asp-controller="Admin" asp-action="PatientDetails" asp-route-id="@appt.PatientId" class="text-decoration-none text-dark">@appt.Patient?.User?.Username</a>
                                            </div>
                                            <div class="text-muted small">
                                                <a asp-controller="Admin" asp-action="DoctorDetails" asp-route-id="@appt.DoctorId" class="text-decoration-none text-muted">@docName (@appt.Doctor?.Specialization)</a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="text-dark fw-semibold small">@appt.AppointmentTime</div>
                                        <span class="badge small @(appt.AppointmentStatus == "Completed" ? "bg-success" : (appt.AppointmentStatus == "Pending" ? "bg-warning text-dark" : "bg-primary"))">@appt.AppointmentStatus</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x fs-3 d-block mb-2"></i>
                                <span class="small">No appointments scheduled.</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4" id="doctor-schedules">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark m-0"><i class="bi bi-clock-fill me-2 text-primary"></i>Doctor Schedules & Chamber Slots</h5>
                    <div class="d-flex gap-2">
                        <a asp-controller="Admin" asp-action="Doctors" class="btn btn-sm btn-outline-primary rounded-pill px-3">Manage Doctors</a>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr class="table-light text-secondary small">
                                    <th class="ps-4">Doctor Name</th>
                                    <th>Specialty</th>
                                    <th>Chamber Date</th>
                                    <th>Time Slot</th>
                                    <th>Consultation Fee</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (recentSchedules.Any())
                                {
                                    foreach (var schedule in recentSchedules)
                                    {
                                        var docName = schedule.Doctor?.User?.Username ?? "Doctor";
                                        if (!docName.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase))
                                        {
                                            docName = "Dr. " + docName;
                                        }
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold text-dark small">
                                                    <a asp-controller="Admin" asp-action="DoctorDetails" asp-route-id="@schedule.DoctorId" class="text-decoration-none text-dark">@docName</a>
                                                </div>
                                                <div class="text-muted small">@schedule.Doctor?.Qualification</div>
                                            </td>
                                            <td><span class="badge bg-secondary text-white small">@schedule.Doctor?.Specialization</span></td>
                                            <td class="text-dark small">@schedule.AvailableDate.ToString("dd MMM yyyy")</td>
                                            <td class="text-dark small">@schedule.StartTime – @schedule.EndTime</td>
                                            <td class="fw-bold text-dark small">৳@schedule.Doctor?.ConsultationFee</td>
                                            <td>
                                                <span class="badge rounded-pill small @(schedule.IsVacation ? "bg-danger" : "bg-success")">
                                                    @(schedule.IsVacation ? "Vacation" : schedule.SlotStatus)
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted small">No active doctor schedules found in database.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var ctx = document.getElementById('patientsOverviewChart').getContext('2d');
            var chart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT', 'SUN'],
                    datasets: [
                        {
                            label: 'Patient Visits',
                            backgroundColor: '#0b1727',
                            data: [350, 592, 420, 310, 680, 560, 240],
                            borderRadius: 6,
                            barPercentage: 0.6,
                            categoryPercentage: 0.6
                        },
                        {
                            label: 'Discharged / Completed',
                            backgroundColor: '#4DA8DA',
                            data: [290, 452, 380, 280, 590, 490, 190],
                            borderRadius: 6,
                            barPercentage: 0.6,
                            categoryPercentage: 0.6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'bottom',
                            labels: {
                                boxWidth: 12,
                                font: {
                                    size: 11,
                                    family: 'Segoe UI'
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(0, 0, 0, 0.05)',
                                drawBorder: false
                            },
                            ticks: {
                                font: {
                                    size: 11
                                }
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                font: {
                                    size: 11,
                                    weight: 'bold'
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
}
