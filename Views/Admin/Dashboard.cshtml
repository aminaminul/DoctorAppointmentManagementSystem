@{
    Layout = "_Layout";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-3">
            @await Component.InvokeAsync("Sidebar")
        </div>
        <div class="col-md-9">
            <div class="card mb-3">
                <div class="card-body">
                    <h3 class="mb-0">Admin Dashboard</h3>
                    <p class="text-muted small">Simple overview</p>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="card p-3">
                        <h6>Total Doctors</h6>
                        <div class="display-6">@ViewBag.Doctors?.Count ?? 0</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card p-3">
                        <h6>Total Patients</h6>
                        <div class="display-6">@ViewBag.Patients?.Count ?? 0</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card p-3">
                        <h6>Total Appointments</h6>
                        <div class="display-6">@ViewBag.Appointments?.Count ?? 0</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
                        <h5 class="mb-0">Queue Control</h5>
                    </div>
                    <div class="card-body">
                        <form method="get" action="/Admin/Dashboard" class="row g-2 align-items-center">
                            <input type="hidden" name="section" value="queue" />
                            <div class="col-auto">
                                <label class="col-form-label fw-bold text-secondary">Select Doctor:</label>
                            </div>
                            <div class="col-md-4">
                                <select name="doctorId" class="form-select" onchange="this.form.submit()">
                                    @foreach (var doc in ViewBag.Doctors)
                                    {
                                        <option value="@doc.Id" selected="@(doc.Id == ViewBag.SelectedDoctorId ? "selected" : null)">Dr. @doc.User.FullName (@doc.Specialization)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-dark">Load Queue</button>
                            </div>
                            <div class="col-auto ms-auto">
                                <span class="text-secondary small fw-bold">Doctor Status:</span>
                                @if (ViewBag.DoctorStatus == "Serving Patients")
                                {
                                    <span class="badge bg-success"><i class="bi bi-activity me-1"></i> Serving Patients</span>
                                }
                                else if (ViewBag.DoctorStatus == "On Break")
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-cup-hot me-1"></i> Lunch Break</span>
                                }
                                else if (ViewBag.DoctorStatus == "On Vacation")
                                {
                                    <span class="badge bg-danger"><i class="bi bi-airplane me-1"></i> Vacation</span>
                                }
                                else if (ViewBag.DoctorStatus == "Available")
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-moon me-1"></i> Offline</span>
                                }
                            </div>
                        </form>

                        @if (ViewBag.QueueEntries != null)
                        {
                            var queue = ViewBag.QueueEntries as List<QueueEntry>;
                            <div class="table-responsive mt-3">
                                <table class="table align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Seq</th>
                                            <th>Token</th>
                                            <th>Patient Name</th>
                                            <th>Scheduled Time</th>
                                            <th>Priority</th>
                                            <th class="text-end">Override</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var item in queue)
                                    {
                                        <tr>
                                            <td class="fw-bold">@item.SequenceNumber</td>
                                            <td><span class="badge bg-primary rounded-pill">#@item.TokenNumber</span></td>
                                            <td>@item.Appointment.Patient.User.Username</td>
                                            <td>@item.Appointment.AppointmentTime</td>
                                            <td>
                                                @if (item.Appointment.IsEmergency)
                                                {
                                                    <span class="badge bg-danger">EMERGENCY</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Normal</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                @if (!item.Appointment.IsEmergency && item.Status == "Waiting")
                                                {
                                                    <form method="post" action="/Queue/BumpEmergency" style="display:inline;">
                                                        <input type="hidden" name="Id" value="@item.Id" />
                                                        <input type="hidden" name="redirectSection" value="admin" />
                                                        <button type="submit" class="btn btn-outline-danger btn-sm">Bump to Emergency</button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
