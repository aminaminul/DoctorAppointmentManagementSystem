@* Razor View: Admin/Patients *@
<!-- HTML View: Admin/Patients -->
@model IEnumerable<DoctorAppointmentManagementSystem.Models.Patient>

@{
    ViewData["Title"] = "Patient Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Patient Management</h2>
    <a asp-action="AddPatient" class="btn btn-primary">Add Patient</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
<!-- Data Table Block -->
        <table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Age</th>
            <th>Gender</th>
            <th>Blood Group</th>
            <th>Phone</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.User?.Username</td>
                <td>@item.User?.Email</td>
                <td>@item.Age</td>
                <td>@item.Gender</td>
                <td>@(string.IsNullOrEmpty(item.BloodGroup) ? "N/A" : item.BloodGroup)</td>
                <td>@(item.User?.PhoneNumber ?? "N/A")</td>
                <td>
                    @if (item.ActiveStatus)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </td>
                <td>
                    <a asp-action="PatientDetails" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Details</a>
                    <a asp-action="EditPatient" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="DeletePatient" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete patient @item.User?.Username?')" >Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

