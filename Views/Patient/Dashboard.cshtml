@model List<Appointment>

@{
    Layout = "_Layout";
}

<div class="container-fluid mt-3">
    <div class="row">

        <!-- 🔷 SIDEBAR -->
        <div class="col-md-3">

            <div class="bg-dark text-white p-4 rounded shadow"
                 style="min-height:90vh;">

                <h2 class="fw-bold mb-5">
                    Patient Panel
                </h2>

                <ul class="nav flex-column">

                    <!-- My Appointment -->
                    <li class="nav-item mb-4">
                        <a class="nav-link text-white fs-5"
                           href="/Patient/Dashboard?section=appointments">

                            📅 My Appointments
                        </a>
                    </li>

                    <!-- Book Appointment -->
                    <li class="nav-item mb-4">
                        <a class="nav-link text-white fs-5"
                           href="/Appointment/Book">

                            ➕ Book Appointment
                        </a>
                    </li>

                    <!-- View Profile -->
                    <li class="nav-item mb-5">
                        <a class="nav-link text-white fs-5"
                           href="/Patient/Dashboard?section=profile">

                            👤 View Profile
                        </a>
                    </li>

                    <!-- Logout -->
                    <li class="nav-item mt-4">
                        <a href="/Account/Logout"
                           class="btn btn-danger w-100 fs-5 p-2">

                            Logout
                        </a>
                    </li>

                </ul>

            </div>

        </div>

        <!-- 🔷 RIGHT CONTENT -->
        <div class="col-md-9">

            @if (ViewBag.Section == null)
            {
                <div class="alert alert-info mt-4 fs-4">
                     Please select an option from sidebar
                </div>
            }

            <!-- 🔷 MY APPOINTMENTS -->
            @if (ViewBag.Section == "appointments")
            {
                <div class="card shadow">

                    <div class="card-header bg-primary text-white">
                        <h4>My Appointments</h4>
                    </div>

                    <div class="card-body">

                        <table class="table table-bordered table-striped">

                            <thead class="table-dark">
                                <tr>
                                    <th>Doctor</th>
                                    <th>Date</th>
                                    <th>Time</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Doctor.User.Name</td>
                                        <td>@item.Date.ToShortDateString()</td>
                                        <td>@item.TimeSlot</td>

                                        <td>
                                            @if (item.Status.ToLower() == "approved")
                                            {
                                                <span class="badge bg-success">
                                                    Approved
                                                </span>
                                            }
                                            else if (item.Status.ToLower() == "rejected")
                                            {
                                                <span class="badge bg-danger">
                                                    Rejected
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    Pending
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                </div>
            }

            <!-- 🔷 PROFILE -->
            @if (ViewBag.Section == "profile")
            {
                <div class="card shadow">

                    <div class="card-header bg-dark text-white">
                        <h4>My Profile</h4>
                    </div>

                    <div class="card-body">

                        <p><strong>Name:</strong> @ViewBag.PatientName</p>

                        <p><strong>Email:</strong> @ViewBag.Email</p>

                        <p><strong>Age:</strong> @ViewBag.Age</p>

                        <p><strong>Gender:</strong> @ViewBag.Gender</p>

                        <a href="/Patient/EditProfile"
                           class="btn btn-warning">

                            Edit Profile
                        </a>

                    </div>

                </div>
            }

        </div>

    </div>
</div>