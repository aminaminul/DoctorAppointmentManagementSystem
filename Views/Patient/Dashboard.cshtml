@* Razor View: Patient/Dashboard Redesign using ASP.NET Core Tag Helpers *@
@model List<DoctorAppointmentManagementSystem.Models.Appointment>
@using DoctorAppointmentManagementSystem.Models

@{
    Layout = "_Layout";
    ViewData["Title"] = "Patient Portal & Dashboard";
    string currentSection = (ViewBag.Section as string ?? "overview").ToLowerInvariant();
    var patient = ViewBag.Patient as Patient;
    var nextAppt = ViewBag.NextAppointment as Appointment;
    var appointments = ViewBag.Appointments as List<Appointment> ?? new List<Appointment>();
    var upcomingAppts = ViewBag.UpcomingAppointmentsList as List<Appointment> ?? new List<Appointment>();
    var prescriptions = ViewBag.Prescriptions as List<Prescription> ?? new List<Prescription>();
    var medicalRecords = ViewBag.MedicalRecords as List<MedicalRecord> ?? new List<MedicalRecord>();
    var labReports = ViewBag.LabReports as List<LabReport> ?? new List<LabReport>();
    var allLabTests = ViewBag.AllLabTests as List<LabTest> ?? new List<LabTest>();
    var medicalDocuments = ViewBag.MedicalDocuments as List<MedicalDocument> ?? new List<MedicalDocument>();
    var insurance = ViewBag.Insurance as InsuranceInfo;
    var doctors = ViewBag.Doctors as List<Doctor> ?? new List<Doctor>();
    var payments = ViewBag.Payments as List<Payment> ?? new List<Payment>();
    var invoices = ViewBag.Invoices as List<Invoice> ?? new List<Invoice>();
    var notifications = ViewBag.Notifications as List<Notification> ?? new List<Notification>();
    var reviews = ViewBag.Reviews as List<Feedback> ?? new List<Feedback>();
    var chatMessages = ViewBag.ChatMessages as List<ChatMessage> ?? new List<ChatMessage>();
    int selectedDoctorUserId = ViewBag.SelectedDoctorUserId != null ? (int)ViewBag.SelectedDoctorUserId : 0;
    int unreadNotifCount = ViewBag.UnreadNotificationCount != null ? (int)ViewBag.UnreadNotificationCount : 0;
    string patientName = ViewBag.PatientName as string ?? "Patient";
}

<!-- ApexCharts Script Integration -->
<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

<div class="container-fluid py-3">
    <!-- Toast & Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Banner matching Dark Slate Theme -->
    <div class="card text-white shadow-sm mb-4 border-0 rounded-3 bg-dark border-start border-4 border-info">
        <div class="card-body p-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center border border-3 border-secondary shadow-sm flex-shrink-0" style="width: 65px; height: 65px; min-width: 65px; font-size: 1.75rem;">
                    @(!string.IsNullOrEmpty(patientName) ? patientName.Substring(0,1).ToUpper() : "P")
                </div>
                <div>
                    <h3 class="fw-bold mb-1 text-white">Welcome, @patientName!</h3>
                    <p class="mb-0 text-white-50">Age: @ViewBag.Age | Gender: @ViewBag.Gender | Blood Group: <span class="badge bg-danger">@(ViewBag.BloodGroup ?? "N/A")</span></p>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Patient" asp-action="Dashboard" asp-route-section="overview" class="btn @(currentSection == "overview" ? "btn-info text-white" : "btn-outline-light") btn-sm font-weight-bold">
                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                </a>
                <a asp-controller="Patient" asp-action="Dashboard" asp-route-section="appointments" class="btn @(currentSection == "appointments" ? "btn-info text-white" : "btn-outline-light") btn-sm">
                    <i class="bi bi-calendar-check me-1"></i> Appointments (@appointments.Count)
                </a>
                <a asp-controller="Patient" asp-action="Dashboard" asp-route-section="doctors" class="btn @(currentSection == "doctors" ? "btn-info text-white" : "btn-outline-light") btn-sm">
                    <i class="bi bi-search me-1"></i> Find Doctor
                </a>
                <a asp-controller="Patient" asp-action="Dashboard" asp-route-section="prescriptions" class="btn @(currentSection == "prescriptions" ? "btn-info text-white" : "btn-outline-light") btn-sm">
                    <i class="bi bi-prescription me-1"></i> Prescriptions
                </a>
                <a asp-controller="Patient" asp-action="Dashboard" asp-route-section="invoices" class="btn @(currentSection == "invoices" || currentSection == "payments" ? "btn-info text-white" : "btn-outline-light") btn-sm">
                    <i class="bi bi-receipt me-1"></i> Invoices &amp; Bills (@invoices.Count)
                </a>
                <button type="button" class="btn btn-primary btn-sm font-weight-bold" data-bs-toggle="modal" data-bs-target="#bookApptModal">
                    <i class="bi bi-calendar-plus me-1"></i> Book Appointment
                </button>
            </div>
        </div>
    </div>

    <!-- SECTION 1: OVERVIEW & DASHBOARD STATS -->
    @if (currentSection == "overview")
    {
        <!-- Statistics Cards -->
        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6">
                <div class="card shadow-sm border-0 border-start border-4 border-primary h-100">
                    <div class="card-body d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">Total Appointments</span>
                            <h2 class="fw-bold text-primary mb-0">@ViewBag.TotalAppointments</h2>
                            <small class="text-success"><i class="bi bi-check-circle me-1"></i>@ViewBag.CompletedAppointments Completed</small>
                        </div>
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 fs-3">
                            <i class="bi bi-calendar-event"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="card shadow-sm border-0 border-start border-4 border-warning h-100">
                    <div class="card-body d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">Pending Requests</span>
                            <h2 class="fw-bold text-warning mb-0">@ViewBag.PendingAppointments</h2>
                            <small class="text-muted">Awaiting Doctor Approval</small>
                        </div>
                        <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3 fs-3">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="card shadow-sm border-0 border-start border-4 border-success h-100">
                    <div class="card-body d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">Active Prescriptions</span>
                            <h2 class="fw-bold text-success mb-0">@prescriptions.Count</h2>
                            <small class="text-success"><i class="bi bi-file-medical me-1"></i>Digital Prescription Issued</small>
                        </div>
                        <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 fs-3">
                            <i class="bi bi-prescription"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="card shadow-sm border-0 border-start border-4 border-info h-100">
                    <div class="card-body d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">Total Spent</span>
                            <h2 class="fw-bold text-info mb-0">৳@ViewBag.TotalSpent</h2>
                            <small class="text-info"><i class="bi bi-wallet2 me-1"></i>Paid for Healthcare</small>
                        </div>
                        <div class="bg-info bg-opacity-10 text-info rounded-circle p-3 fs-3">
                            <i class="bi bi-cash-stack"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Next Upcoming Appointment Banner -->
        @if (nextAppt != null)
        {
            <div class="card bg-info bg-opacity-10 border border-info shadow-sm mb-4 rounded-3">
                <div class="card-body p-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                    <div>
                        <span class="badge bg-info text-dark uppercase fw-bold mb-2">Next Upcoming Consultation</span>
                        <h4 class="fw-bold text-dark mb-1">@nextAppt.Doctor?.User?.Username (@nextAppt.Doctor?.Specialization)</h4>
                        <p class="mb-0 text-secondary">
                            <i class="bi bi-calendar3 me-1"></i><strong>@nextAppt.AppointmentDate.ToString("dd MMMM yyyy")</strong> at 
                            <i class="bi bi-clock me-1 ms-2"></i><strong>@nextAppt.AppointmentTime</strong> | 
                            Status: <span class="badge bg-primary ms-1">@nextAppt.AppointmentStatus</span>
                        </p>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#cancelModal-@nextAppt.Id">Cancel</button>
                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#qrModal-@nextAppt.Id"><i class="bi bi-qr-code me-1"></i> View Ticket QR</button>
                    </div>
                </div>
            </div>
        }

        <!-- Quick Actions Grid -->
        <div class="row g-3 mb-4">
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-lightning-charge-fill me-2 text-warning"></i>Patient Quick Actions</h5>
                    </div>
                    <div class="card-body pt-0">
                        <div class="row g-2">
                            <div class="col-md col-6">
                                <button type="button" class="btn btn-outline-primary w-100 py-3 text-center rounded-3" data-bs-toggle="modal" data-bs-target="#bookApptModal">
                                    <i class="bi bi-calendar-plus fs-3 d-block mb-1"></i> Book Visit
                                </button>
                            </div>
                            <div class="col-md col-6">
                                <a asp-controller="Patient" asp-action="Dashboard" asp-route-section="doctors" class="btn btn-outline-success w-100 py-3 text-center rounded-3">
                                    <i class="bi bi-search fs-3 d-block mb-1"></i> Search Doctor
                                </a>
                            </div>
                            <div class="col-md col-6">
                                <a asp-controller="Patient" asp-action="Dashboard" asp-route-section="documents" class="btn btn-outline-info w-100 py-3 text-center rounded-3">
                                    <i class="bi bi-cloud-upload fs-3 d-block mb-1"></i> Upload File
                                </a>
                            </div>
                            <div class="col-md col-6">
                                <a asp-controller="Patient" asp-action="Dashboard" asp-route-section="payments" class="btn btn-outline-warning text-dark w-100 py-3 text-center rounded-3">
                                    <i class="bi bi-credit-card fs-3 d-block mb-1"></i> Pay Online
                                </a>
                            </div>
                            <div class="col-md col-6">
                                <a asp-controller="Patient" asp-action="Dashboard" asp-route-section="messages" class="btn btn-outline-dark w-100 py-3 text-center rounded-3">
                                    <i class="bi bi-chat-dots fs-3 d-block mb-1"></i> Chat Doctor
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Complete EMR Medical Journey Timeline -->
        <div class="row g-4 mb-4">
            <div class="col-lg-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-bezier2 me-2 text-info"></i>Your Healthcare Journey Timeline</h5>
                            <small class="text-muted">Appointment → Diagnosis → Prescription → Lab Test → Treatment → Follow-up</small>
                        </div>
                        <a asp-controller="Patient" asp-action="Dashboard" asp-route-section="emr" class="btn btn-outline-info btn-sm rounded-pill">
                            <i class="bi bi-arrow-right-circle me-1"></i>View Full EMR
                        </a>
                    </div>
                    <div class="card-body p-4">
                        <div class="timeline position-relative">
                            @if (medicalRecords.Any())
                            {
                                int idx = 0;
                                foreach (var rec in medicalRecords.Take(5))
                                {
                                    idx++;
                                    <div class="d-flex mb-4 gap-3 align-items-start">
                                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width: 40px; height: 40px; min-width: 40px;">
                                            @idx
                                        </div>
                                        <div class="card shadow-sm border-0 w-100">
                                            <div class="card-body p-3 bg-light rounded-3">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <h6 class="fw-bold text-primary mb-0"><i class="bi bi-journal-medical me-1"></i> Diagnosis: @rec.Diagnosis</h6>
                                                    <small class="text-muted">@rec.RecordDate.ToString("dd MMM yyyy, hh:mm tt")</small>
                                                </div>
                                                <p class="mb-1 text-dark small"><strong>Doctor:</strong> @rec.Doctor?.User?.Username</p>
                                                <p class="mb-1 text-secondary small"><strong>Symptoms:</strong> @(rec.Symptoms ?? "N/A")</p>
                                                <p class="mb-0 text-secondary small"><strong>Treatment Plan:</strong> @(rec.TreatmentPlan ?? "Standard Care")</p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-4 text-muted">No medical history records available.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- SECTION 2: APPOINTMENTS MANAGEMENT -->
    @if (currentSection == "appointments")
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-calendar-check-fill me-2 text-primary"></i>My Appointments History</h5>
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#bookApptModal"><i class="bi bi-plus-circle me-1"></i> Book New Visit</button>
            </div>
            <div class="card-body p-0">
                @if (appointments.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date & Time</th>
                                    <th>Doctor</th>
                                    <th>Reason</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appt in appointments)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-primary">@appt.AppointmentDate.ToString("dd MMM yyyy")</div>
                                            <small class="text-muted">@appt.AppointmentTime</small>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark">@appt.Doctor?.User?.Username</div>
                                            <small class="text-muted">@appt.Doctor?.Specialization</small>
                                        </td>
                                        <td><small class="text-secondary">@(appt.ReasonForVisit ?? "Consultation")</small></td>
                                        <td>
                                            @if (appt.AppointmentStatus == "Confirmed")
                                            {
                                                <span class="badge bg-primary"><i class="bi bi-check-circle me-1"></i>Confirmed (Paid)</span>
                                            }
                                            else if (appt.AppointmentStatus == "Checked In")
                                            {
                                                <span class="badge bg-info text-dark"><i class="bi bi-box-arrow-in-right me-1"></i>Checked In</span>
                                            }
                                            else if (appt.AppointmentStatus == "In Consultation")
                                            {
                                                <span class="badge bg-warning text-dark"><i class="bi bi-stethoscope me-1"></i>In Consultation</span>
                                            }
                                            else if (appt.AppointmentStatus == "Completed")
                                            {
                                                <span class="badge bg-success"><i class="bi bi-check2-all me-1"></i>Completed</span>
                                            }
                                            else if (appt.AppointmentStatus == "Cancelled")
                                            {
                                                <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Cancelled (Refunded)</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@appt.AppointmentStatus</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#qrModal-@appt.Id" title="Ticket QR"><i class="bi bi-qr-code"></i> Ticket</button>
                                                <a asp-controller="Patient" asp-action="PrintInvoice" asp-route-id="@appt.Id" target="_blank" class="btn btn-outline-secondary" title="Invoice / Receipt"><i class="bi bi-receipt"></i> Bill</a>
                                                @if (appt.AppointmentStatus == "Completed")
                                                {
                                                    <button type="button" class="btn btn-outline-warning text-dark" data-bs-toggle="modal" data-bs-target="#rateDoctorModal-@appt.Id" title="Rate Doctor"><i class="bi bi-star-fill text-warning"></i> Review</button>
                                                }
                                                @if (appt.AppointmentStatus != "Cancelled" && appt.AppointmentStatus != "Completed")
                                                {
                                                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelModal-@appt.Id" title="Cancel & Refund"><i class="bi bi-x-circle"></i> Cancel</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>

                                    <!-- QR Ticket Modal -->
                                    <div class="modal fade" id="qrModal-@appt.Id" tabindex="-1">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content border-0 shadow">
                                                <div class="modal-header bg-primary text-white">
                                                    <h5 class="modal-title fw-bold"><i class="bi bi-qr-code me-2"></i>Appointment Ticket QR</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body text-center p-4">
                                                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=DAMS-APPT-@appt.Id" alt="QR Ticket" class="img-fluid border p-2 rounded mb-3" />
                                                    <h5 class="fw-bold text-dark mb-1">@appt.Doctor?.User?.Username</h5>
                                                    <p class="text-muted small mb-2">@appt.AppointmentDate.ToString("dd MMM yyyy") at @appt.AppointmentTime</p>
                                                    <span class="badge bg-success px-3 py-2 fs-6">Status: @appt.AppointmentStatus</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Rate Doctor Modal -->
                                    <div class="modal fade" id="rateDoctorModal-@appt.Id" tabindex="-1">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content border-0 shadow">
                                                <div class="modal-header bg-warning text-dark">
                                                    <h5 class="modal-title fw-bold"><i class="bi bi-star-fill me-2"></i>Rate Doctor &amp; Share Feedback</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body p-4 text-start">
                                                    <div class="d-flex align-items-center gap-3 mb-3 p-3 bg-light rounded-3">
                                                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.3rem;">
                                                            <i class="bi bi-person-badge"></i>
                                                        </div>
                                                        <div>
                                                            <h6 class="fw-bold text-dark mb-0">Dr. @appt.Doctor?.User?.Username</h6>
                                                            <small class="text-muted">@appt.Doctor?.Specialization | Appt: @appt.AppointmentDate.ToString("dd MMM yyyy")</small>
                                                        </div>
                                                    </div>
                                                    <form asp-controller="Patient" asp-action="AddDoctorReview" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="doctorId" value="@appt.DoctorId" />
                                                        
                                                        <div class="mb-3">
                                                            <label class="form-label fw-bold small text-dark">Rating <span class="text-danger">*</span></label>
                                                            <select name="rating" class="form-select" required>
                                                                <option value="5" selected>★★★★★ 5 Stars - Excellent Experience</option>
                                                                <option value="4">★★★★☆ 4 Stars - Very Good</option>
                                                                <option value="3">★★★☆☆ 3 Stars - Average</option>
                                                                <option value="2">★★☆☆☆ 2 Stars - Fair</option>
                                                                <option value="1">★☆☆☆☆ 1 Star - Poor</option>
                                                            </select>
                                                        </div>

                                                        <div class="mb-3">
                                                            <label class="form-label fw-bold small text-dark">Your Review / Comments</label>
                                                            <textarea name="comment" class="form-control" rows="3" placeholder="Share your experience regarding the doctor's consultation, punctuality, and treatment..."></textarea>
                                                        </div>

                                                        <button type="submit" class="btn btn-warning text-dark fw-bold w-100 py-2">
                                                            <i class="bi bi-send-fill me-1"></i> Submit Review
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Cancel Modal -->
                                    <div class="modal fade" id="cancelModal-@appt.Id" tabindex="-1">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content border-0 shadow">
                                                <div class="modal-header bg-danger text-white">
                                                    <h5 class="modal-title fw-bold">Cancel Appointment</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body p-4 text-center">
                                                    <p class="mb-2">Are you sure you want to cancel your appointment with <strong>@appt.Doctor?.User?.Username</strong> on <strong>@appt.AppointmentDate.ToString("dd MMM yyyy")</strong> at <strong>@appt.AppointmentTime</strong>?</p>
                                                    <div class="alert alert-info py-2 small mb-3 text-start">
                                                        <i class="bi bi-info-circle-fill me-1"></i> <strong>Refund Guarantee:</strong> Any fee you paid online will be 100% refunded automatically to your payment account.
                                                    </div>
                                                    <form asp-controller="Patient" asp-action="CancelAppointment" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@appt.Id" />
                                                        <button type="submit" class="btn btn-danger w-100">Yes, Cancel & Refund</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-5 text-center text-muted">No appointments found. Click "Book New Visit" to schedule one.</div>
                }
            </div>
        </div>
    }

    <!-- SECTION 3: DOCTOR SEARCH & DIRECTORY -->
    @if (currentSection == "doctors")
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-search me-2 text-primary"></i>Find & Book Specialist Doctor</h5>
            </div>
            <div class="card-body">
                <form asp-controller="Patient" asp-action="Dashboard" method="get" class="row g-2 mb-4">
                    <input type="hidden" name="section" value="doctors" />
                    <div class="col-md-4">
                        <input type="text" name="search" class="form-control" placeholder="Search doctor by name or spec..." value="@Context.Request.Query["search"]" />
                    </div>
                    <div class="col-md-3">
                        <select name="specFilter" class="form-select">
                            <option value="">All Specializations</option>
                            @if (ViewBag.Specializations != null)
                            {
                                foreach (var spec in (List<string>)ViewBag.Specializations)
                                {
                                    <option value="@spec">@spec</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <input type="number" name="maxFee" class="form-control" placeholder="Max Fee (৳)" value="@Context.Request.Query["maxFee"]" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter me-1"></i> Filter</button>
                    </div>
                </form>

                <div class="row g-3">
                    @if (doctors.Any())
                    {
                        foreach (var doc in doctors)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="card shadow-sm border-0 h-100 rounded-3 overflow-hidden">
                                    <div class="card-body p-4 text-center">
                                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary mx-auto d-flex align-items-center justify-content-center fw-bold fs-3 mb-3 flex-shrink-0" style="width: 70px; height: 70px;">
                                            @(doc.User?.Username?.Substring(0,1).ToUpper() ?? "D")
                                        </div>
                                        <h5 class="fw-bold text-dark mb-1">@doc.User?.Username</h5>
                                        <p class="badge bg-primary me-1">@doc.Specialization</p>
                                        <p class="text-muted small mb-2">@doc.Qualification | Exp: @doc.Experience Years</p>
                                        <h4 class="fw-bold text-success mb-3">৳@doc.ConsultationFee <small class="text-muted fs-6">/ Fee</small></h4>
                                        <a asp-controller="Patient" asp-action="DoctorProfile" asp-route-id="@doc.Id" class="btn btn-outline-primary btn-sm w-100">
                                            <i class="bi bi-person-lines-fill me-1"></i> View More
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }

    <!-- SECTION 4: PRESCRIPTIONS -->
    @if (currentSection == "prescriptions")
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-prescription me-2 text-success"></i>My Prescriptions</h5>
            </div>
            <div class="card-body p-0">
                @if (prescriptions.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Doctor</th>
                                    <th>Diagnosis</th>
                                    <th>Medicines</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rx in prescriptions)
                                {
                                    <tr>
                                        <td class="fw-bold text-primary">@rx.PrescriptionDateTime.ToString("dd MMM yyyy")</td>
                                        <td>@rx.Doctor?.User?.Username</td>
                                        <td>@rx.Diagnosis</td>
                                        <td><small class="text-secondary">@rx.Medicines</small></td>
                                        <td class="text-end">
                                            <a asp-controller="Doctor" asp-action="PrintPrescription" asp-route-id="@rx.Id" target="_blank" class="btn btn-outline-primary btn-sm"><i class="bi bi-printer me-1"></i> Print Prescription</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-5 text-center text-muted">No digital prescriptions found.</div>
                }
            </div>
        </div>
    }

    <!-- SECTION 5: MEDICAL DOCUMENTS UPLOAD -->
    @if (currentSection == "documents")
    {
        <div class="row g-4 mb-4">
            <div class="col-lg-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-cloud-upload me-2 text-info"></i>Upload Medical Record</h5>
                    </div>
                    <div class="card-body p-4">
                        <form asp-controller="Patient" asp-action="UploadMedicalDocument" method="post" enctype="multipart/form-data">
                            <div class="mb-3">
                                <label class="form-label font-weight-bold">Document Name</label>
                                <input type="text" name="documentName" class="form-control" placeholder="e.g. Chest X-Ray Report" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label font-weight-bold">Document Type</label>
                                <select name="documentType" class="form-select" required>
                                    <option value="X-Ray">X-Ray</option>
                                    <option value="MRI">MRI</option>
                                    <option value="CT Scan">CT Scan</option>
                                    <option value="Blood Report">Blood Report</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label font-weight-bold">Select File</label>
                                <input type="file" name="file" class="form-control" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label font-weight-bold">Notes</label>
                                <textarea name="notes" class="form-control" rows="2"></textarea>
                            </div>
                            <button type="submit" class="btn btn-info text-white w-100">Upload File</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-folder-fill me-2 text-primary"></i>Uploaded Medical Records & Reports</h5>
                    </div>
                    <div class="card-body p-0">
                        @if (medicalDocuments.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>File Name</th>
                                            <th>Type</th>
                                            <th>Upload Date</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var doc in medicalDocuments)
                                        {
                                            <tr>
                                                <td class="fw-bold text-dark">@doc.DocumentName</td>
                                                <td><span class="badge bg-info text-dark">@doc.DocumentType</span></td>
                                                <td class="text-muted small">@doc.UploadDate.ToString("dd MMM yyyy")</td>
                                                <td class="text-end">
                                                    <a href="@doc.FilePath" download class="btn btn-outline-primary btn-sm me-1"><i class="bi bi-download"></i> Download</a>
                                                    <form asp-controller="Patient" asp-action="DeleteMedicalDocument" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@doc.Id" />
                                                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete file?')"><i class="bi bi-trash"></i></button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="p-5 text-center text-muted">No uploaded documents. Upload X-Ray, MRI or Blood reports using the form on the left.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- SECTION 6: INVOICES & PAYMENTS -->
    @if (currentSection == "invoices" || currentSection == "payments")
    {
        <div class="row g-4 mb-4">
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-0 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                        <div>
                            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-receipt me-2 text-primary"></i>Your Consultation Invoices &amp; Payment Receipts</h5>
                            <small class="text-muted">Itemized breakdown of Doctor Consultation Fees, Hospital Ticket Fees, and Payment Proofs</small>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-success px-3 py-2 fs-6">Total Spent: ৳ @ViewBag.TotalSpent</span>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        @if (invoices.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Invoice #</th>
                                            <th>Doctor &amp; Consultation</th>
                                            <th>Appointment Date</th>
                                            <th>Generated On</th>
                                            <th>Amount Breakdown</th>
                                            <th>Status</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var inv in invoices)
                                        {
                                            <tr>
                                                <td class="fw-bold text-primary">#INV-@inv.Id</td>
                                                <td>
                                                    <div class="fw-bold text-dark">@(inv.Appointment?.Doctor?.User?.Username != null ? "Dr. " + inv.Appointment.Doctor.User.Username : "Doctor Consultation")</div>
                                                    <div class="text-muted small">@(inv.Particulars ?? "Consultation Fee + Ticket Fee")</div>
                                                </td>
                                                <td>@(inv.Appointment != null ? inv.Appointment.AppointmentDate.ToString("dd MMM yyyy") : "N/A")</td>
                                                <td class="text-muted small">@inv.IssueDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                                <td>
                                                    <span class="fw-bold text-dark fs-6">৳ @inv.TotalAmount</span>
                                                </td>
                                                <td>
                                                    <span class="badge @(inv.Status == "Paid" ? "bg-success" : "bg-warning text-dark") px-2.5 py-1.5">
                                                        <i class="bi bi-check-circle-fill me-1"></i>@inv.Status
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <a asp-controller="Patient" asp-action="PrintInvoice" asp-route-id="@inv.Id" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill">
                                                        <i class="bi bi-printer me-1"></i>Print Invoice / PDF
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="p-5 text-center text-muted">
                                <i class="bi bi-receipt-cutoff fs-1 d-block mb-3 text-secondary"></i>
                                <h5>No invoices found</h5>
                                <p class="small">When your appointments are booked and completed by the doctor, your invoices and payment receipts with ticket charges will appear here.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- SECTION 7: MEDICAL JOURNEY & EMR (ELECTRONIC MEDICAL RECORDS) -->
    @if (currentSection == "emr")
    {
        <div class="row g-4 mb-4">
            <!-- Patient Health Profile Baseline Card -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold text-dark mb-0"><i class="bi bi-person-badge-fill me-2 text-primary"></i>Clinical Health Baseline</h6>
                        <a asp-controller="Patient" asp-action="Dashboard" asp-route-section="profile" class="btn btn-sm btn-outline-primary rounded-pill">
                            <i class="bi bi-pencil-square me-1"></i>Edit
                        </a>
                    </div>
                    <div class="card-body">
                        <div class="mb-3 text-center p-3 bg-light rounded-3">
                            <div class="fw-bold text-dark fs-5">@patientName</div>
                            <small class="text-muted">Age: @ViewBag.Age yrs | Gender: @ViewBag.Gender</small>
                            <div class="mt-2">
                                <span class="badge bg-danger px-3 py-1.5 fs-6"><i class="bi bi-droplet-fill me-1"></i>Blood Group: @(ViewBag.BloodGroup ?? "Not Set")</span>
                            </div>
                        </div>

                        <ul class="list-group list-group-flush small">
                            <li class="list-group-item px-0 py-2.5 d-flex justify-content-between">
                                <span class="text-muted"><i class="bi bi-telephone-fill me-1 text-danger"></i>Emergency Contact:</span>
                                <strong class="text-dark">@(patient?.EmergencyContact ?? "Not Specified")</strong>
                            </li>
                            <li class="list-group-item px-0 py-2.5">
                                <span class="text-muted d-block mb-1"><i class="bi bi-exclamation-octagon-fill me-1 text-warning"></i>Known Allergies:</span>
                                @if (!string.IsNullOrWhiteSpace(patient?.Allergies))
                                {
                                    <span class="badge bg-warning text-dark px-2 py-1">@patient.Allergies</span>
                                }
                                else
                                {
                                    <span class="text-secondary">No known drug/food allergies reported.</span>
                                }
                            </li>
                            <li class="list-group-item px-0 py-2.5">
                                <span class="text-muted d-block mb-1"><i class="bi bi-heart-pulse-fill me-1 text-info"></i>Chronic Diseases:</span>
                                @if (!string.IsNullOrWhiteSpace(patient?.ChronicDiseases))
                                {
                                    <span class="badge bg-info text-white px-2 py-1">@patient.ChronicDiseases</span>
                                }
                                else
                                {
                                    <span class="text-secondary">None reported.</span>
                                }
                            </li>
                            <li class="list-group-item px-0 py-2.5">
                                <span class="text-muted d-block mb-1"><i class="bi bi-file-medical-fill me-1 text-primary"></i>Medical History:</span>
                                <span class="text-dark">@(patient?.MedicalHistory ?? "No prior medical history records.")</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- EMR Journey Timeline -->
            <div class="col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-journal-medical me-2 text-primary"></i>Electronic Medical Records (EMR) Timeline</h5>
                            <small class="text-muted">Chronological consultation history, diagnosis, treatment plans and doctor clinical notes</small>
                        </div>
                        <span class="badge bg-primary rounded-pill px-3 py-2">@medicalRecords.Count Records</span>
                    </div>
                    <div class="card-body p-4">
                        @if (medicalRecords.Any())
                        {
                            <div class="timeline position-relative">
                                @foreach (var rec in medicalRecords)
                                {
                                    <div class="card shadow-sm border-0 mb-3 border-start border-4 border-primary">
                                        <div class="card-body p-3 bg-light rounded-end">
                                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-1 mb-2">
                                                <h6 class="fw-bold text-primary mb-0">
                                                    <i class="bi bi-clipboard-pulse me-1"></i>Diagnosis: @rec.Diagnosis
                                                </h6>
                                                <span class="badge bg-secondary">
                                                    <i class="bi bi-clock me-1"></i>@rec.RecordDate.ToString("dd MMM yyyy, hh:mm tt")
                                                </span>
                                            </div>

                                            <div class="mb-2 small">
                                                <strong class="text-dark">Attending Specialist:</strong>
                                                <span class="text-primary fw-bold">Dr. @(rec.Doctor?.User?.Username ?? "Assigned Doctor")</span>
                                                <span class="text-muted">(@(rec.Doctor?.Specialization ?? "General Physician"))</span>
                                            </div>

                                            <div class="row g-2 mb-2 small">
                                                @if (!string.IsNullOrWhiteSpace(rec.Symptoms))
                                                {
                                                    <div class="col-md-6">
                                                        <div class="p-2 bg-white rounded border">
                                                            <strong class="text-muted d-block">Symptoms Presented:</strong>
                                                            <span class="text-dark">@rec.Symptoms</span>
                                                        </div>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(rec.VitalSigns))
                                                {
                                                    <div class="col-md-6">
                                                        <div class="p-2 bg-white rounded border">
                                                            <strong class="text-muted d-block">Vitals (BP/Pulse/Temp):</strong>
                                                            <span class="text-info fw-bold">@rec.VitalSigns</span>
                                                        </div>
                                                    </div>
                                                }
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(rec.TreatmentPlan) || !string.IsNullOrWhiteSpace(rec.TreatmentDetails))
                                            {
                                                <div class="p-2.5 bg-white rounded border mb-2 small">
                                                    <strong class="text-success d-block"><i class="bi bi-check2-circle me-1"></i>Treatment &amp; Clinical Management:</strong>
                                                    <p class="mb-1 text-dark">@(rec.TreatmentPlan ?? "Prescribed Clinical Care")</p>
                                                    @if (!string.IsNullOrWhiteSpace(rec.TreatmentDetails))
                                                    {
                                                        <small class="text-muted">@rec.TreatmentDetails</small>
                                                    }
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(rec.FollowUpNotes) || !string.IsNullOrWhiteSpace(rec.Notes))
                                            {
                                                <div class="text-muted small mb-2">
                                                    <strong>Follow-up &amp; Notes:</strong> @(rec.FollowUpNotes ?? rec.Notes)
                                                </div>
                                            }

                                            <div class="d-flex justify-content-end gap-2 mt-2 pt-2 border-top">
                                                <a asp-controller="Patient" asp-action="Dashboard" asp-route-section="prescriptions" class="btn btn-outline-primary btn-sm rounded-pill">
                                                    <i class="bi bi-prescription me-1"></i>View Prescriptions
                                                </a>
                                                <a asp-controller="Patient" asp-action="Dashboard" asp-route-section="lab" class="btn btn-outline-warning text-dark btn-sm rounded-pill">
                                                    <i class="bi bi-droplet me-1"></i>Lab Reports
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-5 text-center text-muted">
                                <i class="bi bi-journal-medical fs-1 d-block mb-3 text-secondary"></i>
                                <h5>No Medical Records Found</h5>
                                <p class="small">When your attending doctor completes a consultation visit and records your clinical assessment, diagnosis and vitals, your digital EMR history will appear right here.</p>
                                <button type="button" class="btn btn-primary btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#bookApptModal">
                                    <i class="bi bi-calendar-plus me-1"></i> Book a Doctor Visit
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- SECTION 8: LABORATORY REPORTS & DIAGNOSTIC TESTS -->
    @if (currentSection == "lab")
    {
        <div class="row g-4 mb-4">
            <!-- Lab Reports Table -->
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-droplet-fill me-2 text-warning"></i>Diagnostic Lab Reports</h5>
                            <small class="text-muted">Pathology, biochemistry, hematology, and diagnostic test results</small>
                        </div>
                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2">@labReports.Count Reports</span>
                    </div>
                    <div class="card-body p-0">
                        @if (labReports.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Test Name</th>
                                            <th>Status / Result</th>
                                            <th>Remarks</th>
                                            <th class="text-end">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var lr in labReports)
                                        {
                                            <tr>
                                                <td class="text-nowrap small text-muted">@lr.ReportDate.ToString("dd MMM yyyy")</td>
                                                <td>
                                                    <div class="fw-bold text-dark">@(lr.LabTest?.TestName ?? "Clinical Diagnostic Test")</div>
                                                    @if (lr.LabTest != null && lr.LabTest.Price > 0)
                                                    {
                                                        <small class="text-muted">Standard Fee: ৳ @lr.LabTest.Price</small>
                                                    }
                                                </td>
                                                <td>
                                                    @if (lr.Result == "Pending" || string.IsNullOrWhiteSpace(lr.Result))
                                                    {
                                                        <span class="badge bg-warning text-dark px-2.5 py-1.5"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success px-2.5 py-1.5"><i class="bi bi-check-circle-fill me-1"></i>@lr.Result</span>
                                                    }
                                                </td>
                                                <td class="small text-secondary">
                                                    @(string.IsNullOrWhiteSpace(lr.Remarks) ? "Routine clinical findings." : lr.Remarks)
                                                </td>
                                                <td class="text-end">
                                                    <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" onclick="window.print()">
                                                        <i class="bi bi-printer me-1"></i>Print
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="p-5 text-center text-muted">
                                <i class="bi bi-droplet-half fs-1 d-block mb-3 text-secondary"></i>
                                <h5>No Lab Reports Available</h5>
                                <p class="small">When your consulting doctor orders diagnostic lab tests (blood work, urine analysis, lipid profile, etc.) or when hospital technicians publish your test outcomes, they will be archived here.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Available Hospital Lab Tests Directory -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3 border-0">
                        <h6 class="fw-bold text-dark mb-0"><i class="bi bi-hospital me-2 text-primary"></i>Hospital Diagnostic Test Catalog</h6>
                        <small class="text-muted">Available hospital laboratory services and charges</small>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush small" style="max-height: 480px; overflow-y: auto;">
                            @if (allLabTests.Any())
                            {
                                @foreach (var test in allLabTests)
                                {
                                    <div class="list-group-item p-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <strong class="text-dark">@test.TestName</strong>
                                            <span class="badge bg-success">৳ @test.Price</span>
                                        </div>
                                        <small class="text-muted d-block">@(test.Description ?? "Certified pathological and clinical assessment test.")</small>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="p-4 text-center text-muted">No diagnostic catalog tests registered currently.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- SECTION 9: HEALTH INSURANCE & COVERAGE -->
    @if (currentSection == "insurance")
    {
        <div class="row g-4 mb-4">
            <!-- Active Insurance Policy Card -->
            <div class="col-lg-5">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-shield-check me-2 text-success"></i>Health Insurance Policy</h5>
                    </div>
                    <div class="card-body">
                        @if (insurance != null)
                        {
                            bool isExpired = insurance.ExpiryDate.Date < DateTime.Today;
                            <div class="p-4 rounded-3 text-white mb-3 shadow-sm" style="background: linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%);">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="fw-bold fs-5"><i class="bi bi-shield-fill-plus me-2"></i>@insurance.ProviderName</span>
                                    <span class="badge @(isExpired ? "bg-danger" : "bg-success") px-2.5 py-1.5">
                                        @(isExpired ? "Expired" : insurance.Status)
                                    </span>
                                </div>
                                <div class="mb-3">
                                    <small class="text-white-50 d-block">POLICY NUMBER</small>
                                    <div class="fs-4 fw-bold font-monospace letter-spacing-1">@insurance.PolicyNumber</div>
                                </div>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <small class="text-white-50 d-block">POLICY HOLDER</small>
                                        <div class="fw-bold">@patientName</div>
                                    </div>
                                    <div class="col-6 text-end">
                                        <small class="text-white-50 d-block">EXPIRY DATE</small>
                                        <div class="fw-bold">@insurance.ExpiryDate.ToString("dd MMM yyyy")</div>
                                    </div>
                                </div>
                            </div>

                            <div class="card bg-light border-0 p-3 mb-3">
                                <h6 class="fw-bold text-dark mb-1"><i class="bi bi-file-earmark-text me-1 text-primary"></i>Coverage Specifications</h6>
                                <p class="mb-0 text-muted small">
                                    @(insurance.CoverageDetails ?? "Inpatient hospitalization, specialist consultation co-pay, and routine diagnostics coverage.")
                                </p>
                            </div>

                            @if (isExpired)
                            {
                                <div class="alert alert-danger py-2 small mb-0">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>Your policy has expired. Please submit an updated policy renewal below.
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-success py-2 small mb-0">
                                    <i class="bi bi-check-circle-fill me-1"></i>Your insurance policy is active and valid for consultation billing deductions.
                                </div>
                            }
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted bg-light rounded-3">
                                <i class="bi bi-shield-slash fs-1 d-block mb-3 text-secondary"></i>
                                <h6>No Active Insurance Registered</h6>
                                <p class="small">Add your corporate or personal health insurance provider to enable cashless claims and verified insurance copay benefits.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Add / Update Insurance Policy Form -->
            <div class="col-lg-7">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-pencil-square me-2 text-primary"></i>@(insurance != null ? "Update Insurance Details" : "Register Insurance Policy")</h5>
                        <small class="text-muted">Enter policy identification details provided by your health insurance underwriter</small>
                    </div>
                    <div class="card-body p-4">
                        <form asp-controller="Patient" asp-action="SaveInsuranceInfo" method="post">
                            @Html.AntiForgeryToken()

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-dark">Insurance Provider Company <span class="text-danger">*</span></label>
                                    <input type="text" name="providerName" class="form-control" placeholder="e.g. MetLife Bangladesh, Green Delta, Pragati Life" value="@(insurance?.ProviderName)" required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-dark">Policy / Member Certificate Number <span class="text-danger">*</span></label>
                                    <input type="text" name="policyNumber" class="form-control" placeholder="e.g. POL-894721-BD" value="@(insurance?.PolicyNumber)" required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-dark">Policy Expiry Date <span class="text-danger">*</span></label>
                                    <input type="date" name="expiryDate" class="form-control" value="@(insurance?.ExpiryDate.ToString("yyyy-MM-dd") ?? DateTime.Today.AddYears(1).ToString("yyyy-MM-dd"))" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-dark">Patient / Policy Holder Name</label>
                                    <input type="text" class="form-control bg-light" value="@patientName" readonly />
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-bold small text-dark">Coverage Scope &amp; Copay Details</label>
                                    <textarea name="coverageDetails" class="form-control" rows="3" placeholder="e.g., 80% OPD doctor consultation fees coverage, up to ৳50,000 annual limit...">@(insurance?.CoverageDetails)</textarea>
                                </div>

                                <div class="col-12 text-end mt-4">
                                    <button type="submit" class="btn btn-primary px-4 py-2 fw-bold">
                                        <i class="bi bi-check2-circle me-1"></i>Save Insurance Information
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- SECTION 10: DOCTOR CONSULTATION MESSAGES & CHAT -->
    @if (currentSection == "messages")
    {
        <div class="row g-4 mb-4">
            <!-- Doctor Contacts List -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold text-dark mb-0"><i class="bi bi-chat-left-dots-fill me-2 text-primary"></i>Doctor Conversations</h6>
                        <span class="badge bg-primary rounded-pill">@doctors.Count Doctors</span>
                    </div>
                    <div class="list-group list-group-flush" style="max-height: 520px; overflow-y: auto;">
                        @if (doctors.Any())
                        {
                            @foreach (var doc in doctors)
                            {
                                bool isSelected = (selectedDoctorUserId == doc.UserId);
                                <a asp-controller="Patient" asp-action="Dashboard" asp-route-section="messages" asp-route-doctorUserId="@doc.UserId"
                                   class="list-group-item list-group-item-action p-3 @(isSelected ? "active border-primary" : "")">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle @(isSelected ? "bg-white text-primary" : "bg-primary text-white") fw-bold d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px; font-size: 1.1rem;">
                                            @(!string.IsNullOrEmpty(doc.User?.Username) ? doc.User.Username.Substring(0, 1).ToUpper() : "D")
                                        </div>
                                        <div class="flex-grow-1 overflow-hidden">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <h6 class="fw-bold mb-0 text-truncate @(isSelected ? "text-white" : "text-dark")">Dr. @doc.User?.Username</h6>
                                                <span class="badge @(isSelected ? "bg-light text-dark" : "bg-success") rounded-pill ms-1" style="font-size: 0.65rem;">Active</span>
                                            </div>
                                            <small class="@(isSelected ? "text-white-50" : "text-muted") d-block text-truncate">@doc.Specialization</small>
                                            <small class="@(isSelected ? "text-white-50" : "text-secondary")">Fee: ৳@doc.ConsultationFee</small>
                                        </div>
                                    </div>
                                </a>
                            }
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted">No doctors available for messaging.</div>
                        }
                    </div>
                </div>
            </div>

            <!-- Active Chat Window -->
            <div class="col-lg-8">
                @{
                    var activeDoctor = doctors.FirstOrDefault(d => d.UserId == selectedDoctorUserId) ?? doctors.FirstOrDefault();
                }
                <div class="card shadow-sm border-0 h-100 d-flex flex-column">
                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-success text-white fw-bold d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                @(!string.IsNullOrEmpty(activeDoctor?.User?.Username) ? activeDoctor.User.Username.Substring(0, 1).ToUpper() : "D")
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-0">Dr. @(activeDoctor?.User?.Username ?? "Specialist")</h6>
                                <small class="text-muted">@(activeDoctor?.Specialization ?? "Consultant") | Hospital Consultation Channel</small>
                            </div>
                        </div>
                        @if (activeDoctor != null)
                        {
                            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#bookApptModal">
                                <i class="bi bi-calendar-plus me-1"></i>Book Visit
                            </button>
                        }
                    </div>

                    <!-- Chat Bubble Stream -->
                    <div class="card-body bg-light overflow-y-auto p-4 flex-grow-1" style="min-height: 380px; max-height: 440px;" id="chatStream">
                        @if (chatMessages != null && chatMessages.Any())
                        {
                            @foreach (var msg in chatMessages)
                            {
                                bool isMe = (patient != null && msg.SenderUserId == patient.UserId);
                                <div class="d-flex mb-3 @(isMe ? "justify-content-end" : "justify-content-start")">
                                    <div class="p-3 rounded-3 shadow-sm @(isMe ? "bg-primary text-white" : "bg-white text-dark")" style="max-width: 75%;">
                                        <div class="small fw-bold mb-1 @(isMe ? "text-white-50" : "text-muted")">
                                            @(isMe ? "You" : ("Dr. " + (msg.SenderUser?.Username ?? "Doctor")))
                                        </div>
                                        <p class="mb-1 text-break">@msg.Message</p>
                                        <div class="text-end @(isMe ? "text-white-50" : "text-muted")" style="font-size: 0.72rem;">
                                            @msg.SentAt.ToString("hh:mm tt")
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="p-5 text-center text-muted">
                                <i class="bi bi-chat-text fs-1 d-block mb-2 text-secondary"></i>
                                <h6>No previous messages with this doctor</h6>
                                <p class="small">Ask doctor queries regarding your prescriptions, treatment instructions, or post-appointment health questions.</p>
                            </div>
                        }
                    </div>

                    <!-- Chat Input Form -->
                    <div class="card-footer bg-white border-0 p-3">
                        @if (activeDoctor != null)
                        {
                            <form asp-controller="Patient" asp-action="SendChatMessage" method="post" class="d-flex gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="doctorUserId" value="@activeDoctor.UserId" />
                                <input type="text" name="message" class="form-control" placeholder="Type your message or query to Dr. @activeDoctor.User?.Username..." autocomplete="off" required />
                                <button type="submit" class="btn btn-primary px-4 fw-bold">
                                    <i class="bi bi-send-fill me-1"></i> Send
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="text-center text-muted small py-2">Please select a doctor from the left to start messaging.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- SECTION 11: DOCTOR REVIEWS & RATINGS -->
    @if (currentSection == "reviews")
    {
        <div class="row g-4 mb-4">
            <!-- Add New Review Form -->
            <div class="col-lg-5">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-star-fill me-2 text-warning"></i>Write Doctor Review</h5>
                        <small class="text-muted">Share your consultation experience to help improve healthcare quality</small>
                    </div>
                    <div class="card-body p-4">
                        <form asp-controller="Patient" asp-action="AddDoctorReview" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label class="form-label fw-bold small text-dark">Select Doctor Visited <span class="text-danger">*</span></label>
                                <select name="doctorId" class="form-select" required>
                                    <option value="">-- Choose Specialist Doctor --</option>
                                    @foreach (var doc in doctors)
                                    {
                                        <option value="@doc.Id">Dr. @doc.User?.Username (@doc.Specialization)</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold small text-dark">Consultation Rating <span class="text-danger">*</span></label>
                                <select name="rating" class="form-select" required>
                                    <option value="5">★★★★★ 5 Stars - Excellent Experience</option>
                                    <option value="4">★★★★☆ 4 Stars - Very Good</option>
                                    <option value="3">★★★☆☆ 3 Stars - Average Service</option>
                                    <option value="2">★★☆☆☆ 2 Stars - Below Expectations</option>
                                    <option value="1">★☆☆☆☆ 1 Star - Unsatisfactory</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold small text-dark">Detailed Feedback &amp; Comments</label>
                                <textarea name="comment" class="form-control" rows="4" placeholder="Describe the doctor's attentiveness, diagnosis clarity, wait time and hospital staff behaviour..."></textarea>
                            </div>

                            <button type="submit" class="btn btn-warning text-dark fw-bold w-100 py-2.5">
                                <i class="bi bi-star me-1"></i> Submit Doctor Review
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Review History -->
            <div class="col-lg-7">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-chat-quote-fill me-2 text-primary"></i>My Submitted Reviews</h5>
                            <small class="text-muted">Your genuine reviews and ratings across completed visits</small>
                        </div>
                        <span class="badge bg-primary rounded-pill px-3 py-2">@reviews.Count Reviews</span>
                    </div>
                    <div class="card-body p-0">
                        @if (reviews.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var r in reviews)
                                {
                                    <div class="list-group-item p-4">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div>
                                                <h6 class="fw-bold text-dark mb-0">Dr. @(r.Doctor?.User?.Username ?? "Doctor")</h6>
                                                <small class="text-muted">@(r.Doctor?.Specialization ?? "Specialist")</small>
                                            </div>
                                            <div class="text-end">
                                                <div class="text-warning fs-6">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        if (i <= r.Rating)
                                                        { <i class="bi bi-star-fill"></i> }
                                                        else
                                                        { <i class="bi bi-star"></i> }
                                                    }
                                                </div>
                                                <small class="text-muted">@r.FeedbackDateTime.ToString("dd MMM yyyy")</small>
                                            </div>
                                        </div>
                                        <p class="mb-0 text-secondary small bg-light p-3 rounded-3">
                                            @(string.IsNullOrWhiteSpace(r.Comment) ? "No detailed written comment provided." : r.Comment)
                                        </p>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-5 text-center text-muted">
                                <i class="bi bi-star-half fs-1 d-block mb-3 text-secondary"></i>
                                <h5>No Reviews Submitted Yet</h5>
                                <p class="small">Use the form on the left to submit your honest review and star rating for doctors you have consulted.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- SECTION 12: PATIENT PROFILE SETTINGS -->
    @if (currentSection == "profile")
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-person-circle me-2 text-primary"></i>Patient Profile &amp; Medical Details</h5>
                <small class="text-muted">Manage your personal information, emergency contacts, and vital medical history records</small>
            </div>
            <div class="card-body p-4">
                <form asp-controller="Patient" asp-action="UpdateProfile" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-4">
                        <!-- Personal Details -->
                        <div class="col-12">
                            <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                                <i class="bi bi-info-circle me-1"></i> 1. Personal &amp; Account Details
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-dark">Full Name <span class="text-danger">*</span></label>
                                    <input type="text" name="username" class="form-control" value="@patientName" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-dark">Email Address (Account ID)</label>
                                    <input type="email" class="form-control bg-light" value="@ViewBag.Email" readonly />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-dark">Phone Number <span class="text-danger">*</span></label>
                                    <input type="tel" name="phoneNumber" class="form-control" value="@(patient?.User?.PhoneNumber ?? "")" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-dark">Gender <span class="text-danger">*</span></label>
                                    <select name="gender" class="form-select" required>
                                        <option value="Male" selected="@(patient?.Gender == "Male")">Male</option>
                                        <option value="Female" selected="@(patient?.Gender == "Female")">Female</option>
                                        <option value="Other" selected="@(patient?.Gender == "Other")">Other</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-dark">Date of Birth</label>
                                    <input type="date" name="dateOfBirth" class="form-control" value="@(patient?.DateOfBirth != DateTime.MinValue ? patient?.DateOfBirth.ToString("yyyy-MM-dd") : "")" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold small text-dark">Blood Group</label>
                                    <select name="bloodGroup" class="form-select">
                                        <option value="">-- Select Blood Group --</option>
                                        <option value="A+" selected="@(patient?.BloodGroup == "A+")">A+ (Positive)</option>
                                        <option value="A-" selected="@(patient?.BloodGroup == "A-")">A- (Negative)</option>
                                        <option value="B+" selected="@(patient?.BloodGroup == "B+")">B+ (Positive)</option>
                                        <option value="B-" selected="@(patient?.BloodGroup == "B-")">B- (Negative)</option>
                                        <option value="AB+" selected="@(patient?.BloodGroup == "AB+")">AB+ (Positive)</option>
                                        <option value="AB-" selected="@(patient?.BloodGroup == "AB-")">AB- (Negative)</option>
                                        <option value="O+" selected="@(patient?.BloodGroup == "O+")">O+ (Positive)</option>
                                        <option value="O-" selected="@(patient?.BloodGroup == "O-")">O- (Negative)</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-bold small text-dark">Present Residential Address</label>
                                    <textarea name="address" class="form-control" rows="2" placeholder="House/Apartment, Street, Area, City...">@(patient?.Address)</textarea>
                                </div>
                            </div>
                        </div>

                        <!-- Emergency & Clinical Baseline -->
                        <div class="col-12">
                            <h6 class="fw-bold text-danger border-bottom pb-2 mb-3">
                                <i class="bi bi-shield-exclamation me-1"></i> 2. Emergency Contacts &amp; Medical Health Profile
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-dark">Emergency Contact Person &amp; Phone Number</label>
                                    <input type="text" name="emergencyContact" class="form-control" placeholder="e.g. Spouse/Parent: +880 1711-XXXXXX" value="@(patient?.EmergencyContact)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-dark">Known Drug &amp; Food Allergies</label>
                                    <input type="text" name="allergies" class="form-control" placeholder="e.g. Penicillin, Peanuts, Aspirin, Pollen (or 'None')" value="@(patient?.Allergies)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-dark">Chronic Diseases &amp; Pre-existing Conditions</label>
                                    <textarea name="chronicDiseases" class="form-control" rows="2" placeholder="e.g. Type 2 Diabetes, Hypertension, Asthma, Cardiac issues...">@(patient?.ChronicDiseases)</textarea>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-dark">Past Medical History &amp; Previous Surgeries</label>
                                    <textarea name="medicalHistory" class="form-control" rows="2" placeholder="e.g. Appendectomy in 2021, Knee surgery, Gallstones...">@(patient?.MedicalHistory)</textarea>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 text-end pt-3">
                            <button type="submit" class="btn btn-primary px-5 py-2.5 fw-bold shadow-sm">
                                <i class="bi bi-save me-1"></i> Save Profile Changes
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

<!-- GLOBAL MODAL: BOOK APPOINTMENT -->
<div class="modal fade" id="bookApptModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-calendar-plus me-2"></i>Book New Appointment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form method="get" action="/Appointment/SelectTime">
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Select Specialist Doctor</label>
                        <select name="doctorId" class="form-select" required>
                            @foreach (var doc in doctors)
                            {
                                <option value="@doc.Id">@doc.User?.Username (@doc.Specialization) - Fee: ৳@doc.ConsultationFee</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Appointment Date</label>
                        <input type="date" name="date" class="form-control" required value="@DateTime.Today.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Reason for Visit</label>
                        <textarea name="reason" class="form-control" rows="2" placeholder="State your symptoms or consultation reason..."></textarea>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="isEmergency" value="true" id="emergencyCheck">
                        <label class="form-check-label text-danger font-weight-bold" for="emergencyCheck">
                            Mark as Emergency Request
                        </label>
                    </div>
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i>A hospital ticket &amp; booking fee of <strong>৳50</strong> will be charged with the consultation fee upon checkout.
                    </div>
                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2.5">
                        <i class="bi bi-credit-card me-1"></i> Proceed to Time Slot &amp; Payment (50৳ Ticket Fee)
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
