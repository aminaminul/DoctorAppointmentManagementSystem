@* Razor View: Patient/Dashboard Redesign using ASP.NET Core Tag Helpers *@
@model List<DoctorAppointmentManagementSystem.Models.Appointment>
@using DoctorAppointmentManagementSystem.Models

@{
    Layout = "_Layout";
    ViewData["Title"] = "Patient Portal & Dashboard";
    string currentSection = (ViewBag.Section as string ?? "overview").ToLowerInvariant();
    var patient = ViewBag.Patient as Patient;
    var nextAppt = ViewBag.NextAppointment as Appointment;
    var appointments = ViewBag.Appointments as List<Appointment> ?? new List<Appointment>();
    var upcomingAppts = ViewBag.UpcomingAppointmentsList as List<Appointment> ?? new List<Appointment>();
    var prescriptions = ViewBag.Prescriptions as List<Prescription> ?? new List<Prescription>();
    var medicalRecords = ViewBag.MedicalRecords as List<MedicalRecord> ?? new List<MedicalRecord>();
    var labReports = ViewBag.LabReports as List<LabReport> ?? new List<LabReport>();
    var medicalDocuments = ViewBag.MedicalDocuments as List<MedicalDocument> ?? new List<MedicalDocument>();
    var familyMembers = ViewBag.FamilyMembers as List<FamilyMember> ?? new List<FamilyMember>();
    var insurance = ViewBag.Insurance as InsuranceInfo;
    var doctors = ViewBag.Doctors as List<Doctor> ?? new List<Doctor>();
    var payments = ViewBag.Payments as List<Payment> ?? new List<Payment>();
    var invoices = ViewBag.Invoices as List<Invoice> ?? new List<Invoice>();
    var notifications = ViewBag.Notifications as List<Notification> ?? new List<Notification>();
    var reviews = ViewBag.Reviews as List<Feedback> ?? new List<Feedback>();
    var chatMessages = ViewBag.ChatMessages as List<ChatMessage> ?? new List<ChatMessage>();
    int unreadNotifCount = ViewBag.UnreadNotificationCount != null ? (int)ViewBag.UnreadNotificationCount : 0;
    string patientName = ViewBag.PatientName as string ?? "Patient";
}

<!-- ApexCharts Script Integration -->
<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

<div class="container-fluid py-3">
    <!-- Toast & Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Banner matching Dark Slate Theme -->
    <div class="card text-white shadow-sm mb-4 border-0 rounded-3 bg-dark border-start border-4 border-info">
        <div class="card-body p-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center border border-3 border-secondary shadow-sm flex-shrink-0" style="width: 65px; height: 65px; min-width: 65px; font-size: 1.75rem;">
                    @(!string.IsNullOrEmpty(patientName) ? patientName.Substring(0,1).ToUpper() : "P")
                </div>
                <div>
                    <h3 class="fw-bold mb-1 text-white">Welcome, @patientName!</h3>
                    <p class="mb-0 text-white-50">Age: @ViewBag.Age | Gender: @ViewBag.Gender | Blood Group: <span class="badge bg-danger">@(ViewBag.BloodGroup ?? "N/A")</span></p>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Patient" asp-action="Dashboard" asp-route-section="overview" class="btn @(currentSection == "overview" ? "btn-info text-white" : "btn-outline-light") btn-sm font-weight-bold">
                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                </a>
                <a asp-controller="Patient" asp-action="Dashboard" asp-route-section="appointments" class="btn @(currentSection == "appointments" ? "btn-info text-white" : "btn-outline-light") btn-sm">
                    <i class="bi bi-calendar-check me-1"></i> Appointments (@appointments.Count)
                </a>
                <a asp-controller="Patient" asp-action="Dashboard" asp-route-section="doctors" class="btn @(currentSection == "doctors" ? "btn-info text-white" : "btn-outline-light") btn-sm">
                    <i class="bi bi-search me-1"></i> Find Doctor
                </a>
                <a asp-controller="Patient" asp-action="Dashboard" asp-route-section="prescriptions" class="btn @(currentSection == "prescriptions" ? "btn-info text-white" : "btn-outline-light") btn-sm">
                    <i class="bi bi-prescription me-1"></i> Prescriptions
                </a>
                <a asp-controller="Patient" asp-action="Dashboard" asp-route-section="invoices" class="btn @(currentSection == "invoices" || currentSection == "payments" ? "btn-info text-white" : "btn-outline-light") btn-sm">
                    <i class="bi bi-receipt me-1"></i> Invoices &amp; Bills (@invoices.Count)
                </a>
                <button type="button" class="btn btn-primary btn-sm font-weight-bold" data-bs-toggle="modal" data-bs-target="#bookApptModal">
                    <i class="bi bi-calendar-plus me-1"></i> Book Appointment
                </button>
            </div>
        </div>
    </div>

    <!-- SECTION 1: OVERVIEW & DASHBOARD STATS -->
    @if (currentSection == "overview")
    {
        <!-- Statistics Cards -->
        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6">
                <div class="card shadow-sm border-0 border-start border-4 border-primary h-100">
                    <div class="card-body d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">Total Appointments</span>
                            <h2 class="fw-bold text-primary mb-0">@ViewBag.TotalAppointments</h2>
                            <small class="text-success"><i class="bi bi-check-circle me-1"></i>@ViewBag.CompletedAppointments Completed</small>
                        </div>
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 fs-3">
                            <i class="bi bi-calendar-event"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="card shadow-sm border-0 border-start border-4 border-warning h-100">
                    <div class="card-body d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">Pending Requests</span>
                            <h2 class="fw-bold text-warning mb-0">@ViewBag.PendingAppointments</h2>
                            <small class="text-muted">Awaiting Doctor Approval</small>
                        </div>
                        <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3 fs-3">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="card shadow-sm border-0 border-start border-4 border-success h-100">
                    <div class="card-body d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">Active Prescriptions</span>
                            <h2 class="fw-bold text-success mb-0">@prescriptions.Count</h2>
                            <small class="text-success"><i class="bi bi-file-medical me-1"></i>Digital Prescription Issued</small>
                        </div>
                        <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 fs-3">
                            <i class="bi bi-prescription"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="card shadow-sm border-0 border-start border-4 border-info h-100">
                    <div class="card-body d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">Total Spent</span>
                            <h2 class="fw-bold text-info mb-0">৳@ViewBag.TotalSpent</h2>
                            <small class="text-info"><i class="bi bi-wallet2 me-1"></i>Paid for Healthcare</small>
                        </div>
                        <div class="bg-info bg-opacity-10 text-info rounded-circle p-3 fs-3">
                            <i class="bi bi-cash-stack"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Next Upcoming Appointment Banner -->
        @if (nextAppt != null)
        {
            <div class="card bg-info bg-opacity-10 border border-info shadow-sm mb-4 rounded-3">
                <div class="card-body p-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                    <div>
                        <span class="badge bg-info text-dark uppercase fw-bold mb-2">Next Upcoming Consultation</span>
                        <h4 class="fw-bold text-dark mb-1">@nextAppt.Doctor?.User?.Username (@nextAppt.Doctor?.Specialization)</h4>
                        <p class="mb-0 text-secondary">
                            <i class="bi bi-calendar3 me-1"></i><strong>@nextAppt.AppointmentDate.ToString("dd MMMM yyyy")</strong> at 
                            <i class="bi bi-clock me-1 ms-2"></i><strong>@nextAppt.AppointmentTime</strong> | 
                            Status: <span class="badge bg-primary ms-1">@nextAppt.AppointmentStatus</span>
                        </p>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#cancelModal-@nextAppt.Id">Cancel</button>
                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#qrModal-@nextAppt.Id"><i class="bi bi-qr-code me-1"></i> View Ticket QR</button>
                    </div>
                </div>
            </div>
        }

        <!-- Quick Actions Grid -->
        <div class="row g-3 mb-4">
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-lightning-charge-fill me-2 text-warning"></i>Patient Quick Actions</h5>
                    </div>
                    <div class="card-body pt-0">
                        <div class="row g-2">
                            <div class="col-md-2 col-6">
                                <button type="button" class="btn btn-outline-primary w-100 py-3 text-center rounded-3" data-bs-toggle="modal" data-bs-target="#bookApptModal">
                                    <i class="bi bi-calendar-plus fs-3 d-block mb-1"></i> Book Visit
                                </button>
                            </div>
                            <div class="col-md-2 col-6">
                                <a asp-controller="Patient" asp-action="Dashboard" asp-route-section="doctors" class="btn btn-outline-success w-100 py-3 text-center rounded-3">
                                    <i class="bi bi-search fs-3 d-block mb-1"></i> Search Doctor
                                </a>
                            </div>
                            <div class="col-md-2 col-6">
                                <a asp-controller="Patient" asp-action="Dashboard" asp-route-section="documents" class="btn btn-outline-info w-100 py-3 text-center rounded-3">
                                    <i class="bi bi-cloud-upload fs-3 d-block mb-1"></i> Upload File
                                </a>
                            </div>
                            <div class="col-md-2 col-6">
                                <a asp-controller="Patient" asp-action="Dashboard" asp-route-section="payments" class="btn btn-outline-warning text-dark w-100 py-3 text-center rounded-3">
                                    <i class="bi bi-credit-card fs-3 d-block mb-1"></i> Pay Online
                                </a>
                            </div>
                            <div class="col-md-2 col-6">
                                <a asp-controller="Patient" asp-action="Dashboard" asp-route-section="family" class="btn btn-outline-secondary w-100 py-3 text-center rounded-3">
                                    <i class="bi bi-people fs-3 d-block mb-1"></i> Add Family
                                </a>
                            </div>
                            <div class="col-md-2 col-6">
                                <a asp-controller="Patient" asp-action="Dashboard" asp-route-section="messages" class="btn btn-outline-dark w-100 py-3 text-center rounded-3">
                                    <i class="bi bi-chat-dots fs-3 d-block mb-1"></i> Chat Doctor
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Complete EMR Medical Journey Timeline -->
        <div class="row g-4 mb-4">
            <div class="col-lg-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-bezier2 me-2 text-info"></i>Your Healthcare Journey Timeline</h5>
                        <small class="text-muted">Appointment → Diagnosis → Prescription → Lab Test → Treatment → Follow-up</small>
                    </div>
                    <div class="card-body p-4">
                        <div class="timeline position-relative">
                            @if (medicalRecords.Any())
                            {
                                int idx = 0;
                                foreach (var rec in medicalRecords.Take(5))
                                {
                                    idx++;
                                    <div class="d-flex mb-4 gap-3 align-items-start">
                                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width: 40px; height: 40px; min-width: 40px;">
                                            @idx
                                        </div>
                                        <div class="card shadow-sm border-0 w-100">
                                            <div class="card-body p-3 bg-light rounded-3">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <h6 class="fw-bold text-primary mb-0"><i class="bi bi-journal-medical me-1"></i> Diagnosis: @rec.Diagnosis</h6>
                                                    <small class="text-muted">@rec.RecordDate.ToString("dd MMM yyyy, hh:mm tt")</small>
                                                </div>
                                                <p class="mb-1 text-dark small"><strong>Doctor:</strong> @rec.Doctor?.User?.Username</p>
                                                <p class="mb-1 text-secondary small"><strong>Symptoms:</strong> @(rec.Symptoms ?? "N/A")</p>
                                                <p class="mb-0 text-secondary small"><strong>Treatment Plan:</strong> @(rec.TreatmentPlan ?? "Standard Care")</p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-4 text-muted">No medical history records available.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- SECTION 2: APPOINTMENTS MANAGEMENT -->
    @if (currentSection == "appointments")
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-calendar-check-fill me-2 text-primary"></i>My Appointments History</h5>
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#bookApptModal"><i class="bi bi-plus-circle me-1"></i> Book New Visit</button>
            </div>
            <div class="card-body p-0">
                @if (appointments.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date & Time</th>
                                    <th>Doctor</th>
                                    <th>Reason</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appt in appointments)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-primary">@appt.AppointmentDate.ToString("dd MMM yyyy")</div>
                                            <small class="text-muted">@appt.AppointmentTime</small>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark">@appt.Doctor?.User?.Username</div>
                                            <small class="text-muted">@appt.Doctor?.Specialization</small>
                                        </td>
                                        <td><small class="text-secondary">@(appt.ReasonForVisit ?? "Consultation")</small></td>
                                        <td>
                                            <span class="badge @(appt.AppointmentStatus == "Confirmed" ? "bg-success" : (appt.AppointmentStatus == "Pending" ? "bg-warning text-dark" : "bg-secondary"))">@appt.AppointmentStatus</span>
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#qrModal-@appt.Id"><i class="bi bi-qr-code"></i> Ticket</button>
                                                @if (appt.AppointmentStatus != "Cancelled" && appt.AppointmentStatus != "Completed")
                                                {
                                                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelModal-@appt.Id"><i class="bi bi-x-circle"></i> Cancel</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>

                                    <!-- QR Ticket Modal -->
                                    <div class="modal fade" id="qrModal-@appt.Id" tabindex="-1">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content border-0 shadow">
                                                <div class="modal-header bg-primary text-white">
                                                    <h5 class="modal-title fw-bold"><i class="bi bi-qr-code me-2"></i>Appointment Ticket QR</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body text-center p-4">
                                                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=DAMS-APPT-@appt.Id" alt="QR Ticket" class="img-fluid border p-2 rounded mb-3" />
                                                    <h5 class="fw-bold text-dark mb-1">@appt.Doctor?.User?.Username</h5>
                                                    <p class="text-muted small mb-2">@appt.AppointmentDate.ToString("dd MMM yyyy") at @appt.AppointmentTime</p>
                                                    <span class="badge bg-success px-3 py-2 fs-6">Status: @appt.AppointmentStatus</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Cancel Modal -->
                                    <div class="modal fade" id="cancelModal-@appt.Id" tabindex="-1">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content border-0 shadow">
                                                <div class="modal-header bg-danger text-white">
                                                    <h5 class="modal-title fw-bold">Cancel Appointment</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body p-4 text-center">
                                                    <p class="mb-3">Are you sure you want to cancel your appointment with <strong>@appt.Doctor?.User?.Username</strong> on <strong>@appt.AppointmentDate.ToString("dd MMM yyyy")</strong>?</p>
                                                    <form asp-controller="Patient" asp-action="CancelAppointment" method="post">
                                                        <input type="hidden" name="id" value="@appt.Id" />
                                                        <button type="submit" class="btn btn-danger w-100">Yes, Cancel Appointment</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-5 text-center text-muted">No appointments found. Click "Book New Visit" to schedule one.</div>
                }
            </div>
        </div>
    }

    <!-- SECTION 3: DOCTOR SEARCH & DIRECTORY -->
    @if (currentSection == "doctors")
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-search me-2 text-primary"></i>Find & Book Specialist Doctor</h5>
            </div>
            <div class="card-body">
                <form asp-controller="Patient" asp-action="Dashboard" method="get" class="row g-2 mb-4">
                    <input type="hidden" name="section" value="doctors" />
                    <div class="col-md-4">
                        <input type="text" name="search" class="form-control" placeholder="Search doctor by name or spec..." value="@Context.Request.Query["search"]" />
                    </div>
                    <div class="col-md-3">
                        <select name="specFilter" class="form-select">
                            <option value="">All Specializations</option>
                            @if (ViewBag.Specializations != null)
                            {
                                foreach (var spec in (List<string>)ViewBag.Specializations)
                                {
                                    <option value="@spec">@spec</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <input type="number" name="maxFee" class="form-control" placeholder="Max Fee (৳)" value="@Context.Request.Query["maxFee"]" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter me-1"></i> Filter</button>
                    </div>
                </form>

                <div class="row g-3">
                    @if (doctors.Any())
                    {
                        foreach (var doc in doctors)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="card shadow-sm border-0 h-100 rounded-3 overflow-hidden">
                                    <div class="card-body p-4 text-center">
                                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary mx-auto d-flex align-items-center justify-content-center fw-bold fs-3 mb-3 flex-shrink-0" style="width: 70px; height: 70px;">
                                            @(doc.User?.Username?.Substring(0,1).ToUpper() ?? "D")
                                        </div>
                                        <h5 class="fw-bold text-dark mb-1">@doc.User?.Username</h5>
                                        <p class="badge bg-primary me-1">@doc.Specialization</p>
                                        <p class="text-muted small mb-2">@doc.Qualification | Exp: @doc.Experience Years</p>
                                        <h4 class="fw-bold text-success mb-3">৳@doc.ConsultationFee <small class="text-muted fs-6">/ Fee</small></h4>
                                        <a asp-controller="Patient" asp-action="DoctorProfile" asp-route-id="@doc.Id" class="btn btn-outline-primary btn-sm w-100">
                                            <i class="bi bi-person-lines-fill me-1"></i> View More
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }

    <!-- SECTION 4: PRESCRIPTIONS -->
    @if (currentSection == "prescriptions")
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-prescription me-2 text-success"></i>My Prescriptions</h5>
            </div>
            <div class="card-body p-0">
                @if (prescriptions.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Doctor</th>
                                    <th>Diagnosis</th>
                                    <th>Medicines</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rx in prescriptions)
                                {
                                    <tr>
                                        <td class="fw-bold text-primary">@rx.PrescriptionDateTime.ToString("dd MMM yyyy")</td>
                                        <td>@rx.Doctor?.User?.Username</td>
                                        <td>@rx.Diagnosis</td>
                                        <td><small class="text-secondary">@rx.Medicines</small></td>
                                        <td class="text-end">
                                            <a asp-controller="Doctor" asp-action="PrintPrescription" asp-route-id="@rx.Id" target="_blank" class="btn btn-outline-primary btn-sm"><i class="bi bi-printer me-1"></i> Print Prescription</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-5 text-center text-muted">No digital prescriptions found.</div>
                }
            </div>
        </div>
    }

    <!-- SECTION 5: MEDICAL DOCUMENTS UPLOAD -->
    @if (currentSection == "documents")
    {
        <div class="row g-4 mb-4">
            <div class="col-lg-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-cloud-upload me-2 text-info"></i>Upload Medical Record</h5>
                    </div>
                    <div class="card-body p-4">
                        <form asp-controller="Patient" asp-action="UploadMedicalDocument" method="post" enctype="multipart/form-data">
                            <div class="mb-3">
                                <label class="form-label font-weight-bold">Document Name</label>
                                <input type="text" name="documentName" class="form-control" placeholder="e.g. Chest X-Ray Report" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label font-weight-bold">Document Type</label>
                                <select name="documentType" class="form-select" required>
                                    <option value="X-Ray">X-Ray</option>
                                    <option value="MRI">MRI</option>
                                    <option value="CT Scan">CT Scan</option>
                                    <option value="Blood Report">Blood Report</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label font-weight-bold">Select File</label>
                                <input type="file" name="file" class="form-control" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label font-weight-bold">Notes</label>
                                <textarea name="notes" class="form-control" rows="2"></textarea>
                            </div>
                            <button type="submit" class="btn btn-info text-white w-100">Upload File</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-folder-fill me-2 text-primary"></i>Uploaded Medical Records & Reports</h5>
                    </div>
                    <div class="card-body p-0">
                        @if (medicalDocuments.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>File Name</th>
                                            <th>Type</th>
                                            <th>Upload Date</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var doc in medicalDocuments)
                                        {
                                            <tr>
                                                <td class="fw-bold text-dark">@doc.DocumentName</td>
                                                <td><span class="badge bg-info text-dark">@doc.DocumentType</span></td>
                                                <td class="text-muted small">@doc.UploadDate.ToString("dd MMM yyyy")</td>
                                                <td class="text-end">
                                                    <a href="@doc.FilePath" download class="btn btn-outline-primary btn-sm me-1"><i class="bi bi-download"></i> Download</a>
                                                    <form asp-controller="Patient" asp-action="DeleteMedicalDocument" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@doc.Id" />
                                                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete file?')"><i class="bi bi-trash"></i></button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="p-5 text-center text-muted">No uploaded documents. Upload X-Ray, MRI or Blood reports using the form on the left.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- SECTION 6: INVOICES & PAYMENTS -->
    @if (currentSection == "invoices" || currentSection == "payments")
    {
        <div class="row g-4 mb-4">
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 border-0 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                        <div>
                            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-receipt me-2 text-primary"></i>Your Consultation Invoices &amp; Payment Receipts</h5>
                            <small class="text-muted">Itemized breakdown of Doctor Consultation Fees, Hospital Ticket Fees, and Payment Proofs</small>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-success px-3 py-2 fs-6">Total Spent: ৳ @ViewBag.TotalSpent</span>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        @if (invoices.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Invoice #</th>
                                            <th>Doctor &amp; Consultation</th>
                                            <th>Appointment Date</th>
                                            <th>Generated On</th>
                                            <th>Amount Breakdown</th>
                                            <th>Status</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var inv in invoices)
                                        {
                                            <tr>
                                                <td class="fw-bold text-primary">#INV-@inv.Id</td>
                                                <td>
                                                    <div class="fw-bold text-dark">@(inv.Appointment?.Doctor?.User?.Username != null ? "Dr. " + inv.Appointment.Doctor.User.Username : "Doctor Consultation")</div>
                                                    <div class="text-muted small">@(inv.Particulars ?? "Consultation Fee + Ticket Fee")</div>
                                                </td>
                                                <td>@(inv.Appointment != null ? inv.Appointment.AppointmentDate.ToString("dd MMM yyyy") : "N/A")</td>
                                                <td class="text-muted small">@inv.IssueDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                                <td>
                                                    <span class="fw-bold text-dark fs-6">৳ @inv.TotalAmount</span>
                                                </td>
                                                <td>
                                                    <span class="badge @(inv.Status == "Paid" ? "bg-success" : "bg-warning text-dark") px-2.5 py-1.5">
                                                        <i class="bi bi-check-circle-fill me-1"></i>@inv.Status
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <a asp-controller="Patient" asp-action="PrintInvoice" asp-route-id="@inv.Id" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill">
                                                        <i class="bi bi-printer me-1"></i>Print Invoice / PDF
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="p-5 text-center text-muted">
                                <i class="bi bi-receipt-cutoff fs-1 d-block mb-3 text-secondary"></i>
                                <h5>No invoices found</h5>
                                <p class="small">When your appointments are booked and completed by the doctor, your invoices and payment receipts with ticket charges will appear here.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- GLOBAL MODAL: BOOK APPOINTMENT -->
<div class="modal fade" id="bookApptModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-calendar-plus me-2"></i>Book New Appointment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form method="get" action="/Appointment/SelectTime">
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Select Specialist Doctor</label>
                        <select name="doctorId" class="form-select" required>
                            @foreach (var doc in doctors)
                            {
                                <option value="@doc.Id">@doc.User?.Username (@doc.Specialization) - Fee: ৳@doc.ConsultationFee</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Appointment Date</label>
                        <input type="date" name="date" class="form-control" required value="@DateTime.Today.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Reason for Visit</label>
                        <textarea name="reason" class="form-control" rows="2" placeholder="State your symptoms or consultation reason..."></textarea>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="isEmergency" value="true" id="emergencyCheck">
                        <label class="form-check-label text-danger font-weight-bold" for="emergencyCheck">
                            Mark as Emergency Request
                        </label>
                    </div>
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i>A hospital ticket &amp; booking fee of <strong>৳50</strong> will be charged with the consultation fee upon checkout.
                    </div>
                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2.5">
                        <i class="bi bi-credit-card me-1"></i> Proceed to Time Slot &amp; Payment (50৳ Ticket Fee)
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
