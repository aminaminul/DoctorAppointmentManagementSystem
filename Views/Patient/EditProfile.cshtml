@model Patient

@{
    Layout = "_Layout";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-dark text-white">
            <h3>Edit Profile</h3>
        </div>

        <div class="card-body">

            <form method="post">

                <input type="hidden" asp-for="Id" />

                <!-- Name -->
                <div class="mb-3">
                    <label>Name</label>
                    <input asp-for="User.Name"
                           class="form-control" />
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label>Email</label>
                    <input asp-for="User.Email"
                           class="form-control" />
                </div>

                <!-- Age -->
                <div class="mb-3">
                    <label>Age</label>
                    <input asp-for="Age"
                           class="form-control" />
                </div>

                <!-- Gender -->
                <div class="mb-3">
                    <label>Gender</label>

                    <select asp-for="Gender"
                            class="form-control">

                        <option>Male</option>
                        <option>Female</option>

                    </select>
                </div>

                <button type="submit"
                        class="btn btn-success">

                    Update Profile
                </button>

            </form>

        </div>

    </div>

</div>