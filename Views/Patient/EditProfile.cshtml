@model Patient

@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Profile";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- Header -->
                <div class="card-header bg-dark text-white p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <h3 class="fw-bold mb-0"><i class="bi bi-pencil-square me-2 text-warning"></i>Edit Profile</h3>
                        <p class="text-white text-opacity-75 mb-0 small">Keep your personal and medical information up-to-date</p>
                    </div>
                    <a href="/Patient/Dashboard?section=profile" class="btn btn-outline-light rounded-pill px-3">
                        <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
                    </a>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UserId" />

                        <!-- 🔷 Section 1: Account & Personal Info -->
                        <h4 class="fw-bold text-primary mb-4 border-bottom pb-2">
                            <i class="bi bi-person-circle me-2"></i>Personal details & Account info
                        </h4>
                        
                        <div class="row g-3 mb-4">
                            <!-- Full Name -->
                            <div class="col-md-6">
                                <label asp-for="User.Name" class="form-label fw-semibold text-secondary small">Full Name</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-person text-muted"></i></span>
                                    <input asp-for="User.Name" class="form-control" placeholder="John Doe" required />
                                </div>
                                <span asp-validation-for="User.Name" class="text-danger small"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6">
                                <label asp-for="User.Email" class="form-label fw-semibold text-secondary small">Email Address</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-envelope text-muted"></i></span>
                                    <input asp-for="User.Email" type="email" class="form-control" placeholder="john@gmail.com" required readonly style="background-color: #f8f9fa;" />
                                </div>
                                <span asp-validation-for="User.Email" class="text-danger small"></span>
                            </div>

                            <!-- Date of Birth -->
                            <div class="col-md-4">
                                <label asp-for="DateOfBirth" class="form-label fw-semibold text-secondary small">Date of Birth</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-calendar-event text-muted"></i></span>
                                    <input asp-for="DateOfBirth" type="date" class="form-control" required />
                                </div>
                                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                            </div>

                            <!-- Gender -->
                            <div class="col-md-4">
                                <label asp-for="Gender" class="form-label fw-semibold text-secondary small">Gender</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-gender-ambiguous text-muted"></i></span>
                                    <select asp-for="Gender" class="form-select" required>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Gender" class="text-danger small"></span>
                            </div>

                            <!-- Blood Group -->
                            <div class="col-md-4">
                                <label asp-for="BloodGroup" class="form-label fw-semibold text-secondary small">Blood Group</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-droplet text-danger"></i></span>
                                    <select asp-for="BloodGroup" class="form-select">
                                        <option value="">Select Blood Group</option>
                                        <option value="A+">A+</option>
                                        <option value="A-">A-</option>
                                        <option value="B+">B+</option>
                                        <option value="B-">B-</option>
                                        <option value="AB+">AB+</option>
                                        <option value="AB-">AB-</option>
                                        <option value="O+">O+</option>
                                        <option value="O-">O-</option>
                                    </select>
                                </div>
                                <span asp-validation-for="BloodGroup" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- 🔷 Section 2: Contact Info -->
                        <h4 class="fw-bold text-primary mb-4 border-bottom pb-2 mt-5">
                            <i class="bi bi-telephone-inbound-fill me-2"></i>Contact Information
                        </h4>

                        <div class="row g-3 mb-4">
                            <!-- Phone Number -->
                            <div class="col-md-6">
                                <label asp-for="User.PhoneNumber" class="form-label fw-semibold text-secondary small">Phone Number</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-phone text-muted"></i></span>
                                    <input asp-for="User.PhoneNumber" class="form-control" placeholder="e.g. 01712345678" />
                                </div>
                                <span asp-validation-for="User.PhoneNumber" class="text-danger small"></span>
                            </div>

                            <!-- Emergency Contact -->
                            <div class="col-md-6">
                                <label asp-for="EmergencyContact" class="form-label fw-semibold text-secondary small">Emergency Contact (Phone)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-danger"><i class="bi bi-telephone-fill"></i></span>
                                    <input asp-for="EmergencyContact" class="form-control" placeholder="e.g. 01912345678" />
                                </div>
                                <span asp-validation-for="EmergencyContact" class="text-danger small"></span>
                            </div>

                            <!-- Address -->
                            <div class="col-12">
                                <label asp-for="Address" class="form-label fw-semibold text-secondary small">Home Address</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-geo-alt text-muted"></i></span>
                                    <input asp-for="Address" class="form-control" placeholder="123 Health Ave, Dhaka" />
                                </div>
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- 🔷 Section 3: Medical Info -->
                        <h4 class="fw-bold text-primary mb-4 border-bottom pb-2 mt-5">
                            <i class="bi bi-heart-pulse-fill me-2"></i>Medical Profile
                        </h4>

                        <div class="row g-3 mb-4">
                            <!-- Allergies -->
                            <div class="col-md-6">
                                <label asp-for="Allergies" class="form-label fw-semibold text-danger small">Allergies</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light align-items-start pt-2"><i class="bi bi-exclamation-triangle text-danger"></i></span>
                                    <textarea asp-for="Allergies" rows="3" class="form-control" placeholder="Describe any known food, drug or environmental allergies (e.g. Dust, Penicillin)"></textarea>
                                </div>
                                <span asp-validation-for="Allergies" class="text-danger small"></span>
                            </div>

                            <!-- Medical History -->
                            <div class="col-md-6">
                                <label asp-for="MedicalHistory" class="form-label fw-semibold text-secondary small">Medical History</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light align-items-start pt-2"><i class="bi bi-journal-medical text-muted"></i></span>
                                    <textarea asp-for="MedicalHistory" rows="3" class="form-control" placeholder="Describe past major operations, chronic diseases or medical treatments"></textarea>
                                </div>
                                <span asp-validation-for="MedicalHistory" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-end gap-3 mt-5 pt-3 border-top">
                            <a href="/Patient/Dashboard?section=profile" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-success btn-lg rounded-pill px-5 shadow">
                                <i class="bi bi-check2-circle me-2"></i>Update Profile
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}