@model DoctorAppointmentManagementSystem.Models.Invoice
@{
    Layout = null;
    ViewData["Title"] = "Invoice - #INV-" + Model.Id;
    var payment = ViewBag.Payment as DoctorAppointmentManagementSystem.Models.Payment;
    var doctor = Model.Appointment?.Doctor;
    var patient = Model.Patient;
    decimal docFee = doctor != null ? doctor.ConsultationFee : (Model.TotalAmount > 50 ? Model.TotalAmount - 50 : Model.TotalAmount);
    decimal ticketFee = 50.00m;
    decimal total = Model.TotalAmount;
    string paymentMethod = payment?.PaymentMethod ?? "Online Payment (bKash / Nagad / Card)";
    string trxId = payment?.TransactionId ?? ("TRX-" + Model.Id + DateTime.Now.ToString("mmss"));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Receipt - #INV-@Model.Id</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        @@media print {
            .d-print-none { display: none !important; }
            body { background-color: #ffffff !important; padding: 0 !important; }
            .invoice-container { box-shadow: none !important; border: 1px solid #cbd5e1 !important; margin: 0 !important; width: 100% !important; max-width: 100% !important; padding: 25px !important; }
        }
        body { background-color: #f1f5f9; font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; color: #1e293b; }
        .invoice-container { max-width: 820px; margin: 30px auto; background: #ffffff; border-radius: 14px; box-shadow: 0 10px 25px rgba(0,0,0,0.05); padding: 40px; border: 1px solid #e2e8f0; }
        .header-logo { width: 55px; height: 55px; background: #0284c7; color: white; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.75rem; }
        .badge-paid { background: #dcfce7; color: #15803d; border: 1px solid #86efac; font-size: 0.85rem; padding: 6px 14px; border-radius: 20px; font-weight: 700; display: inline-flex; align-items: center; gap: 5px; }
        .badge-unpaid { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; font-size: 0.85rem; padding: 6px 14px; border-radius: 20px; font-weight: 700; display: inline-flex; align-items: center; gap: 5px; }
        .table th { background: #f8fafc; color: #475569; font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0; }
        .seal-box { border: 2px dashed #cbd5e1; border-radius: 8px; height: 75px; display: flex; align-items: center; justify-content: center; color: #94a3b8; font-size: 0.8rem; font-weight: 600; }
    </style>
</head>
<body class="p-3 p-md-4">

    <div class="invoice-container position-relative">
        
        <!-- Header -->
        <div class="row align-items-center border-bottom pb-4 mb-4">
            <div class="col-sm-7 d-flex align-items-center gap-3">
                <div class="header-logo shadow-sm flex-shrink-0">
                    <i class="bi bi-hospital"></i>
                </div>
                <div>
                    <h3 class="fw-bold text-dark mb-0">Doctor Appointment Medical Center</h3>
                    <p class="text-muted small mb-0">Digital Healthcare &amp; Consultation Billing Receipt</p>
                    <small class="text-muted">123 Health Ave, Medical District | Tel: +880 1700-000000</small>
                </div>
            </div>
            <div class="col-sm-5 text-sm-end mt-3 mt-sm-0">
                <div class="mb-1">
                    @if (Model.Status == "Paid")
                    {
                        <span class="badge-paid"><i class="bi bi-check-circle-fill"></i> PAYMENT COMPLETED</span>
                    }
                    else
                    {
                        <span class="badge-unpaid"><i class="bi bi-clock-history"></i> @Model.Status.ToUpper()</span>
                    }
                </div>
                <h4 class="fw-bold text-primary mb-0">#INV-@Model.Id.ToString("D5")</h4>
                <small class="text-muted">Date: @Model.IssueDate.ToString("dd MMM yyyy, hh:mm tt")</small>
            </div>
        </div>

        <!-- Info Grid: Doctor, Patient, Payment Info -->
        <div class="row g-3 mb-4">
            <!-- Patient Info -->
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 border h-100">
                    <span class="text-muted small text-uppercase fw-bold d-block mb-1"><i class="bi bi-person-fill me-1 text-primary"></i> Patient Details</span>
                    <h6 class="fw-bold text-dark mb-1">@patient?.User?.Username</h6>
                    <div class="text-muted small">Age: @(patient?.Age > 0 ? patient.Age.ToString() : "N/A") | Gender: @(patient?.Gender ?? "N/A")</div>
                    <div class="text-muted small">Blood Group: <strong class="text-danger">@(patient?.BloodGroup ?? "N/A")</strong></div>
                    <div class="text-muted small text-truncate">Email: @patient?.User?.Email</div>
                </div>
            </div>

            <!-- Doctor Info -->
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 border h-100">
                    <span class="text-muted small text-uppercase fw-bold d-block mb-1"><i class="bi bi-person-badge-fill me-1 text-info"></i> Specialist Doctor</span>
                    <h6 class="fw-bold text-dark mb-1">@(doctor?.User?.Username != null ? "Dr. " + doctor.User.Username : "Medical Specialist")</h6>
                    <div class="text-primary small fw-semibold">@(doctor?.Specialization ?? "Consultant Specialist")</div>
                    <div class="text-muted small">@doctor?.Qualification</div>
                    <div class="text-muted small">Dept / Experience: @(doctor?.Experience != null ? doctor.Experience + " Years" : "General")</div>
                </div>
            </div>

            <!-- Transaction Details -->
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 border h-100">
                    <span class="text-muted small text-uppercase fw-bold d-block mb-1"><i class="bi bi-receipt-cutoff me-1 text-success"></i> Payment Summary</span>
                    <div class="text-muted small">Method: <strong class="text-dark">@paymentMethod</strong></div>
                    <div class="text-muted small">Trx ID: <code class="text-dark">@trxId</code></div>
                    <div class="text-muted small">Appt Date: <strong>@(Model.Appointment != null ? Model.Appointment.AppointmentDate.ToString("dd MMM yyyy") : Model.IssueDate.ToString("dd MMM yyyy"))</strong></div>
                    <div class="text-muted small">Appt Time: <strong>@(Model.Appointment?.AppointmentTime ?? "Scheduled Time")</strong></div>
                </div>
            </div>
        </div>

        <!-- Particulars Description -->
        @if (!string.IsNullOrWhiteSpace(Model.Particulars))
        {
            <div class="alert alert-secondary py-2 px-3 small mb-4 border-0 bg-light">
                <i class="bi bi-info-circle me-1 text-primary"></i><strong>Notes:</strong> @Model.Particulars
            </div>
        }

        <!-- Itemized Table -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle">
                <thead>
                    <tr>
                        <th style="width: 60px;" class="text-center">#</th>
                        <th>Item &amp; Service Description</th>
                        <th class="text-center" style="width: 120px;">Category</th>
                        <th class="text-end" style="width: 140px;">Amount (BDT)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-center fw-bold">1</td>
                        <td>
                            <div class="fw-bold text-dark">Doctor Consultation Fee</div>
                            <small class="text-muted">Professional medical consultation with @(doctor?.User?.Username != null ? "Dr. " + doctor.User.Username : "Specialist")</small>
                        </td>
                        <td class="text-center"><span class="badge bg-light text-dark border">Consultation</span></td>
                        <td class="text-end fw-semibold">৳ @docFee.ToString("F2")</td>
                    </tr>
                    <tr>
                        <td class="text-center fw-bold">2</td>
                        <td>
                            <div class="fw-bold text-dark">Hospital Ticket &amp; Booking Charge</div>
                            <small class="text-muted">Digital registration, OPD slot allocation, and hospital ticket administration fee</small>
                        </td>
                        <td class="text-center"><span class="badge bg-light text-dark border">Ticket Fee</span></td>
                        <td class="text-end fw-semibold">৳ @ticketFee.ToString("F2")</td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end fw-bold">Subtotal:</td>
                        <td class="text-end fw-bold">৳ @total.ToString("F2")</td>
                    </tr>
                    <tr>
                        <td colspan="3" class="text-end text-muted small">Discount / Concession:</td>
                        <td class="text-end text-muted small">৳ 0.00</td>
                    </tr>
                    <tr class="table-success">
                        <td colspan="3" class="text-end fw-bold fs-6 text-dark">Total Amount Paid:</td>
                        <td class="text-end fw-bold fs-5 text-success">৳ @total.ToString("F2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Footer / Signatures -->
        <div class="row pt-4 border-top align-items-end mt-4">
            <div class="col-4">
                <img src="https://api.qrserver.com/v1/create-qr-code/?size=85x85&data=INVOICE-@Model.Id-PAT-@Model.PatientId-AMOUNT-@Model.TotalAmount" alt="QR Verification" class="img-thumbnail rounded" style="width: 80px; height: 80px;" />
                <div class="small text-muted mt-1" style="font-size: 0.72rem;">Digital Receipt Verification</div>
            </div>
            <div class="col-4 text-center">
                <div class="seal-box">
                    <i class="bi bi-patch-check-fill text-success me-1"></i> Hospital Digital Seal
                </div>
            </div>
            <div class="col-4 text-end">
                <div class="border-top pt-2 d-inline-block px-3">
                    <div class="fw-bold text-dark small">Accounts &amp; Billing Dept.</div>
                    <div class="text-muted" style="font-size: 0.75rem;">Authorized Signature</div>
                </div>
            </div>
        </div>

        <!-- Thank you note -->
        <div class="text-center text-muted mt-4 pt-3 border-top" style="font-size: 0.78rem;">
            Thank you for choosing Doctor Appointment Medical Center. For billing queries, email us at <a href="mailto:billing@medicalcenter.com" class="text-decoration-none">billing@medicalcenter.com</a>. This is a computer-generated official receipt.
        </div>

        <!-- Print Actions (Hidden on Print) -->
        <div class="mt-4 text-center d-print-none pt-3 border-top">
            <button onclick="window.print()" class="btn btn-primary px-4 py-2 me-2 rounded-pill fw-bold shadow-sm">
                <i class="bi bi-printer me-2"></i>Print Invoice / Save PDF
            </button>
            <button onclick="window.close()" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                <i class="bi bi-x-circle me-1"></i>Close Window
            </button>
        </div>

    </div>

</body>
</html>
