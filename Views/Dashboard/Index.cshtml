@model DoctorAppointmentManagementSystem.ViewModels.DashboardViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Overview";
    ViewData["HideSidebar"] = true;

    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening";
    var userRole = ViewData["UserRole"] as string ?? "";
    var userName = ViewData["Username"] as string ?? "User";

    string StatusBadge(string status) => status switch {
        "Completed"  => "badge-success",
        "Confirmed"  => "badge-info",
        "Pending"    => "badge-warning",
        "Cancelled"  => "badge-danger",
        _            => "badge-secondary"
    };
    string StatusIcon(string status) => status switch {
        "Completed"  => "bi-check-circle-fill",
        "Confirmed"  => "bi-calendar-check-fill",
        "Pending"    => "bi-clock-fill",
        "Cancelled"  => "bi-x-circle-fill",
        _            => "bi-circle"
    };

    var chartLabels   = System.Text.Json.JsonSerializer.Serialize(Model.LabelsLast7Days);
    var chartValues   = System.Text.Json.JsonSerializer.Serialize(Model.AppointmentsLast7Days);
    var monthlyLabels = System.Text.Json.JsonSerializer.Serialize(Model.MonthlyLabels);
    var monthlyAppts  = System.Text.Json.JsonSerializer.Serialize(Model.MonthlyAppointments);
    var monthlyRev    = System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenueData);
    var statusCounts  = System.Text.Json.JsonSerializer.Serialize(Model.StatusCounts);
}

<style>
    
    :root {
        --bg-dark:   #0b1727;
        --bg-card:   #111f35;
        --bg-card2:  #152840;
        --accent:    #4DA8DA;
        --accent2:   #3a96c4;
        --success:   #22c55e;
        --warning:   #f59e0b;
        --danger:    #ef4444;
        --info:      #06b6d4;
        --purple:    #8b5cf6;
        --border:    rgba(255,255,255,0.07);
        --text:      #e2e8f0;
        --muted:     rgba(255,255,255,0.45);
    }

    body { background: var(--bg-dark) !important; color: var(--text) !important; font-family: 'Segoe UI', system-ui, sans-serif; }

    .overview-wrap { display: flex; min-height: calc(100vh - 76px); }
    .sidebar-col   { width: 230px; min-width: 230px; flex-shrink: 0; }
    .main-col      { flex: 1; min-width: 0; padding: 2rem 2.2rem; }

    .topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    .topbar-greeting h4  { font-weight: 800; font-size: 1.3rem; margin: 0; }
    .topbar-greeting p   { color: var(--muted); font-size: 0.85rem; margin: 0; }
    .topbar-actions      { display: flex; gap: 0.75rem; align-items: center; }

    .btn-topbar {
        background: var(--bg-card);
        border: 1px solid var(--border);
        color: var(--text);
        padding: 8px 18px;
        border-radius: 50px;
        font-size: 0.83rem;
        font-weight: 600;
        cursor: pointer;
        transition: all .2s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .btn-topbar:hover { background: var(--bg-card2); border-color: var(--accent); color: var(--accent); }
    .btn-topbar.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
    .btn-topbar.primary:hover { background: var(--accent2); }

    .section-heading { font-size: 1rem; font-weight: 700; color: var(--text); margin-bottom: 1rem; display: flex; align-items: center; gap: 8px; }
    .section-heading::before { content: ''; display: inline-block; width: 4px; height: 18px; background: var(--accent); border-radius: 2px; }

    .stats-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1.1rem; margin-bottom: 1.8rem; }

    .stat-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 1.3rem 1.4rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: transform .22s, box-shadow .22s;
        cursor: default;
        position: relative;
        overflow: hidden;
    }
    .stat-card::after {
        content: '';
        position: absolute;
        top: 0; right: 0;
        width: 80px; height: 80px;
        border-radius: 50%;
        opacity: .06;
        transform: translate(20px, -20px);
    }
    .stat-card:hover { transform: translateY(-3px); box-shadow: 0 8px 32px rgba(0,0,0,0.35); }

    .stat-icon {
        width: 52px; height: 52px;
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }
    .stat-body { min-width: 0; }
    .stat-value { font-size: 1.65rem; font-weight: 800; line-height: 1; margin-bottom: 4px; }
    .stat-label { font-size: 0.78rem; color: var(--muted); font-weight: 500; }
    .stat-delta { font-size: 0.75rem; font-weight: 600; margin-top: 4px; }
    .stat-delta.up   { color: var(--success); }
    .stat-delta.down { color: var(--danger); }

    .sc-blue   .stat-icon { background: rgba(77,168,218,.15); color: var(--accent); }
    .sc-blue   .stat-value { color: var(--accent); }
    .sc-blue::after   { background: var(--accent); }

    .sc-green  .stat-icon { background: rgba(34,197,94,.15);  color: var(--success); }
    .sc-green  .stat-value { color: var(--success); }
    .sc-green::after  { background: var(--success); }

    .sc-orange .stat-icon { background: rgba(245,158,11,.15); color: var(--warning); }
    .sc-orange .stat-value { color: var(--warning); }
    .sc-orange::after { background: var(--warning); }

    .sc-red    .stat-icon { background: rgba(239,68,68,.15);  color: var(--danger); }
    .sc-red    .stat-value { color: var(--danger); }
    .sc-red::after    { background: var(--danger); }

    .sc-purple .stat-icon { background: rgba(139,92,246,.15); color: var(--purple); }
    .sc-purple .stat-value { color: var(--purple); }
    .sc-purple::after { background: var(--purple); }

    .sc-teal   .stat-icon { background: rgba(6,182,212,.15);  color: var(--info); }
    .sc-teal   .stat-value { color: var(--info); }
    .sc-teal::after   { background: var(--info); }

    .charts-row { display: grid; grid-template-columns: 2fr 1fr; gap: 1.2rem; margin-bottom: 1.8rem; }
    .chart-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 1.4rem;
    }
    .chart-card canvas { width: 100% !important; }
    .chart-title { font-size: 0.9rem; font-weight: 700; margin-bottom: 1rem; color: var(--text); }

    .bottom-row { display: grid; grid-template-columns: 1fr 340px; gap: 1.2rem; margin-bottom: 1.8rem; }

    .table-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
    }
    .table-card-header {
        padding: 1.1rem 1.4rem;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .table-card-header h6 { font-weight: 700; font-size: 0.9rem; margin: 0; }

    .dams-table { width: 100%; border-collapse: collapse; }
    .dams-table th {
        padding: 10px 14px;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: var(--muted);
        border-bottom: 1px solid var(--border);
        white-space: nowrap;
    }
    .dams-table td {
        padding: 11px 14px;
        font-size: 0.84rem;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        color: var(--text);
        vertical-align: middle;
    }
    .dams-table tr:last-child td { border-bottom: none; }
    .dams-table tr:hover td { background: rgba(255,255,255,0.025); }

    .avatar-sm {
        width: 34px; height: 34px;
        border-radius: 50%;
        background: rgba(77,168,218,.2);
        color: var(--accent);
        font-weight: 700;
        font-size: 0.8rem;
        display: inline-flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }

    .badge-pill {
        padding: 4px 10px;
        border-radius: 50px;
        font-size: 0.72rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .badge-success   { background: rgba(34,197,94,.15);   color: #4ade80; }
    .badge-info      { background: rgba(6,182,212,.15);   color: #22d3ee; }
    .badge-warning   { background: rgba(245,158,11,.15);  color: #fbbf24; }
    .badge-danger    { background: rgba(239,68,68,.15);   color: #f87171; }
    .badge-secondary { background: rgba(255,255,255,.08); color: var(--muted); }

    .side-panel { display: flex; flex-direction: column; gap: 1.2rem; }

    .mini-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 1.2rem 1.4rem;
    }
    .mini-card-title { font-size: 0.85rem; font-weight: 700; margin-bottom: 0.9rem; color: var(--text); }

    .donut-legend-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: .5rem; font-size: .82rem; }
    .donut-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; margin-right: 7px; }

    .spec-row { margin-bottom: 0.8rem; }
    .spec-label { display: flex; justify-content: space-between; font-size: 0.8rem; margin-bottom: 4px; }
    .spec-bar-bg { height: 6px; background: rgba(255,255,255,.06); border-radius: 50px; overflow: hidden; }
    .spec-bar-fill { height: 100%; border-radius: 50px; background: linear-gradient(90deg, var(--accent), var(--info)); transition: width 1s ease; }

    .quick-actions-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem; }
    .qa-btn {
        background: var(--bg-card2);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 0.8rem 0.9rem;
        color: var(--text);
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 600;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        transition: all .2s;
        text-align: center;
    }
    .qa-btn:hover { background: rgba(77,168,218,.1); border-color: var(--accent); color: var(--accent); transform: translateY(-2px); }
    .qa-btn i { font-size: 1.3rem; }

    .alerts-row { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; margin-bottom: 1.8rem; }
    .alert-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 1rem 1.2rem;
        display: flex;
        align-items: center;
        gap: 0.9rem;
        border-left: 4px solid;
    }
    .alert-card.warn  { border-left-color: var(--warning); }
    .alert-card.info  { border-left-color: var(--accent); }
    .alert-card.err   { border-left-color: var(--danger); }
    .alert-card.ok    { border-left-color: var(--success); }
    .alert-icon { font-size: 1.4rem; }
    .alert-card.warn .alert-icon  { color: var(--warning); }
    .alert-card.info .alert-icon  { color: var(--accent); }
    .alert-card.err  .alert-icon  { color: var(--danger); }
    .alert-card.ok   .alert-icon  { color: var(--success); }
    .alert-text strong { font-size: 0.85rem; font-weight: 700; display: block; }
    .alert-text span   { font-size: 0.78rem; color: var(--muted); }

    @@media (max-width: 1100px) {
        .bottom-row    { grid-template-columns: 1fr; }
        .charts-row    { grid-template-columns: 1fr; }
    }
    @@media (max-width: 768px) {
        .sidebar-col   { display: none; }
        .main-col      { padding: 1.2rem; }
        .stats-grid    { grid-template-columns: repeat(2, 1fr); }
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<div class="overview-wrap">
    
    <div class="sidebar-col">
        @await Component.InvokeAsync("Sidebar")
    </div>

    <div class="main-col">

        <div class="topbar">
            <div class="topbar-greeting">
                <h4>@greeting, @(string.IsNullOrEmpty(userName) ? "Admin" : userName)! ðŸ‘‹</h4>
                <p>@DateTime.Now.ToString("dddd, MMMM dd yyyy") &mdash; Here's what's happening in DAMS today.</p>
            </div>
            <div class="topbar-actions">
                @if (userRole == "admin")
                {
                    <a href="/Appointment/Book" class="btn-topbar primary"><i class="bi bi-plus-lg"></i> New Appointment</a>
                }
                <button class="btn-topbar" onclick="window.print()"><i class="bi bi-download"></i> Export</button>
            </div>
        </div>

        @if (userRole == "admin" && (Model.PendingRequests > 0 || Model.PendingLeaveRequests > 0 || Model.OpenComplaints > 0 || Model.EmergencyCases > 0))
        {
        <div class="alerts-row">
            @if (Model.PendingRequests > 0)
            {
            <div class="alert-card warn">
                <div class="alert-icon"><i class="bi bi-clock-fill"></i></div>
                <div class="alert-text">
                    <strong>@Model.PendingRequests Pending</strong>
                    <span>Appointments awaiting confirmation</span>
                </div>
            </div>
            }
            @if (Model.EmergencyCases > 0)
            {
            <div class="alert-card err">
                <div class="alert-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
                <div class="alert-text">
                    <strong>@Model.EmergencyCases Emergency</strong>
                    <span>Cases need immediate attention</span>
                </div>
            </div>
            }
            @if (Model.PendingLeaveRequests > 0)
            {
            <div class="alert-card info">
                <div class="alert-icon"><i class="bi bi-calendar-minus-fill"></i></div>
                <div class="alert-text">
                    <strong>@Model.PendingLeaveRequests Leave Requests</strong>
                    <span>Doctor leave requests pending</span>
                </div>
            </div>
            }
            @if (Model.OpenComplaints > 0)
            {
            <div class="alert-card ok">
                <div class="alert-icon"><i class="bi bi-chat-left-text-fill"></i></div>
                <div class="alert-text">
                    <strong>@Model.OpenComplaints Open</strong>
                    <span>Complaints need resolution</span>
                </div>
            </div>
            }
        </div>
        }

        <div class="section-heading">Key Metrics</div>
        <div class="stats-grid">
            <div class="stat-card sc-blue">
                <div class="stat-icon"><i class="bi bi-calendar2-check-fill"></i></div>
                <div class="stat-body">
                    <div class="stat-value">@Model.TotalAppointments</div>
                    <div class="stat-label">Total Appointments</div>
                    <div class="stat-delta up"><i class="bi bi-arrow-up-short"></i> @Model.TodaysAppointments today</div>
                </div>
            </div>
            <div class="stat-card sc-green">
                <div class="stat-icon"><i class="bi bi-person-badge-fill"></i></div>
                <div class="stat-body">
                    <div class="stat-value">@Model.TotalDoctors</div>
                    <div class="stat-label">Total Doctors</div>
                    <div class="stat-delta up"><i class="bi bi-dot"></i> @Model.ActiveDoctors active</div>
                </div>
            </div>
            <div class="stat-card sc-purple">
                <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
                <div class="stat-body">
                    <div class="stat-value">@Model.TotalPatients</div>
                    <div class="stat-label">Total Patients</div>
                    <div class="stat-delta up"><i class="bi bi-dot"></i> @Model.ActivePatients active</div>
                </div>
            </div>
            <div class="stat-card sc-teal">
                <div class="stat-icon"><i class="bi bi-currency-dollar"></i></div>
                <div class="stat-body">
                    <div class="stat-value">à§³@Model.TotalRevenue.ToString("N0")</div>
                    <div class="stat-label">Total Revenue</div>
                    <div class="stat-delta up"><i class="bi bi-arrow-up-short"></i> à§³@Model.MonthlyRevenue.ToString("N0") this month</div>
                </div>
            </div>
            <div class="stat-card sc-green">
                <div class="stat-icon"><i class="bi bi-check-circle-fill"></i></div>
                <div class="stat-body">
                    <div class="stat-value">@Model.CompletedAppointments</div>
                    <div class="stat-label">Completed</div>
                    <div class="stat-delta up">Appointments done</div>
                </div>
            </div>
            <div class="stat-card sc-orange">
                <div class="stat-icon"><i class="bi bi-clock-fill"></i></div>
                <div class="stat-body">
                    <div class="stat-value">@Model.PendingRequests</div>
                    <div class="stat-label">Pending</div>
                    <div class="stat-delta">Need confirmation</div>
                </div>
            </div>
            <div class="stat-card sc-teal">
                <div class="stat-icon"><i class="bi bi-calendar-check-fill"></i></div>
                <div class="stat-body">
                    <div class="stat-value">@Model.ConfirmedAppointments</div>
                    <div class="stat-label">Confirmed</div>
                    <div class="stat-delta">Appointments set</div>
                </div>
            </div>
            <div class="stat-card sc-red">
                <div class="stat-icon"><i class="bi bi-x-circle-fill"></i></div>
                <div class="stat-body">
                    <div class="stat-value">@Model.CancelledAppointments</div>
                    <div class="stat-label">Cancelled</div>
                    <div class="stat-delta down">Appointments lost</div>
                </div>
            </div>
        </div>

        <div class="section-heading">Analytics</div>
        <div class="charts-row">
            
            <div class="chart-card">
                <div class="chart-title"><i class="bi bi-graph-up-arrow me-2" style="color:var(--accent)"></i>Appointments â€“ Last 7 Days</div>
                <canvas id="lineChart" height="140"></canvas>
            </div>
            
            <div class="chart-card">
                <div class="chart-title"><i class="bi bi-bar-chart-fill me-2" style="color:var(--purple)"></i>Monthly Trend</div>
                <canvas id="barChart" height="140"></canvas>
            </div>
        </div>

        <div class="bottom-row">
            
            <div class="table-card">
                <div class="table-card-header">
                    <h6><i class="bi bi-calendar2-week me-2" style="color:var(--accent)"></i>Recent Appointments</h6>
                    @if (userRole == "admin")
                    {
                        <a href="/Admin/Dashboard" class="btn-topbar" style="padding:5px 13px;font-size:.78rem;">View All</a>
                    }
                </div>
                <div style="overflow-x:auto;">
                    <table class="dams-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Specialization</th>
                                <th>Date &amp; Time</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentAppointments.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center" style="color:var(--muted);padding:2rem;">
                                        <i class="bi bi-calendar-x" style="font-size:2rem;display:block;margin-bottom:.5rem;"></i>
                                        No appointments yet
                                    </td>
                                </tr>
                            }
                            @foreach (var appt in Model.RecentAppointments)
                            {
                                <tr>
                                    <td style="color:var(--muted)">#@appt.Id</td>
                                    <td>
                                        <div style="display:flex;align-items:center;gap:9px;">
                                            <div class="avatar-sm">@(appt.PatientName.Length > 0 ? appt.PatientName[0].ToString().ToUpper() : "P")</div>
                                            <div>
                                                <div style="font-weight:600;font-size:.85rem;">@appt.PatientName</div>
                                                @if (appt.IsEmergency)
                                                {
                                                    <span style="font-size:.7rem;color:var(--danger);font-weight:700;"><i class="bi bi-exclamation-circle-fill"></i> Emergency</span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td style="font-weight:600">@appt.DoctorName</td>
                                    <td style="color:var(--muted);font-size:.82rem;">@appt.Specialization</td>
                                    <td>
                                        <div style="font-size:.83rem;font-weight:600;">@appt.AppointmentDate.ToString("MMM dd, yyyy")</div>
                                        <div style="font-size:.75rem;color:var(--muted);">@appt.AppointmentTime</div>
                                    </td>
                                    <td>
                                        <span class="badge-pill @StatusBadge(appt.Status)">
                                            <i class="bi @StatusIcon(appt.Status)"></i>
                                            @appt.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="side-panel">

                <div class="mini-card">
                    <div class="mini-card-title"><i class="bi bi-pie-chart-fill me-2" style="color:var(--accent)"></i>Appointment Status</div>
                    <canvas id="donutChart" height="140"></canvas>
                    <div style="margin-top:1rem;">
                        <div class="donut-legend-row"><span><span class="donut-dot" style="background:#fbbf24"></span>Pending</span><span style="font-weight:700;">@Model.StatusCounts[0]</span></div>
                        <div class="donut-legend-row"><span><span class="donut-dot" style="background:#22d3ee"></span>Confirmed</span><span style="font-weight:700;">@Model.StatusCounts[1]</span></div>
                        <div class="donut-legend-row"><span><span class="donut-dot" style="background:#4ade80"></span>Completed</span><span style="font-weight:700;">@Model.StatusCounts[2]</span></div>
                        <div class="donut-legend-row"><span><span class="donut-dot" style="background:#f87171"></span>Cancelled</span><span style="font-weight:700;">@Model.StatusCounts[3]</span></div>
                    </div>
                </div>

                @if (Model.TopSpecializations.Any())
                {
                <div class="mini-card">
                    <div class="mini-card-title"><i class="bi bi-award-fill me-2" style="color:var(--warning)"></i>Top Specializations</div>
                    @{
                        int maxSpec = Model.TopSpecializations.Max(s => s.Count);
                        maxSpec = maxSpec == 0 ? 1 : maxSpec;
                    }
                    @foreach (var spec in Model.TopSpecializations)
                    {
                        <div class="spec-row">
                            <div class="spec-label">
                                <span>@spec.Specialization</span>
                                <span style="font-weight:700;">@spec.Count</span>
                            </div>
                            <div class="spec-bar-bg">
                                <div class="spec-bar-fill" style="width:@(((double)spec.Count / maxSpec * 100).ToString("0"))%"></div>
                            </div>
                        </div>
                    }
                </div>
                }

                @if (userRole == "admin")
                {
                <div class="mini-card">
                    <div class="mini-card-title"><i class="bi bi-lightning-fill me-2" style="color:var(--warning)"></i>Quick Actions</div>
                    <div class="quick-actions-grid">
                        <a href="/Admin/Dashboard?section=doctors" class="qa-btn"><i class="bi bi-person-badge"></i>Doctors</a>
                        <a href="/Admin/Dashboard?section=patients" class="qa-btn"><i class="bi bi-people"></i>Patients</a>
                        <a href="/Admin/LeaveRequests" class="qa-btn"><i class="bi bi-calendar-minus"></i>Leaves</a>
                        <a href="/Admin/Complaints" class="qa-btn"><i class="bi bi-chat-left-text"></i>Complaints</a>
                        <a href="/Report/Revenue" class="qa-btn"><i class="bi bi-bar-chart"></i>Reports</a>
                        <a href="/Settings/System" class="qa-btn"><i class="bi bi-gear"></i>Settings</a>
                    </div>
                </div>
                }
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    Chart.defaults.color = 'rgba(255,255,255,0.5)';
    Chart.defaults.borderColor = 'rgba(255,255,255,0.06)';

    const lineCtx = document.getElementById('lineChart').getContext('2d');
    const lineGrad = lineCtx.createLinearGradient(0, 0, 0, 200);
    lineGrad.addColorStop(0, 'rgba(77,168,218,0.35)');
    lineGrad.addColorStop(1, 'rgba(77,168,218,0)');

    new Chart(lineCtx, {
        type: 'line',
        data: {
            labels: @Html.Raw(chartLabels),
            datasets: [{
                label: 'Appointments',
                data: @Html.Raw(chartValues),
                borderColor: '#4DA8DA',
                backgroundColor: lineGrad,
                borderWidth: 2.5,
                pointBackgroundColor: '#4DA8DA',
                pointRadius: 4,
                pointHoverRadius: 6,
                tension: 0.4,
                fill: true
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { color: 'rgba(255,255,255,0.04)' } },
                y: { grid: { color: 'rgba(255,255,255,0.04)' }, beginAtZero: true, ticks: { stepSize: 1 } }
            }
        }
    });

    new Chart(document.getElementById('barChart').getContext('2d'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(monthlyLabels),
            datasets: [{
                label: 'Appointments',
                data: @Html.Raw(monthlyAppts),
                backgroundColor: 'rgba(139,92,246,0.6)',
                borderColor: '#8b5cf6',
                borderWidth: 2,
                borderRadius: 8,
                borderSkipped: false
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { color: 'rgba(255,255,255,0.04)' } },
                y: { grid: { color: 'rgba(255,255,255,0.04)' }, beginAtZero: true, ticks: { stepSize: 1 } }
            }
        }
    });

    new Chart(document.getElementById('donutChart').getContext('2d'), {
        type: 'doughnut',
        data: {
            labels: ['Pending', 'Confirmed', 'Completed', 'Cancelled'],
            datasets: [{
                data: @Html.Raw(statusCounts),
                backgroundColor: ['#fbbf24', '#22d3ee', '#4ade80', '#f87171'],
                borderColor: '#111f35',
                borderWidth: 3,
                hoverOffset: 6
            }]
        },
        options: {
            responsive: true,
            cutout: '70%',
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: ctx => ` ${ctx.label}: ${ctx.parsed}`
                    }
                }
            }
        }
    });
</script>
}
