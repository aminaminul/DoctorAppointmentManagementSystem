@* Razor View: Appointment/CardPayment *@
<!-- HTML View: Appointment/CardPayment -->
@{
    Layout = "_Layout";
}

<div class="container mt-5" style="max-width: 500px;">
    <div class="card shadow-lg border-0 rounded-4 p-4" style="background: linear-gradient(135deg, #e8eaf6 0%, #ffffff 100%);">
        <div class="text-center mb-4">
            <div class="d-inline-block rounded-circle p-3 mb-2" style="background-color: #3f51b5; color: white; width: 70px; height: 70px; font-size: 24px; font-weight: bold; line-height: 38px; text-align: center;">
                <i class="bi bi-credit-card-2-back-fill"></i>
            </div>
            <h3 class="fw-bold text-dark m-0">Card Payment</h3>
            <p class="text-muted small">Please enter your credit or debit card details</p>
        </div>

        <form method="post" action="/Appointment/FinalConfirm">
            <div class="mb-3">
                <label class="form-label fw-semibold text-secondary">Cardholder Name</label>
                <input type="text"
                       name="CardHolderName"
                       class="form-control"
                       placeholder="e.g. RAHIM UDDIN"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold text-secondary">Card Number</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-credit-card"></i></span>
                    <input type="text"
                           name="PaymentNumber"
                           class="form-control border-start-0"
                           placeholder="0000 0000 0000 0000"
                           maxlength="19"
                           required />
                </div>
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label class="form-label fw-semibold text-secondary">Expiration</label>
                    <input type="text"
                           name="CardExpiry"
                           class="form-control"
                           placeholder="MM/YY"
                           maxlength="5"
                           required />
                </div>
                <div class="col-6 mb-3">
                    <label class="form-label fw-semibold text-secondary">CVV</label>
                    <input type="password"
                           name="CardCVV"
                           class="form-control"
                           placeholder="123"
                           maxlength="3"
                           required />
                </div>
            </div>

            <div class="mb-4 text-center text-xs text-muted">
                Your transaction is protected by secure 3D-Secure simulation protocols.
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2.5 text-white fw-bold rounded-3" style="background-color: #3f51b5; border-color: #3f51b5; font-size: 1rem; box-shadow: 0 4px 15px rgba(63, 81, 181, 0.3);">
                <i class="bi bi-shield-check me-2"></i>Confirm Payment
            </button>
        </form>
    </div>
</div>
