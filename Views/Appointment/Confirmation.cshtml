@* Razor View: Appointment/Confirmation *@
<!-- HTML View: Appointment/Confirmation -->
@{
    Layout = "_Layout";
    ViewData["Title"] = "Booking Confirmed";
}
<!-- CSS Style Block -->
        <style>
    
    .confirm-wrapper {
        min-height: 80vh;
        display: flex; align-items: center; justify-content: center;
        padding: 3rem 1rem;
        background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
    }

    .confirm-card {
        background: white;
        border-radius: 24px;
        box-shadow: 0 25px 70px rgba(0,0,0,.1);
        padding: 3rem 2.5rem;
        max-width: 560px; width: 100%;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .confirm-card::before {
        content: '';
        position: absolute; top: 0; left: 0; right: 0;
        height: 6px;
        background: linear-gradient(90deg, #10b981, #34d399, #6ee7b7);
    }

    .success-icon {
        width: 90px; height: 90px; border-radius: 50%;
        background: linear-gradient(135deg, #10b981, #34d399);
        display: flex; align-items: center; justify-content: center;
        font-size: 2.8rem; color: white;
        margin: 0 auto 1.5rem;
        box-shadow: 0 10px 30px rgba(16,185,129,.35);
        animation: popIn .5s cubic-bezier(.175,.885,.32,1.275);
    }
    @@keyframes popIn {
        0%   { transform: scale(0); opacity: 0; }
        60%  { transform: scale(1.15); }
        100% { transform: scale(1); opacity: 1; }
    }

    .confirm-title { font-size: 1.7rem; font-weight: 800; color: #1e293b; margin-bottom: .4rem; }
    .confirm-sub   { color: #64748b; margin-bottom: 2rem; font-size: .95rem; }

    .appt-id-badge {
        display: inline-block;
        background: linear-gradient(135deg,#f0fdf4,#dcfce7);
        border: 2px solid #bbf7d0; color: #059669;
        border-radius: 30px; padding: .35rem 1.25rem;
        font-size: .85rem; font-weight: 700;
        margin-bottom: 2rem;
        letter-spacing: .03em;
    }

    .detail-grid {
        background: #f8fafc; border-radius: 16px;
        padding: 1.5rem; margin-bottom: 2rem;
        text-align: left;
    }
    .detail-row {
        display: flex; align-items: flex-start;
        gap: 1rem; padding: .7rem 0;
        border-bottom: 1px solid #f1f5f9;
    }
    .detail-row:last-child { border-bottom: none; padding-bottom: 0; }
    .detail-icon {
        width: 38px; height: 38px; border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1rem; flex-shrink: 0;
    }
    .detail-icon.green  { background: #dcfce7; color: #16a34a; }
    .detail-icon.blue   { background: #dbeafe; color: #2563eb; }
    .detail-icon.purple { background: #ede9fe; color: #7c3aed; }
    .detail-icon.orange { background: #ffedd5; color: #ea580c; }
    .detail-label { font-size: .75rem; color: #94a3b8; font-weight: 500; text-transform: uppercase; letter-spacing: .05em; }
    .detail-value { font-weight: 600; color: #1e293b; font-size: .95rem; }

    .status-pending {
        display: inline-flex; align-items: center; gap: .4rem;
        background: #fff7ed; color: #c2410c;
        border-radius: 20px; padding: .2rem .8rem;
        font-size: .78rem; font-weight: 600;
    }
    .status-dot {
        width: 7px; height: 7px; border-radius: 50%;
        background: #f97316; animation: pulse 1.5s infinite;
    }
    @@keyframes pulse {
        0%,100% { opacity: 1; }
        50%      { opacity: .4; }
    }

    .action-buttons { display: flex; gap: 1rem; flex-wrap: wrap; }
    .btn-dashboard {
        flex: 1; background: linear-gradient(135deg,#10b981,#34d399);
        color: white; border: none; border-radius: 12px;
        padding: .85rem 1.5rem; font-weight: 700; font-size: .95rem;
        transition: all .3s; cursor: pointer;
        display: flex; align-items: center; justify-content: center; gap: .5rem;
        text-decoration: none;
    }
    .btn-dashboard:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(16,185,129,.4); color: white;
    }
    .btn-book-another {
        flex: 1; background: white; color: #374151;
        border: 2px solid #e2e8f0; border-radius: 12px;
        padding: .85rem 1.5rem; font-weight: 600; font-size: .95rem;
        transition: all .3s; cursor: pointer;
        display: flex; align-items: center; justify-content: center; gap: .5rem;
        text-decoration: none;
    }
    .btn-book-another:hover {
        border-color: #10b981; color: #10b981;
        transform: translateY(-2px);
    }

    .confetti-strip {
        display: flex; justify-content: center; gap: .5rem;
        margin-bottom: 1.5rem;
    }
    .confetti-dot {
        width: 10px; height: 10px; border-radius: 50%;
        animation: bounce 1s infinite alternate;
    }
    .confetti-dot:nth-child(1) { background:#10b981; animation-delay:0s; }
    .confetti-dot:nth-child(2) { background:#6ee7b7; animation-delay:.15s; }
    .confetti-dot:nth-child(3) { background:#34d399; animation-delay:.3s; }
    .confetti-dot:nth-child(4) { background:#a7f3d0; animation-delay:.45s; }
    .confetti-dot:nth-child(5) { background:#10b981; animation-delay:.6s; }
    @@keyframes bounce {
        from { transform: translateY(0); }
        to   { transform: translateY(-8px); }
    }
</style>

<div class="confirm-wrapper">
    <div class="confirm-card">

        <div class="confetti-strip">
            <div class="confetti-dot"></div>
            <div class="confetti-dot"></div>
            <div class="confetti-dot"></div>
            <div class="confetti-dot"></div>
            <div class="confetti-dot"></div>
        </div>

        <div class="success-icon">
            <i class="bi bi-check-lg"></i>
        </div>

        <div class="confirm-title">Appointment Booked!</div>
        <p class="confirm-sub">Your appointment has been successfully scheduled.<br>
            You will receive a confirmation shortly.</p>

        <div class="appt-id-badge">
            <i class="bi bi-hash me-1"></i>Appointment ID: @ViewBag.AppointmentId
        </div>

        <div class="detail-grid">

            <div class="detail-row">
                <div class="detail-icon green"><i class="bi bi-person-badge"></i></div>
                <div>
                    <div class="detail-label">Doctor</div>
                    <div class="detail-value">@ViewBag.DoctorName</div>
                    <div style="font-size:.8rem;color:#64748b;">@ViewBag.Specialization</div>
                </div>
            </div>

            <div class="detail-row">
                <div class="detail-icon blue"><i class="bi bi-calendar3"></i></div>
                <div>
                    <div class="detail-label">Date</div>
                    <div class="detail-value">@ViewBag.Date</div>
                </div>
            </div>

            <div class="detail-row">
                <div class="detail-icon purple"><i class="bi bi-clock"></i></div>
                <div>
                    <div class="detail-label">Time Slot</div>
                    <div class="detail-value">@ViewBag.TimeSlot</div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(ViewBag.Reason?.ToString()))
            {
                <div class="detail-row">
                    <div class="detail-icon orange"><i class="bi bi-clipboard2-pulse"></i></div>
                    <div>
                        <div class="detail-label">Reason for Visit</div>
                        <div class="detail-value">@ViewBag.Reason</div>
                    </div>
                </div>
            }

            <div class="detail-row">
                <div class="detail-icon" style="background:#dcfce7;color:#16a34a;"><i class="bi bi-shield-check"></i></div>
                <div>
                    <div class="detail-label">Payment & Booking Status</div>
                    <div class="detail-value">
                        <span class="badge bg-success px-2.5 py-1.5" style="font-size: 0.82rem;">
                            <i class="bi bi-check-circle-fill me-1"></i>Confirmed &amp; Paid (@ViewBag.PaymentMethod)
                        </span>
                    </div>
                </div>
            </div>

            <div class="detail-row">
                <div class="detail-icon" style="background:#ede9fe;color:#7c3aed;"><i class="bi bi-person-heart"></i></div>
                <div>
                    <div class="detail-label">Doctor Consultation Fee</div>
                    <div class="detail-value" style="color:#7c3aed;">৳ @ViewBag.DoctorFee</div>
                </div>
            </div>

            <div class="detail-row">
                <div class="detail-icon" style="background:#e0f2fe;color:#0284c7;"><i class="bi bi-ticket-perforated-fill"></i></div>
                <div>
                    <div class="detail-label">Hospital Ticket / Booking Fee</div>
                    <div class="detail-value" style="color:#0284c7;">৳ @ViewBag.TicketFee</div>
                </div>
            </div>

            <div class="detail-row" style="background: #f0fdf4; border-radius: 12px; padding: 0.85rem 1rem;">
                <div class="detail-icon" style="background:#22c55e;color:#ffffff;"><i class="bi bi-wallet2"></i></div>
                <div>
                    <div class="detail-label" style="color:#15803d;font-weight:700;">Total Paid Amount</div>
                    <div class="detail-value" style="color:#15803d;font-size:1.15rem;font-weight:800;">৳ @ViewBag.TotalAmount</div>
                </div>
            </div>

        </div>

        <div class="action-buttons">
            <a href="/Patient/Dashboard" class="btn-dashboard">
                <i class="bi bi-speedometer2"></i>Go to Dashboard
            </a>
            <a href="/Appointment/Book" class="btn-book-another">
                <i class="bi bi-plus-circle"></i>Book Another
            </a>
        </div>

    </div>
</div>

