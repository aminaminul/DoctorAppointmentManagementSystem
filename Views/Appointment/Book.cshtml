@{
    Layout = "_Layout";
    ViewData["Title"] = "Book Appointment";
}

<style>
    
    .booking-hero {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 3rem 0 5rem;
        color: white;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .booking-hero::before {
        content: '';
        position: absolute; inset: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Ccircle cx='30' cy='30' r='20'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
        pointer-events: none;
    }
    .booking-hero h1 { font-size: 2.2rem; font-weight: 700; margin-bottom: .5rem; }
    .booking-hero p  { opacity: .85; font-size: 1.05rem; }

    .booking-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0,0,0,.12);
        padding: 2.5rem;
        margin-top: -3rem;
        position: relative;
        z-index: 10;
    }

    .steps-bar {
        display: flex;
        justify-content: center;
        gap: 0;
        margin-bottom: 2.5rem;
    }
    .step-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        flex: 1;
        max-width: 180px;
    }
    .step-item:not(:last-child)::after {
        content: '';
        position: absolute;
        top: 20px; left: 50%;
        width: 100%; height: 2px;
        background: #e2e8f0;
        z-index: 0;
        transition: background .4s;
    }
    .step-item.done:not(:last-child)::after { background: #667eea; }
    .step-bubble {
        width: 42px; height: 42px;
        border-radius: 50%;
        background: #e2e8f0;
        color: #94a3b8;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: .95rem;
        position: relative; z-index: 1;
        transition: all .3s;
    }
    .step-item.active  .step-bubble { background: #667eea; color: white; box-shadow: 0 0 0 4px rgba(102,126,234,.25); }
    .step-item.done    .step-bubble { background: #10b981; color: white; }
    .step-label { font-size: .75rem; color: #64748b; margin-top: .4rem; font-weight: 500; }
    .step-item.active  .step-label { color: #667eea; font-weight: 600; }
    .step-item.done    .step-label { color: #10b981; }

    .section-title {
        font-size: 1rem; font-weight: 600; color: #1e293b;
        margin-bottom: 1rem;
        display: flex; align-items: center; gap: .5rem;
    }
    .section-title i { color: #667eea; }

    .form-label { font-weight: 600; font-size: .875rem; color: #374151; margin-bottom: .4rem; }
    .form-select, .form-control {
        border-radius: 12px !important;
        border: 2px solid #e2e8f0 !important;
        padding: .7rem 1rem !important;
        font-size: .9rem;
        transition: border-color .25s, box-shadow .25s !important;
    }
    .form-select:focus, .form-control:focus {
        border-color: #667eea !important;
        box-shadow: 0 0 0 3px rgba(102,126,234,.15) !important;
        outline: none !important;
    }

    .doctor-card {
        border: 2px solid #e2e8f0;
        border-radius: 16px;
        padding: 1.25rem;
        display: none;
        background: linear-gradient(135deg, #f8faff 0%, #ffffff 100%);
        transition: all .3s;
        animation: slideIn .3s ease;
    }
    .doctor-card.show { display: flex; align-items: center; gap: 1.25rem; }
    .doctor-avatar {
        width: 72px; height: 72px; border-radius: 50%;
        object-fit: cover;
        border: 3px solid white;
        box-shadow: 0 4px 12px rgba(0,0,0,.12);
        flex-shrink: 0;
        background: #e2e8f0;
        display: flex; align-items: center; justify-content: center;
        font-size: 2rem; color: #667eea;
        overflow: hidden;
    }
    .doctor-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .doc-badge {
        display: inline-block;
        background: rgba(102,126,234,.1); color: #667eea;
        border-radius: 20px; padding: .2rem .75rem;
        font-size: .75rem; font-weight: 600;
        margin-bottom: .4rem;
    }
    .doc-stats { display: flex; gap: 1.5rem; margin-top: .5rem; }
    .doc-stat { font-size: .8rem; color: #64748b; }
    .doc-stat strong { color: #1e293b; display: block; font-size: .95rem; }

    .alert-booking {
        border-radius: 12px;
        border-left: 4px solid #ef4444;
        background: #fef2f2;
        color: #b91c1c;
        padding: .85rem 1.2rem;
        display: flex; align-items: center; gap: .6rem;
        margin-bottom: 1.5rem;
    }

    .btn-book {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white; border: none;
        border-radius: 12px; padding: .85rem 2rem;
        font-weight: 600; font-size: 1rem;
        width: 100%; margin-top: 1.5rem;
        transition: all .3s; cursor: pointer;
        display: flex; align-items: center; justify-content: center; gap: .6rem;
    }
    .btn-book:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(102,126,234,.45);
        color: white;
    }
    .btn-book:disabled { opacity: .6; transform: none; box-shadow: none; cursor: not-allowed; }

    .form-divider { height: 1px; background: #f1f5f9; margin: 1.5rem 0; }

    @@keyframes slideIn {
        from { opacity: 0; transform: translateY(-10px); }
        to   { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="booking-hero">
    <div class="container">
        <h1><i class="bi bi-calendar-heart me-2"></i>Book an Appointment</h1>
        <p>Select your department, doctor, preferred date &amp; time</p>
    </div>
</div>

<div class="container" style="max-width: 720px;">
    <div class="booking-card">

        @if (TempData["Error"] != null)
        {
            <div class="alert-booking">
                <i class="bi bi-exclamation-circle-fill"></i>
                @TempData["Error"]
            </div>
        }

        <div class="steps-bar">
            <div class="step-item active" id="stepItem1">
                <div class="step-bubble">1</div>
                <span class="step-label">Select Doctor</span>
            </div>
            <div class="step-item" id="stepItem2">
                <div class="step-bubble">2</div>
                <span class="step-label">Pick Date</span>
            </div>
            <div class="step-item" id="stepItem3">
                <div class="step-bubble">3</div>
                <span class="step-label">Time Slot</span>
            </div>
        </div>

        <form method="get" action="/Appointment/SelectTime" id="bookingForm">

            <div class="section-title">
                <i class="bi bi-hospital"></i>Department &amp; Doctor
            </div>

            <div class="mb-3">
                <label class="form-label" for="department">
                    <i class="bi bi-grid-3x3-gap me-1 text-muted"></i>Department
                </label>
                <select id="department" class="form-select" required>
                    <option value="">â€” Select a Department â€”</option>
                    @foreach (var dept in ViewBag.Departments)
                    {
                        <option value="@dept">@dept</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label" for="doctor">
                    <i class="bi bi-person-badge me-1 text-muted"></i>Doctor
                </label>
                <select id="doctor" name="doctorId" class="form-select" required disabled>
                    <option value="">â€” Select a Department first â€”</option>
                </select>
            </div>

            <div class="doctor-card mb-3" id="doctorCard">
                <div class="doctor-avatar" id="doctorAvatarWrap">
                    <i class="bi bi-person-circle"></i>
                </div>
                <div>
                    <span class="doc-badge" id="docSpec"></span>
                    <div style="font-weight:700;font-size:1.05rem;color:#1e293b;" id="docName"></div>
                    <div class="doc-stats">
                        <div class="doc-stat">
                            <strong id="docExp"></strong>
                            Experience
                        </div>
                        <div class="doc-stat">
                            <strong id="docFee"></strong>
                            Consultation Fee
                        </div>
                        <div class="doc-stat">
                            <strong id="docDays"></strong>
                            Available Days
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-divider"></div>

            <div class="section-title">
                <i class="bi bi-calendar3"></i>Appointment Date
            </div>

            <div class="mb-3">
                <label class="form-label" for="dateInput">
                    <i class="bi bi-calendar-event me-1 text-muted"></i>Select Date
                </label>
                <input type="date"
                       id="dateInput"
                       name="date"
                       class="form-control"
                       min="@DateTime.Now.ToString("yyyy-MM-dd")"
                       required />
            </div>

            <div class="form-divider"></div>

            <div class="section-title">
                <i class="bi bi-clipboard2-pulse"></i>Reason for Visit <span style="font-weight:400;color:#94a3b8;font-size:.85rem;">(optional)</span>
            </div>

            <div class="mb-3">
                <label class="form-label" for="reason">
                    <i class="bi bi-chat-text me-1 text-muted"></i>Describe your symptoms or reason
                </label>
                <textarea id="reason"
                          name="reason"
                          class="form-control"
                          rows="3"
                          placeholder="e.g. Chest pain, fever for 3 days, routine check-up..."></textarea>
            </div>

            <div class="section-title">
                <i class="bi bi-exclamation-triangle"></i>Booking Priority
            </div>
            
            <div class="mb-4">
                <div class="form-check form-switch p-3 bg-light rounded-3 shadow-sm border d-flex align-items-center justify-content-between">
                    <div class="me-3">
                        <label class="form-check-label fw-bold text-danger mb-0" for="isEmergencySwitch">
                            ðŸš¨ Emergency Priority
                        </label>
                        <div class="text-muted small">Check this if you require urgent care. You will be prioritized at the front of the live queue.</div>
                    </div>
                    <input class="form-check-input me-1" type="checkbox" id="isEmergencySwitch" style="width: 2.4em; height: 1.2em;">
                </div>
            </div>

            <input type="hidden" name="reason" id="reasonHidden" />
            <input type="hidden" name="isEmergency" id="isEmergencyHidden" value="false" />

            <button type="submit" class="btn-book" id="nextBtn" disabled>
                <i class="bi bi-arrow-right-circle-fill"></i>
                Next â€” Choose Time Slot
            </button>

        </form>
    </div>
</div>

@section Scripts {
<script>
    const departmentSel = document.getElementById('department');
    const doctorSel     = document.getElementById('doctor');
    const dateInput     = document.getElementById('dateInput');
    const doctorCard    = document.getElementById('doctorCard');
    const nextBtn       = document.getElementById('nextBtn');
    const reasonArea    = document.getElementById('reason');

    function checkReady() {
        const ok = doctorSel.value !== '' && dateInput.value !== '';
        nextBtn.disabled = !ok;
        if (ok) {
            document.getElementById('stepItem2').classList.add('active');
            document.getElementById('stepItem2').classList.add('done');
        }
    }

    departmentSel.addEventListener('change', function () {
        const dept = this.value;
        doctorSel.innerHTML = '<option value="">â€” Loading doctors... â€”</option>';
        doctorSel.disabled = true;
        doctorCard.classList.remove('show');
        nextBtn.disabled = true;

        if (!dept) {
            doctorSel.innerHTML = '<option value="">â€” Select a Department first â€”</option>';
            return;
        }

        fetch('/Appointment/GetDoctorsByDepartment?department=' + encodeURIComponent(dept))
            .then(r => r.json())
            .then(data => {
                doctorSel.innerHTML = '<option value="">â€” Select a Doctor â€”</option>';
                data.forEach(doc => {
                    const opt = document.createElement('option');
                    opt.value = doc.id;
                    opt.text  = doc.name;
                    opt.dataset.spec      = doc.specialization;
                    opt.dataset.exp       = doc.experience;
                    opt.dataset.fee       = doc.fee;
                    opt.dataset.image     = doc.profileImage;
                    opt.dataset.days      = doc.availableDays;
                    doctorSel.appendChild(opt);
                });
                doctorSel.disabled = false;
            });
    });

    doctorSel.addEventListener('change', function () {
        const opt = this.options[this.selectedIndex];
        if (!opt.value) { doctorCard.classList.remove('show'); checkReady(); return; }

        document.getElementById('docName').textContent = opt.text;
        document.getElementById('docSpec').textContent = opt.dataset.spec;
        document.getElementById('docExp').textContent  = opt.dataset.exp + ' yrs';
        document.getElementById('docFee').textContent  = 'à§³ ' + opt.dataset.fee;
        document.getElementById('docDays').textContent = opt.dataset.days || 'Varies';

        const avatarWrap = document.getElementById('doctorAvatarWrap');
        const imgSrc = opt.dataset.image;
        if (imgSrc && imgSrc !== 'doctor_default.png') {
            avatarWrap.innerHTML = `<img src="/images/${imgSrc}" onerror="this.parentElement.innerHTML='<i class=\\'bi bi-person-circle\\'></i>'" />`;
        } else {
            avatarWrap.innerHTML = '<i class="bi bi-person-circle"></i>';
        }

        doctorCard.classList.add('show');
        document.getElementById('stepItem1').classList.add('done');
        document.getElementById('stepItem1').classList.remove('active');
        checkReady();
    });

    dateInput.addEventListener('change', function () {
        document.getElementById('stepItem2').classList.add('active');
        checkReady();
    });

    document.getElementById('bookingForm').addEventListener('submit', function (e) {
        document.getElementById('reasonHidden').value = reasonArea.value;
        document.getElementById('isEmergencyHidden').value = document.getElementById('isEmergencySwitch').checked ? "true" : "false";
        document.getElementById('stepItem3').classList.add('active');
    });
</script>
}
