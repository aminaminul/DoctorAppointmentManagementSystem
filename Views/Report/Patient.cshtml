@* Razor View: Report/Patient *@
<!-- HTML View: Report/Patient -->
@model IEnumerable<DoctorAppointmentManagementSystem.Models.Patient>

@{
    ViewData["Title"] = "Patient Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Patient Report</h2>
</div>
<!-- Data Table Block -->
        <table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Age</th>
            <th>Gender</th>
            <th>Blood Group</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.User?.Username</td>
                <td>@item.User?.Email</td>
                <td>@(item.User?.PhoneNumber ?? "N/A")</td>
                <td>@item.Age</td>
                <td>@item.Gender</td>
                <td>@(string.IsNullOrEmpty(item.BloodGroup) ? "N/A" : item.BloodGroup)</td>
                <td>
                    <span class="badge @(item.ActiveStatus ? "bg-success" : "bg-danger")">
                        @(item.ActiveStatus ? "Active" : "Inactive")
                    </span>
                </td>
            </tr>
        }
    </tbody>
</table>

