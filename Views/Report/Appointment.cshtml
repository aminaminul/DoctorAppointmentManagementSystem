@model IEnumerable<DoctorAppointmentManagementSystem.Models.Appointment>

@{
    ViewData["Title"] = "Appointment Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Appointment Report</h2>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Date</th>
            <th>Time</th>
            <th>Patient</th>
            <th>Doctor</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.AppointmentDate.ToShortDateString()</td>
                <td>@item.AppointmentTime</td>
                <td>@item.Patient?.User?.Username</td>
                <td>Dr. @item.Doctor?.User?.Username</td>
                <td>
                    <span class="badge @(item.AppointmentStatus == "Completed" ? "bg-success" : (item.AppointmentStatus == "Pending" ? "bg-warning text-dark" : "bg-primary"))">
                        @item.AppointmentStatus
                    </span>
                </td>
            </tr>
        }
    </tbody>
</table>
