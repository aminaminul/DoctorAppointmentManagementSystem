@{
    var userRole = ViewData["UserRole"] as string ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    Func<string, bool> active = route => string.Equals((ViewContext.RouteData.Values["controller"] ?? "").ToString(), route, StringComparison.OrdinalIgnoreCase);
    Func<string, string, bool> activeAction = (route, action) => active(route) && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
}

<style>
    .triangle-bg {
        background-color: #4DA8DA;
        color: #fff;
        padding: 2px 10px;
        clip-path: polygon(0% 0%, 90% 0%, 100% 50%, 90% 100%, 0% 100%);
        display: inline-block;
        border-radius: 4px 0 0 4px;
    }
</style>

<nav class="d-flex flex-column p-4 dams-sidebar-nav" style="background-color:#0b1727; color:#FFFFFF; min-height: 100vh; height: 100%;">
    <ul class="nav nav-pills flex-column mb-auto">

        <li class="nav-item mb-1">
            <a class="nav-link d-flex align-items-center text-white" asp-controller="Admin" asp-action="Dashboard">
                <i class="bi bi-speedometer2 me-2"></i>
                <span class="@(active("Admin") && Context.Request.Query["section"].ToString() == "" && currentAction == "Dashboard" ? "triangle-bg" : "")">Overview</span>
            </a>
        </li>

        @if (userRole == "admin")
        {
            <li class="nav-item mb-1">
                <a class="nav-link d-flex align-items-center text-white" asp-controller="Admin" asp-action="Doctors">
                    <i class="bi bi-person-badge me-2"></i>
                    <span class="@(activeAction("Admin", "Doctors") ? "triangle-bg" : "")">Doctors</span>
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link d-flex align-items-center text-white" asp-controller="Admin" asp-action="Patients">
                    <i class="bi bi-person-lines-fill me-2"></i>
                    <span class="@(activeAction("Admin", "Patients") ? "triangle-bg" : "")">Patients</span>
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link d-flex align-items-center text-white" asp-controller="Pharmacy" asp-action="Index">
                    <i class="bi bi-capsule me-2"></i>
                    <span class="@(active("Pharmacy") ? "triangle-bg" : "")">Pharmacy</span>
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link d-flex align-items-center text-white" asp-controller="Laboratory" asp-action="Tests">
                    <i class="bi bi-droplet me-2"></i>
                    <span class="@(activeAction("Laboratory", "Tests") ? "triangle-bg" : "")">Laboratory Tests</span>
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link d-flex align-items-center text-white" asp-controller="Laboratory" asp-action="Reports">
                    <i class="bi bi-file-earmark-medical me-2"></i>
                    <span class="@(activeAction("Laboratory", "Reports") ? "triangle-bg" : "")">Lab Reports</span>
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link d-flex align-items-center text-white" asp-controller="Admin" asp-action="LeaveRequests">
                    <i class="bi bi-calendar-minus me-2"></i>
                    <span class="@(activeAction("Admin", "LeaveRequests") ? "triangle-bg" : "")">Leave Requests</span>
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link d-flex align-items-center text-white" asp-controller="Admin" asp-action="Complaints">
                    <i class="bi bi-chat-left-text me-2"></i>
                    <span class="@(activeAction("Admin", "Complaints") ? "triangle-bg" : "")">Complaints</span>
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link d-flex align-items-center text-white" asp-controller="Admin" asp-action="Invoices">
                    <i class="bi bi-receipt me-2"></i>
                    <span class="@(activeAction("Admin", "Invoices") ? "triangle-bg" : "")">Invoices</span>
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link d-flex align-items-center text-white" asp-controller="Report" asp-action="Revenue">
                    <i class="bi bi-bar-chart me-2"></i>
                    <span class="@(active("Report") ? "triangle-bg" : "")">Reports</span>
                </a>
            </li>
        }
        else if (userRole == "doctor")
        {
            <li class="nav-item mb-1">
                <a class="nav-link d-flex align-items-center text-white" asp-controller="Doctor" asp-action="Dashboard">
                    <i class="bi bi-calendar-check-fill me-2"></i>
                    <span class="@(activeAction("Doctor", "Dashboard") ? "triangle-bg" : "")">My Appointments</span>
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link d-flex align-items-center text-white" asp-controller="Doctor" asp-action="Schedule">
                    <i class="bi bi-clock-fill me-2"></i>
                    <span class="@(activeAction("Doctor", "Schedule") ? "triangle-bg" : "")">Schedule</span>
                </a>
            </li>
        }
        else if (userRole == "patient")
        {
            <li class="nav-item mb-1">
                <a class="nav-link d-flex align-items-center text-white" asp-controller="Patient" asp-action="Dashboard">
                    <i class="bi bi-journal-medical me-2"></i>
                    <span class="@(activeAction("Patient", "Dashboard") ? "triangle-bg" : "")">My Appointments</span>
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link d-flex align-items-center text-white" asp-controller="Patient" asp-action="Prescriptions">
                    <i class="bi bi-prescription me-2"></i>
                    <span class="@(activeAction("Patient", "Prescriptions") ? "triangle-bg" : "")">Prescriptions</span>
                </a>
            </li>
        }

        <li class="nav-item mt-3">
            <a class="nav-link text-white d-flex align-items-center" href="/Account/Logout">
                <i class="bi bi-box-arrow-right me-2"></i> Logout
            </a>
        </li>

    </ul>
</nav>
