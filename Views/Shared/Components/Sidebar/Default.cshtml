@{
    var controller = ViewData["controller"]?.ToString() ?? "";
    var role = (ViewData["role"] as string ?? "").ToLowerInvariant();
    var userRole = (ViewData["UserRole"] as string ?? ViewData["role"] as string ?? "").ToLowerInvariant();
    var username = ViewData["Username"] as string ?? ViewData["username"] as string ?? "";
}

<aside class="col-12 col-md-3 col-lg-2 p-0 d-none d-md-block" style="background-color:#1F1F1F; min-height:100vh;">
    <div class="px-3 pt-4">
        <div class="text-white mb-4 ps-2">
            <h5 class="mb-0">DAMS</h5>
            <small class="text-muted">Doctor Appointment Management</small>
            @if (!string.IsNullOrEmpty(username))
            {
                <div class="small text-muted mt-1">
                    @username @if (!string.IsNullOrEmpty(userRole)) { <span>&middot; @userRole</span> }
                </div>
            }
        </div>

        @* Admin Menu *@
        @if (role == "admin")
        {
            <ul class="nav nav-pills flex-column gap-1">
                <li class="nav-item">
                    <a class="nav-link text-white d-flex align-items-center gap-2 rounded-3 @(controller == "Admin" ? "active" : "")" href="/Admin/Dashboard">
                        <i class="bi bi-speedometer2"></i> Admin Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white d-flex align-items-center gap-2 rounded-3" href="/Admin/Dashboard?section=doctors">
                        <i class="bi bi-person-badge"></i> Manage Doctors
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white d-flex align-items-center gap-2 rounded-3" href="/Admin/Dashboard?section=patients">
                        <i class="bi bi-people"></i> Manage Patients
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white d-flex align-items-center gap-2 rounded-3" href="/Admin/Dashboard?section=appointments">
                        <i class="bi bi-calendar-check"></i> Appointments
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white d-flex align-items-center gap-2 rounded-3 @(controller == "Admin" ? "active" : "")" href="/Admin/EditPrivacy">
                        <i class="bi bi-file-text"></i> Edit Privacy Policy
                    </a>
                </li>
                <li class="nav-item mt-3">
                    <a class="btn btn-sm w-100 text-white" style="background-color:#4DA8DA;" href="/Admin/AddDoctor">New Doctor</a>
                </li>
            </ul>
        }

        @* Doctor Menu *@
        else if (role == "doctor")
        {
            <ul class="nav nav-pills flex-column gap-1">
                <li class="nav-item">
                    <a class="nav-link text-white d-flex align-items-center gap-2 rounded-3 @(controller == "Doctor" ? "active" : "")" href="/Doctor/Dashboard">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white d-flex align-items-center gap-2 rounded-3" href="/Doctor/Dashboard?section=appointments">
                        <i class="bi bi-calendar-check"></i> Appointments
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white d-flex align-items-center gap-2 rounded-3" href="/Doctor/Dashboard?section=queue">
                        <i class="bi bi-people-fill"></i> Live Queue
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white d-flex align-items-center gap-2 rounded-3" href="/Doctor/Schedule">
                        <i class="bi bi-calendar3"></i> My Schedule
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white d-flex align-items-center gap-2 rounded-3" href="/EMR/Index">
                        <i class="bi bi-folder-fill"></i> Patient EMR
                    </a>
                </li>
                <li class="nav-item mt-3">
                    <a class="btn btn-sm w-100 text-white" style="background-color:#4DA8DA;" href="/Doctor/Dashboard?section=profile">My Profile</a>
                </li>
            </ul>
        }

        @* Patient / Public Menu *@
        else
        {
            <ul class="nav nav-pills flex-column gap-1">
                <li class="nav-item">
                    <a class="nav-link text-white d-flex align-items-center gap-2 rounded-3 @(controller == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index" style="background-color:transparent;border:none;">
                        <i class="bi bi-house"></i> Home
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white d-flex align-items-center gap-2 rounded-3 @(controller == "Appointment" ? "active" : "")" href="/Appointment/Book">
                        <i class="bi bi-calendar-plus"></i> Book Appointment
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white d-flex align-items-center gap-2 rounded-3 @(controller == "Patient" ? "active" : "")" href="/Patient/Dashboard">
                        <i class="bi bi-person-lines-fill"></i> My Appointments
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white d-flex align-items-center gap-2 rounded-3" href="/Patient/Prescriptions">
                        <i class="bi bi-file-medical"></i> Prescriptions
                    </a>
                </li>
                <li class="nav-item mt-3">
                    <a class="btn btn-sm w-100 text-white" style="background-color:#4DA8DA;" href="/Account/Login">Login</a>
                </li>
            </ul>
        }
    </div>
</aside>
