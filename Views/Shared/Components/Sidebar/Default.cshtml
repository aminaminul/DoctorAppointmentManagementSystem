@{
    var userRole = ViewData["UserRole"] as string ?? "";
    var username = ViewData["Username"] as string ?? "";
}

<nav class="col-12 col-md-3 col-lg-2 d-md-block bg-light sidebar collapse" id="sidebarMenu">
    <div class="position-sticky pt-3">
        <div class="px-3 mb-3">
            <div class="fw-bold">@username</div>
            <small class="text-muted">@userRole</small>
        </div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Overview</a>
            </li>

            @if (userRole == "admin")
            {
                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Dashboard">Admin Home</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Dashboard" asp-route-section="doctors">Doctors</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Dashboard" asp-route-section="patients">Patients</a></li>
            }
            else if (userRole == "doctor")
            {
                <li class="nav-item"><a class="nav-link" asp-controller="Doctor" asp-action="Dashboard">My Appointments</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Doctor" asp-action="Schedule">Schedule</a></li>
            }
            else if (userRole == "patient")
            {
                <li class="nav-item"><a class="nav-link" asp-controller="Patient" asp-action="Dashboard">My Appointments</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Patient" asp-action="Prescriptions">Prescriptions</a></li>
            }

            <li class="nav-item mt-3">
                <a class="nav-link text-danger" href="/Account/Logout">Logout</a>
            </li>
        </ul>
    </div>
</nav>
