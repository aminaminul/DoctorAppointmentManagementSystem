@{
    var userRole = ViewData["UserRole"] as string ?? "";
    var username = ViewData["Username"] as string ?? "";
    Func<string, bool> active = route => string.Equals((ViewContext.RouteData.Values["controller"] ?? "").ToString(), route, StringComparison.OrdinalIgnoreCase);
}

<nav class="d-flex flex-column vh-100 p-3" style="background-color:#1F1F1F; color:#FFFFFF;">
    <div class="mb-4">
        <div class="fw-bold fs-5 text-white">DAMS</div>
        <div class="small text-white-50">@username</div>
    </div>

    <ul class="nav nav-pills flex-column mb-auto">
        <li class="nav-item mb-1">
            <a class="nav-link d-flex align-items-center text-white @(active("Dashboard") ? "active" : "")"
               asp-controller="Dashboard" asp-action="Index" style="@(active("Dashboard") ? "background-color:#4DA8DA;color:#fff;" : "")">
                <i class="bi bi-speedometer2 me-2"></i> Overview
            </a>
        </li>

        @if (userRole == "admin")
        {
            <li class="nav-item mb-1">
                <a class="nav-link d-flex align-items-center text-white @(active("Admin") ? "active" : "")" asp-controller="Admin" asp-action="Dashboard" style="@(active("Admin") ? "background-color:#4DA8DA;color:#fff;" : "")">
                    <i class="bi bi-people-fill me-2"></i> Manage
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link d-flex align-items-center text-white" asp-controller="Admin" asp-action="Dashboard" asp-route-section="doctors" style="@(active("Admin") ? "background-color:#4DA8DA;color:#fff;" : "")">
                    <i class="bi bi-person-badge me-2"></i> Doctors
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link d-flex align-items-center text-white" asp-controller="Admin" asp-action="Dashboard" asp-route-section="patients" style="@(active("Admin") ? "background-color:#4DA8DA;color:#fff;" : "")">
                    <i class="bi bi-person-lines-fill me-2"></i> Patients
                </a>
            </li>
        }
        else if (userRole == "doctor")
        {
            <li class="nav-item mb-1">
                <a class="nav-link d-flex align-items-center text-white @(active("Doctor") ? "active" : "")" asp-controller="Doctor" asp-action="Dashboard" style="@(active("Doctor") ? "background-color:#4DA8DA;color:#fff;" : "")">
                    <i class="bi bi-calendar-check-fill me-2"></i> My Appointments
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link d-flex align-items-center text-white @(active("Doctor") ? "active" : "")" asp-controller="Doctor" asp-action="Schedule" style="@(active("Doctor") ? "background-color:#4DA8DA;color:#fff;" : "")">
                    <i class="bi bi-clock-fill me-2"></i> Schedule
                </a>
            </li>
        }
        else if (userRole == "patient")
        {
            <li class="nav-item mb-1">
                <a class="nav-link d-flex align-items-center text-white @(active("Patient") ? "active" : "")" asp-controller="Patient" asp-action="Dashboard" style="@(active("Patient") ? "background-color:#4DA8DA;color:#fff;" : "")">
                    <i class="bi bi-journal-medical me-2"></i> My Appointments
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link d-flex align-items-center text-white @(active("Patient") ? "active" : "")" asp-controller="Patient" asp-action="Prescriptions" style="@(active("Patient") ? "background-color:#4DA8DA;color:#fff;" : "")">
                    <i class="bi bi-prescription me-2"></i> Prescriptions
                </a>
            </li>
        }

        <li class="nav-item mt-3">
            <a class="nav-link text-white d-flex align-items-center" href="/Account/Logout">
                <i class="bi bi-box-arrow-right me-2"></i> Logout
            </a>
        </li>
    </ul>

    <div class="mt-auto small text-white-50">
        <div>© @DateTime.Now.Year DAMS</div>
    </div>
</nav>
