@* Razor View: Sidebar/Default *@
<!-- HTML View: Sidebar/Default -->
@{
    var userRole = ViewData["UserRole"] as string ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var currentSection = Context.Request.Query["section"].ToString().ToLower();
    Func<string, bool> active = route => string.Equals((ViewContext.RouteData.Values["controller"] ?? "").ToString(), route, StringComparison.OrdinalIgnoreCase);
    Func<string, string, bool> activeAction = (route, action) => active(route) && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
}

<style>
    .sidebar-slim-nav {
        background-color: #0b1727;
        color: #FFFFFF;
        height: 100%;
        min-height: 100%;
        display: flex;
        flex-direction: column;
        font-size: 0.85rem;
    }
    .sidebar-slim-nav .nav-link {
        color: rgba(255, 255, 255, 0.75);
        padding: 0.45rem 0.75rem;
        border-radius: 6px;
        margin-bottom: 2px;
        transition: all 0.15s ease-in-out;
        font-weight: 500;
        display: flex;
        align-items: center;
    }
    .sidebar-slim-nav .nav-link:hover {
        color: #ffffff;
        background-color: rgba(255, 255, 255, 0.08);
    }
    .sidebar-slim-nav .nav-link.active-item {
        color: #ffffff !important;
        background-color: #4DA8DA !important;
        font-weight: 600;
    }
    .sidebar-section-header {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: rgba(255,255,255,0.4);
        padding: 0.75rem 0.75rem 0.25rem 0.75rem;
        font-weight: 700;
    }
</style>

<nav class="sidebar-slim-nav p-2">
    <ul class="nav nav-pills flex-column mb-auto">

        @if (userRole == "admin")
        {
            <li class="sidebar-section-header">Admin Navigation</li>
            <li class="nav-item">
                <a class="nav-link @(activeAction("Admin", "Dashboard") ? "active-item" : "")" asp-controller="Admin" asp-action="Dashboard">
                    <i class="bi bi-speedometer2 me-2"></i> Overview
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(activeAction("Admin", "Appointments") ? "active-item" : "")" asp-controller="Admin" asp-action="Appointments">
                    <i class="bi bi-calendar-check me-2"></i> Appointments
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(activeAction("Admin", "Doctors") ? "active-item" : "")" asp-controller="Admin" asp-action="Doctors">
                    <i class="bi bi-person-badge me-2"></i> Doctors
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(activeAction("Admin", "Patients") ? "active-item" : "")" asp-controller="Admin" asp-action="Patients">
                    <i class="bi bi-person-lines-fill me-2"></i> Patients
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(activeAction("Admin", "Payments") ? "active-item" : "")" asp-controller="Admin" asp-action="Payments">
                    <i class="bi bi-wallet2 me-2"></i> Payments &amp; Ledger
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(activeAction("Admin", "Invoices") ? "active-item" : "")" asp-controller="Admin" asp-action="Invoices">
                    <i class="bi bi-receipt me-2"></i> Invoices
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(activeAction("Admin", "Queue") ? "active-item" : "")" asp-controller="Admin" asp-action="Queue">
                    <i class="bi bi-people-fill me-2"></i> Live Queue
                </a>
            </li>
            <li class="sidebar-section-header mt-2">Clinical &amp; Operations</li>
            <li class="nav-item">
                <a class="nav-link @(activeAction("Laboratory", "Tests") ? "active-item" : "")" asp-controller="Laboratory" asp-action="Tests">
                    <i class="bi bi-droplet me-2"></i> Lab Tests
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(activeAction("Laboratory", "Reports") ? "active-item" : "")" asp-controller="Laboratory" asp-action="Reports">
                    <i class="bi bi-file-earmark-medical me-2"></i> Lab Reports
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(active("Pharmacy") ? "active-item" : "")" asp-controller="Pharmacy" asp-action="Index">
                    <i class="bi bi-capsule me-2"></i> Pharmacy
                </a>
            </li>
            <li class="sidebar-section-header mt-2">Support &amp; Audit</li>
            <li class="nav-item">
                <a class="nav-link @(activeAction("Admin", "LeaveRequests") ? "active-item" : "")" asp-controller="Admin" asp-action="LeaveRequests">
                    <i class="bi bi-calendar-minus me-2"></i> Leave Requests
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(activeAction("Admin", "Complaints") ? "active-item" : "")" asp-controller="Admin" asp-action="Complaints">
                    <i class="bi bi-chat-left-text me-2"></i> Complaints
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(activeAction("Admin", "Logs") ? "active-item" : "")" asp-controller="Admin" asp-action="Logs">
                    <i class="bi bi-shield-check me-2"></i> Audit Logs
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(active("Report") ? "active-item" : "")" asp-controller="Report" asp-action="Revenue">
                    <i class="bi bi-bar-chart me-2"></i> Reports
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(activeAction("Admin", "EditPrivacy") ? "active-item" : "")" asp-controller="Admin" asp-action="EditPrivacy">
                    <i class="bi bi-shield-lock me-2"></i> Privacy Policy
                </a>
            </li>
        }
        else if (userRole == "doctor")
        {
            <li class="sidebar-section-header">Doctor Panel</li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "overview" || string.IsNullOrEmpty(currentSection) ? "active-item" : "")" asp-controller="Doctor" asp-action="Dashboard" asp-route-section="overview">
                    <i class="bi bi-speedometer2 me-2"></i> Overview
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "appointments" ? "active-item" : "")" asp-controller="Doctor" asp-action="Dashboard" asp-route-section="appointments">
                    <i class="bi bi-calendar-check me-2"></i> Appointments
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "schedule" ? "active-item" : "")" asp-controller="Doctor" asp-action="Dashboard" asp-route-section="schedule">
                    <i class="bi bi-clock me-2"></i> Schedule
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "patients" || currentSection == "emr" ? "active-item" : "")" asp-controller="Doctor" asp-action="Dashboard" asp-route-section="patients">
                    <i class="bi bi-people me-2"></i> Patients & EMR
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "prescriptions" ? "active-item" : "")" asp-controller="Doctor" asp-action="Dashboard" asp-route-section="prescriptions">
                    <i class="bi bi-prescription me-2"></i> Prescriptions
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "lab" ? "active-item" : "")" asp-controller="Doctor" asp-action="Dashboard" asp-route-section="lab">
                    <i class="bi bi-droplet me-2"></i> Laboratory
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "documents" ? "active-item" : "")" asp-controller="Doctor" asp-action="Dashboard" asp-route-section="documents">
                    <i class="bi bi-folder me-2"></i> Documents
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "followup" ? "active-item" : "")" asp-controller="Doctor" asp-action="Dashboard" asp-route-section="followup">
                    <i class="bi bi-arrow-repeat me-2"></i> Follow-up
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "certificates" ? "active-item" : "")" asp-controller="Doctor" asp-action="Dashboard" asp-route-section="certificates">
                    <i class="bi bi-award me-2"></i> Certificates
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "messages" ? "active-item" : "")" asp-controller="Doctor" asp-action="Dashboard" asp-route-section="messages">
                    <i class="bi bi-chat-dots me-2"></i> Messages
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "reviews" ? "active-item" : "")" asp-controller="Doctor" asp-action="Dashboard" asp-route-section="reviews">
                    <i class="bi bi-star me-2"></i> Reviews
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "earnings" ? "active-item" : "")" asp-controller="Doctor" asp-action="Dashboard" asp-route-section="earnings">
                    <i class="bi bi-cash-stack me-2"></i> Earnings
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "profile" ? "active-item" : "")" asp-controller="Doctor" asp-action="Dashboard" asp-route-section="profile">
                    <i class="bi bi-gear me-2"></i> Profile
                </a>
            </li>
        }
        else if (userRole == "patient" || userRole == "student")
        {
            <li class="sidebar-section-header">Patient Portal</li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "overview" || string.IsNullOrEmpty(currentSection) ? "active-item" : "")" asp-controller="Patient" asp-action="Dashboard" asp-route-section="overview">
                    <i class="bi bi-speedometer2 me-2"></i> Overview
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "appointments" ? "active-item" : "")" asp-controller="Patient" asp-action="Dashboard" asp-route-section="appointments">
                    <i class="bi bi-calendar-check me-2"></i> My Appointments
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "doctors" ? "active-item" : "")" asp-controller="Patient" asp-action="Dashboard" asp-route-section="doctors">
                    <i class="bi bi-search me-2"></i> Find Doctors
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "prescriptions" ? "active-item" : "")" asp-controller="Patient" asp-action="Dashboard" asp-route-section="prescriptions">
                    <i class="bi bi-prescription me-2"></i> Prescriptions
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "emr" ? "active-item" : "")" asp-controller="Patient" asp-action="Dashboard" asp-route-section="emr">
                    <i class="bi bi-journal-medical me-2"></i> Medical Journey
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "lab" ? "active-item" : "")" asp-controller="Patient" asp-action="Dashboard" asp-route-section="lab">
                    <i class="bi bi-droplet me-2"></i> Lab Reports
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "documents" ? "active-item" : "")" asp-controller="Patient" asp-action="Dashboard" asp-route-section="documents">
                    <i class="bi bi-cloud-upload me-2"></i> Medical Documents
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "payments" ? "active-item" : "")" asp-controller="Patient" asp-action="Dashboard" asp-route-section="payments">
                    <i class="bi bi-wallet2 me-2"></i> Online Payments
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "insurance" ? "active-item" : "")" asp-controller="Patient" asp-action="Dashboard" asp-route-section="insurance">
                    <i class="bi bi-shield-check me-2"></i> Insurance Info
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "messages" ? "active-item" : "")" asp-controller="Patient" asp-action="Dashboard" asp-route-section="messages">
                    <i class="bi bi-chat-dots me-2"></i> Doctor Messages
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "reviews" ? "active-item" : "")" asp-controller="Patient" asp-action="Dashboard" asp-route-section="reviews">
                    <i class="bi bi-star me-2"></i> Reviews & Ratings
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentSection == "profile" ? "active-item" : "")" asp-controller="Patient" asp-action="Dashboard" asp-route-section="profile">
                    <i class="bi bi-gear me-2"></i> Profile Settings
                </a>
            </li>
        }

        <li class="nav-item mt-4">
            <a class="nav-link text-danger" href="/Account/Logout">
                <i class="bi bi-box-arrow-right me-2"></i> Logout
            </a>
        </li>

    </ul>
</nav>
