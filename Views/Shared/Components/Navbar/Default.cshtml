@{
    var controller = ViewData["controller"]?.ToString() ?? "";
    var action = ViewData["action"]?.ToString() ?? "";
    var themeBg = "#4DA8DA"; // Light Blue primary
    var userName = ViewData["UserName"] as string ?? "";
    var userRole = (ViewData["UserRole"] as string ?? "").ToLowerInvariant();
}

<nav class="navbar navbar-expand-lg navbar-dark" style="background-color:@themeBg;">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center gap-2 text-white" asp-controller="Home" asp-action="Index">
            <i class="bi bi-hospital-fill fs-4"></i>
            <span class="fw-bold">DAMS</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNav"
                aria-controls="topNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="topNav">
            <form class="d-flex ms-3 me-auto" role="search" asp-controller="Home" asp-action="Index" method="get">
                <div class="input-group">
                    <input name="q" class="form-control form-control-sm rounded-pill" type="search" placeholder="Search"
                           aria-label="Search" />
                    <span class="input-group-text bg-white border-0 rounded-pill ms-1">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                </div>
            </form>

            <ul class="navbar-nav ms-auto align-items-center">
                <li class="nav-item me-3">
                    <a class="nav-link text-white position-relative" href="#">
                        <i class="bi bi-bell-fill"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">3</span>
                    </a>
                </li>

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle d-flex align-items-center text-white" href="#" id="userMenu" role="button"
                       data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="me-2 text-end d-none d-md-block">
                            <div class="fw-bold small mb-0">@userName</div>
                            <div class="small text-white-50">@userRole</div>
                        </div>
                        <div class="rounded-circle bg-white d-flex align-items-center justify-content-center" style="width:40px;height:40px;">
                            <i class="bi bi-person-fill" style="color:#4DA8DA"></i>
                        </div>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li><a class="dropdown-item" href="/Account/Profile"><i class="bi bi-person me-2"></i>Profile</a></li>
                        <li><a class="dropdown-item" href="/Account/Settings"><i class="bi bi-gear me-2"></i>Settings</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        @if (userRole == "admin") { <li><a class="dropdown-item" href="/Admin/Dashboard">Admin Dashboard</a></li> }
                        @if (userRole == "doctor") { <li><a class="dropdown-item" href="/Doctor/Dashboard">Doctor Dashboard</a></li> }
                        @if (userRole == "patient") { <li><a class="dropdown-item" href="/Patient/Dashboard">My Appointments</a></li> }
                        <li><a class="dropdown-item text-danger" href="/Account/Logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>
