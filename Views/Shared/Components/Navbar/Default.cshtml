@* Razor View: Navbar/Default *@
<!-- HTML View: Navbar/Default -->
@{
    var controller  = ViewData["controller"]?.ToString() ?? "";
    var action      = ViewData["action"]?.ToString() ?? "";
    var userName    = ViewData["UserName"] as string ?? "";
    var userRole    = (ViewData["UserRole"] as string ?? "").ToLowerInvariant();
    var isLoggedIn  = (bool)(ViewData["IsLoggedIn"] ?? false);
    var isHomePage  = controller.Equals("Home", StringComparison.OrdinalIgnoreCase)
                   && action.Equals("Index", StringComparison.OrdinalIgnoreCase);

    string avatarInitial = !string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "U";

    string dashboardUrl = userRole switch {
        "admin"   => "/Admin/Dashboard",
        "doctor"  => "/Doctor/Dashboard",
        "patient" => "/Patient/Dashboard",
        _         => "/"
    };
}
<!-- CSS Style Block -->
        <style>
    .dams-nav {
        background-color: #0b1727;
        box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        padding: 0.8rem 3rem !important;
        min-height: 76px;
        position: sticky;
        top: 0;
        z-index: 1030;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .dams-brand {
        font-size: 1.4rem;
        font-weight: 800;
        letter-spacing: 0.5px;
        color: #fff !important;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: opacity 0.2s;
    }
    .dams-brand:hover { opacity: 0.88; }

    .dams-brand-icon {
        width: 40px; height: 40px;
        background: rgba(255,255,255,0.05);
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.25rem;
        color: #4DA8DA;
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255,255,255,0.1);
    }

    .dams-nav-link {
        color: rgba(255,255,255,0.75) !important;
        font-weight: 600;
        font-size: 0.92rem;
        padding: 0.5rem 1rem !important;
        border-radius: 8px;
        transition: all 0.2s ease;
        text-decoration: none;
    }
    .dams-nav-link:hover {
        background: rgba(255,255,255,0.06);
        color: #4DA8DA !important;
    }
    .dams-nav-link.active-link {
        background: rgba(255,255,255,0.08);
        color: #4DA8DA !important;
        font-weight: 700;
    }

    .btn-nav-login {
        background: rgba(255,255,255,0.05);
        border: 1.5px solid rgba(255,255,255,0.2);
        color: #fff !important;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 7px 22px;
        border-radius: 24px;
        transition: all 0.22s;
        text-decoration: none;
    }
    .btn-nav-login:hover {
        background: rgba(255,255,255,0.12);
        border-color: rgba(255,255,255,0.4);
        color: #fff !important;
    }

    .btn-nav-register {
        background: #4DA8DA;
        border: 1.5px solid #4DA8DA;
        color: #ffffff !important;
        font-weight: 700;
        font-size: 0.85rem;
        padding: 7px 22px;
        border-radius: 24px;
        transition: all 0.22s;
        text-decoration: none;
    }
    .btn-nav-register:hover {
        background: #3a96c4;
        border-color: #3a96c4;
        color: #ffffff !important;
        box-shadow: 0 4px 12px rgba(77, 168, 218, 0.35);
    }

    .nav-avatar {
        width: 38px; height: 38px;
        background: rgba(255,255,255,0.1);
        border: 2px solid rgba(255,255,255,0.25);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700;
        font-size: 0.95rem;
        color: #4DA8DA;
        letter-spacing: 0.5px;
        backdrop-filter: blur(4px);
        transition: all 0.2s;
    }

    .nav-user-btn {
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 50px;
        padding: 5px 14px 5px 5px;
        cursor: pointer;
        text-decoration: none;
        color: #fff !important;
        transition: all 0.2s;
    }
    .nav-user-btn:hover {
        background: rgba(255,255,255,0.1);
        border-color: rgba(255,255,255,0.3);
    }
    .nav-user-btn:hover .nav-avatar {
        border-color: #4DA8DA;
        background-color: rgba(77, 168, 218, 0.1);
    }

    .nav-user-info { line-height: 1.1; }
    .nav-user-name { font-size: 0.85rem; font-weight: 700; color: #fff; }
    .nav-user-role { font-size: 0.72rem; color: rgba(255,255,255,0.55); text-transform: capitalize; }

    .nav-dropdown-menu {
        border: none;
        border-radius: 16px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.2);
        padding: 8px;
        min-width: 220px;
        background-color: #0b1727;
        border: 1px solid rgba(255,255,255,0.08);
    }

    .nav-dropdown-header {
        padding: 10px 14px;
        border-bottom: 1px solid rgba(255,255,255,0.08);
        margin-bottom: 6px;
    }
    .nav-dropdown-header .d-name { font-weight: 700; font-size: 0.92rem; color: #ffffff; }
    .nav-dropdown-header .d-role { font-size: 0.75rem; color: rgba(255,255,255,0.55); text-transform: capitalize; }

    .nav-dropdown-menu .dropdown-item {
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 0.88rem;
        font-weight: 500;
        color: rgba(255,255,255,0.75) !important;
        transition: all 0.15s;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .nav-dropdown-menu .dropdown-item:hover { 
        background: rgba(255, 255, 255, 0.05); 
        color: #4DA8DA !important; 
    }
    .nav-dropdown-menu .dropdown-item.text-danger:hover { 
        background: rgba(220, 53, 69, 0.1); 
        color: #dc3545 !important; 
    }
    .nav-dropdown-menu .dropdown-divider { margin: 6px 0; border-color: rgba(255,255,255,0.08); }

    .dams-toggler {
        border: 1.5px solid rgba(255,255,255,0.25);
        border-radius: 8px;
        padding: 6px 10px;
    }
    .dams-toggler .navbar-toggler-icon {
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28255,255,255,0.85%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
    }
</style>

<nav class="dams-nav navbar navbar-expand-lg">
    <div class="container-fluid px-0">

        <a class="dams-brand" href="@Url.Action("Index", "Home")">
            <div class="dams-brand-icon">
                <i class="bi bi-heart-pulse-fill"></i>
            </div>
            <span>DAMS</span>
        </a>

        <button class="navbar-toggler dams-toggler border-0 ms-auto" type="button"
                data-bs-toggle="collapse" data-bs-target="#damsTopNav"
                aria-controls="damsTopNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse ms-lg-5" id="damsTopNav">

            <ul class="navbar-nav me-auto align-items-lg-center gap-1">
                <li class="nav-item">
                    <a class="dams-nav-link @(isHomePage ? "active-link" : "")" href="@Url.Action("Index", "Home")">Home</a>
                </li>
                <li class="nav-item">
                    <a class="dams-nav-link" href="@Url.Action("Index", "Home")#aboutSection">About</a>
                </li>
                <li class="nav-item">
                    <a class="dams-nav-link" href="@Url.Action("Index", "Home")#servicesSection">Service</a>
                </li>
                <li class="nav-item">
                    <a class="dams-nav-link" href="@Url.Action("Index", "Home")#doctorsSection">Doctor</a>
                </li>
                <li class="nav-item">
                    <a class="dams-nav-link" href="@Url.Action("Index", "Home")#contactSection">Contact</a>
                </li>
                <li class="nav-item">
                    <a class="dams-nav-link" href="javascript:void(0)" onclick="alert('Blog feature coming soon!')">Blog</a>
                </li>
                @if (isLoggedIn)
                {
                    <li class="nav-item">
                        <a class="dams-nav-link @(dashboardUrl == controller ? "active-link" : "")" href="@dashboardUrl">Dashboard</a>
                    </li>
                }
            </ul>

            <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">
                @if (isLoggedIn)
                {
                    <div class="dropdown">
                        <a class="nav-user-btn" id="navUserMenu" href="#" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false" style="list-style:none; text-decoration:none;">
                            <div class="nav-avatar">@avatarInitial</div>
                            <div class="nav-user-info d-none d-md-block">
                                <div class="nav-user-name">@userName</div>
                                <div class="nav-user-role">@userRole</div>
                            </div>
                            <i class="bi bi-chevron-down" style="font-size:0.65rem; color:rgba(255,255,255,0.7);"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end nav-dropdown-menu" aria-labelledby="navUserMenu">
                            <li class="nav-dropdown-header">
                                <div class="d-name">@userName</div>
                                <div class="d-role">@userRole</div>
                            </li>
                            <li><a class="dropdown-item" href="@dashboardUrl">
                                <i class="bi bi-grid-1x2"></i> Dashboard
                            </a></li>
                            @if (userRole == "patient")
                            {
                                <li><a class="dropdown-item" href="/Appointment/Book">
                                    <i class="bi bi-calendar-plus"></i> Book Appointment
                                </a></li>
                            }
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item text-danger" href="/Account/Logout">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn-nav-login" href="/Account/Login">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Login
                    </a>
                    <a class="btn-nav-register" href="/Account/Register">
                        <i class="bi bi-person-plus me-1"></i> Register
                    </a>
                }
            </div>

        </div>
    </div>
</nav>

