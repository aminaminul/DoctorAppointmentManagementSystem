@* Razor View: Shared/_Layout *@
<!-- HTML View: Shared/_Layout -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DAMS</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }
        .layout-wrapper {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        .layout-body {
            display: flex;
            flex: 1 0 auto;
            width: 100%;
            min-height: calc(100vh - 76px);
        }
        .sidebar-column {
            width: 220px;
            min-width: 220px;
            max-width: 220px;
            background-color: #0b1727;
            align-self: stretch;
            display: flex;
            flex-direction: column;
        }
        .content-column {
            flex: 1;
            min-width: 0;
            background-color: #f8fafc;
        }
    </style>
</head>
<body class="bg-light text-dark">

    <div class="layout-wrapper">
        <!-- Topbar Navbar -->
        @await Component.InvokeAsync("Navbar")

        <!-- Main Body: Sidebar + Main Content -->
        <div class="layout-body">
            @if (ViewData["HideSidebar"] as bool? == true)
            {
                <main class="content-column p-4" role="main">
                    @RenderBody()
                </main>
            }
            else
            {
                <aside class="sidebar-column p-0">
                    @await Component.InvokeAsync("Sidebar")
                </aside>

                <main class="content-column p-4" role="main">
                    @RenderBody()
                </main>
            }
        </div>

        <!-- Bottombar Footer -->
        @if (ViewData["HideFooter"] as bool? != true)
        {
            @await Html.PartialAsync("_Footer")
        }
    </div>

    <!-- JavaScript Block -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
