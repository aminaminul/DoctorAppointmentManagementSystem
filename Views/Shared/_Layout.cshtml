<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DAMS</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
</head>
<body class="bg-white text-dark">

    @await Component.InvokeAsync("Navbar")

    <div class="container-fluid">
        <div class="row">
            @if (ViewData["HideSidebar"] as bool? == true)
            {
                <main class="col-12 py-4" role="main" style="min-height:80vh;">
                    <div class="container-fluid">
                        @RenderBody()
                    </div>
                </main>
            }
            else
            {
                <aside class="col-12 col-md-3 col-lg-2 p-0">
                    @await Component.InvokeAsync("Sidebar")
                </aside>

                <main class="col-12 col-md-9 col-lg-10 py-4" role="main" style="min-height:80vh;">
                    <div class="container-fluid">
                        @RenderBody()
                    </div>
                </main>
            }
        </div>
    </div>

    @if (ViewData["HideFooter"] as bool? != true)
    {
        @await Html.PartialAsync("_Footer")
    }

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
