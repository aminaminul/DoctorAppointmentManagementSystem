@model IEnumerable<DoctorAppointmentManagementSystem.Models.Holiday>

@{
    ViewData["Title"] = "Holiday Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Holiday Management</h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row">
    <div class="col-md-5 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Add New Holiday</h5>
            </div>
            <div class="card-body">
                <form asp-action="AddHoliday" method="post">
                    <div class="mb-3">
                        <label class="form-label">Holiday Name</label>
                        <input name="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Date</label>
                        <input name="Date" type="date" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-success w-100">Add Holiday</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Date</th>
                    <th>Name</th>
                    <th style="width: 150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Date.ToString("dd MMM yyyy")</td>
                        <td><strong>@item.Name</strong></td>
                        <td>
                            <a asp-action="EditHoliday" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="DeleteHoliday" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Delete this holiday?')">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
