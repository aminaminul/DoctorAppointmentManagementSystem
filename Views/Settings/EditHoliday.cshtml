@model DoctorAppointmentManagementSystem.Models.Holiday

@{
    ViewData["Title"] = "Edit Holiday";
}

<h2>Edit Holiday</h2>

<form asp-action="EditHoliday" class="w-50">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="Date" class="form-label"></label>
        <input asp-for="Date" type="date" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">Update</button>
    <a asp-action="Holidays" class="btn btn-secondary">Cancel</a>
</form>
