@model DoctorAppointmentManagementSystem.ViewModels.RegisterViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Register";
}

<div class="container d-flex justify-content-center align-items-center py-5">
    <div class="glass-card" style="width: 100%; max-width: 500px;">
        <div class="text-center mb-4">
            <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                <i class="bi bi-person-plus-fill fs-2"></i>
            </div>
            <h2 class="fw-bold">Create Account</h2>
            <p class="text-muted">Join DAMS to manage your appointments</p>
        </div>

        <form method="post">
            <!-- Name -->
            <div class="mb-3">
                <label class="form-label fw-semibold text-secondary small">Full Name</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                    <input asp-for="Name" class="form-control form-control-modern border-start-0 ps-0" placeholder="John Doe" />
                </div>
                <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Email -->
            <div class="mb-3">
                <label class="form-label fw-semibold text-secondary small">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                    <input asp-for="Email" class="form-control form-control-modern border-start-0 ps-0" placeholder="name@example.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Password -->
            <div class="mb-3">
                <label class="form-label fw-semibold text-secondary small">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                    <input asp-for="Password" type="password" class="form-control form-control-modern border-start-0 ps-0" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="row g-3 mb-4">
                <!-- Role -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold text-secondary small">Role</label>
                    <select asp-for="Role" class="form-select form-control-modern">
                        <option value="">Select Role</option>
                        <option value="Patient">Patient</option>
                        <option value="Doctor">Doctor</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Gender -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold text-secondary small">Gender</label>
                    <select asp-for="Gender" class="form-select form-control-modern">
                        <option value="">Select Gender</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-modern w-100 py-3 d-flex align-items-center justify-content-center gap-2">
                Register <i class="bi bi-arrow-right-circle"></i>
            </button>
        </form>

        <p class="mt-4 text-center text-muted">
            Already have an account? 
            <a href="/Account/Login" class="text-success fw-bold text-decoration-none">Log In</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}