@model DoctorAppointmentManagementSystem.ViewModels.RegisterViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Register";
}

@{ ViewData["HideSidebar"] = true; }

<div class="container d-flex justify-content-center align-items-center py-5">
    <div class="card rounded-4 shadow-sm" style="width:100%; max-width:600px;">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:64px; height:64px; background-color:#4DA8DA;">
                    <i class="bi bi-person-plus-fill fs-2 text-white"></i>
                </div>

                <!-- Patient fields -->
                <div id="patientFields" style="display:none;">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Age</label>
                        <input asp-for="Age" type="number" id="Age" class="form-control form-control-lg rounded-3" />
                        <span asp-validation-for="Age" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Date of birth</label>
                        <input asp-for="DateOfBirth" type="date" id="DateOfBirth" class="form-control form-control-lg rounded-3" />
                        <span asp-validation-for="DateOfBirth" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <!-- Doctor fields -->
                <div id="doctorFields" style="display:none;">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Specialization</label>
                        <input asp-for="Specialization" class="form-control form-control-lg rounded-3" placeholder="e.g. Cardiology" />
                        <span asp-validation-for="Specialization" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Department</label>
                        <select asp-for="Department" class="form-select form-control-lg rounded-3">
                            <option value="">Select Department</option>
                            @foreach (var d in Enum.GetValues(typeof(DoctorAppointmentManagementSystem.Models.Department)))
                            {
                                <option value="@((int)d)">@d</option>
                            }
                        </select>
                        <span asp-validation-for="Department" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Availability</label>
                        <input asp-for="Availability" class="form-control form-control-lg rounded-3" placeholder="e.g. 10AM-4PM" />
                        <span asp-validation-for="Availability" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>
                <h2 class="fw-bold">Create Account</h2>
                <p class="text-muted">Join DAMS to manage your appointments</p>
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                <!-- Username -->
                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary small">Username</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-person text-muted"></i></span>
                        <input asp-for="Username" class="form-control form-control-lg rounded-3 border-start-0 ps-0" placeholder="JohnDoe123" />
                    </div>
                    <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary small">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                        <input asp-for="Email" class="form-control form-control-lg rounded-3 border-start-0 ps-0" placeholder="name@example.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary small">Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock text-muted"></i></span>
                        <input asp-for="Password" type="password" class="form-control form-control-lg rounded-3 border-start-0 ps-0" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Phone -->
                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary small">Phone (optional)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-telephone text-muted"></i></span>
                        <input asp-for="PhoneNumber" class="form-control form-control-lg rounded-3 border-start-0 ps-0" placeholder="e.g. +8801XXXXXXXXX" />
                    </div>
                    <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="row g-3 mb-4">
                    <!-- Role -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary small">Role</label>
                        @* Use ViewBag.Roles as the source for options. The model binds RoleId (int). *@
                        <select asp-for="RoleId" asp-items='@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(ViewBag.Roles ?? new List<DoctorAppointmentManagementSystem.Models.Role>(), "Id", "Name"))' class="form-select form-control-lg rounded-3">
                            <option value="">Select Role</option>
                        </select>
                        <span asp-validation-for="RoleId" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Gender -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary small">Gender</label>
                        <select asp-for="Gender" class="form-select form-control-lg rounded-3">
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-3 d-flex align-items-center justify-content-center gap-2 rounded-3">
                    Register <i class="bi bi-arrow-right-circle"></i>
                </button>
            </form>

            <script>
                (function(){
                    var roleSelect = document.querySelector('[asp-for="RoleId"]') || document.querySelector('select[name="RoleId"]');
                    var patientFields = document.getElementById('patientFields');
                    var doctorFields = document.getElementById('doctorFields');

                    function updateFields(){
                        var val = roleSelect ? roleSelect.value : '';
                        if (val === '2') { // Doctor
                            doctorFields.style.display = '';
                            patientFields.style.display = 'none';
                        } else if (val === '3') { // Patient
                            patientFields.style.display = '';
                            doctorFields.style.display = 'none';
                        } else {
                            patientFields.style.display = 'none';
                            doctorFields.style.display = 'none';
                        }
                    }

                    if (roleSelect) {
                        roleSelect.addEventListener('change', updateFields);
                        // initialize on load
                        updateFields();
                    }
                })();
            </script>

            <p class="mt-4 text-center text-muted mb-0">
                Already have an account?
                <a href="/Account/Login" class="fw-bold ms-1" style="color:#4DA8DA; text-decoration:none;">Log In</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}}