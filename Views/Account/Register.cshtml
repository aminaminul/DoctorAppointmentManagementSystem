@model DoctorAppointmentManagementSystem.ViewModels.RegisterViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Register";
}

@{ ViewData["HideSidebar"] = true; }

<section class="position-relative" style="min-height:74vh;">
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background-image: linear-gradient(rgba(31,31,31,0.45), rgba(31,31,31,0.45)), url('@Url.Content("~/Images/doctor.jpg")'); background-size:cover; background-position:center;">
    </div>

    <div class="container h-100 d-flex align-items-center justify-content-center position-relative" style="z-index:2;">
        <div class="card shadow-sm rounded-3 w-100" style="max-width:900px; background: rgba(255,255,255,0.95);">
            <div class="row g-0">
            <div class="col-md-6 p-4 d-flex flex-column justify-content-center" style="background:#f8fbfd;">
                <div>
                    <h3 class="fw-bold" style="color:#1F1F1F;">Create account</h3>
                    <p class="text-muted small">Sign up as Doctor or Patient to continue.</p>
                </div>

                <div class="mt-3">
                    <ul class="list-unstyled small text-muted">
                        <li><i class="bi bi-check2-circle text-primary me-2" style="color:#4DA8DA;"></i> Secure and fast</li>
                        <li><i class="bi bi-check2-circle text-primary me-2" style="color:#4DA8DA;"></i> Role-specific registration</li>
                        <li><i class="bi bi-check2-circle text-primary me-2" style="color:#4DA8DA;"></i> Easy scheduling</li>
                    </ul>
                </div>
            </div>

            <div class="col-md-6 p-4">
                <form asp-action="Register" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label small">Username</label>
                        <input asp-for="Username" class="form-control form-control-lg rounded-3" />
                        <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small">Email</label>
                        <input asp-for="Email" class="form-control form-control-lg rounded-3" />
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small">Password</label>
                        <input asp-for="Password" type="password" class="form-control form-control-lg rounded-3" />
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small">Phone (optional)</label>
                        <input asp-for="PhoneNumber" class="form-control form-control-lg rounded-3" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col">
                            <label class="form-label small">Role</label>
                            <select asp-for="RoleId" class="form-select form-select-lg rounded-3">
                                <option value="">Select Role</option>
                                @* ViewBag.Roles expected from controller *@
                                @if (ViewBag.Roles != null)
                                {
                                    foreach (var r in (IEnumerable<dynamic>)ViewBag.Roles)
                                    {
                                        <option value="@r.Id">@r.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="RoleId" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="col">
                            <label class="form-label small">Gender</label>
                            <select asp-for="Gender" class="form-select form-select-lg rounded-3">
                                <option value="">Select Gender</option>
                                <option>Male</option>
                                <option>Female</option>
                                <option>Other</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    @* Patient fields *@
                    <div id="patientFields" style="display:none;">
                        <div class="mb-3">
                            <label class="form-label small">Date of Birth</label>
                            <input asp-for="DateOfBirth" type="date" id="DateOfBirth" class="form-control form-control-lg rounded-3" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small">Age</label>
                            <input asp-for="Age" type="number" id="Age" class="form-control form-control-lg rounded-3" />
                            <span asp-validation-for="Age" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    @* Doctor fields *@
                    <div id="doctorFields" style="display:none;">
                        <div class="mb-3">
                            <label class="form-label small">Department</label>
                            <select asp-for="Department" class="form-select form-select-lg rounded-3">
                                <option value="">Select Department</option>
                                @foreach (var d in Enum.GetValues(typeof(DoctorAppointmentManagementSystem.Models.Department)))
                                {
                                    <option value="@((int)d)">@d</option>
                                }
                            </select>
                            <span asp-validation-for="Department" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small">Specialization</label>
                            <input asp-for="Specialization" class="form-control form-control-lg rounded-3" />
                            <span asp-validation-for="Specialization" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small">Availability</label>
                            <input asp-for="Availability" class="form-control form-control-lg rounded-3" placeholder="e.g. 10AM - 4PM" />
                            <span asp-validation-for="Availability" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-lg text-white" style="background-color:#4DA8DA;">
                            <i class="bi bi-person-plus-fill me-2"></i> Create account
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Minimal inline JS to toggle role-specific fields and compute age from DOB.
        (function () {
            var roleSelect = document.querySelector('[name="RoleId"]');
            var patientFields = document.getElementById('patientFields');
            var doctorFields = document.getElementById('doctorFields');
            var dobInput = document.getElementById('DateOfBirth');
            var ageInput = document.getElementById('Age');

            function updateFields() {
                var val = roleSelect ? roleSelect.value : '';
                if (val === '2') { // Doctor
                    doctorFields.style.display = '';
                    patientFields.style.display = 'none';
                } else if (val === '3') { // Patient
                    patientFields.style.display = '';
                    doctorFields.style.display = 'none';
                } else {
                    patientFields.style.display = 'none';
                    doctorFields.style.display = 'none';
                }
            }

            function calcAgeFromDob() {
                if (!dobInput || !ageInput) return;
                var v = dobInput.value;
                if (!v) return;
                var dob = new Date(v);
                if (isNaN(dob)) return;
                var diff = Date.now() - dob.getTime();
                var a = Math.floor(new Date(diff).getUTCFullYear() - 1970);
                ageInput.value = a;
            }

            if (roleSelect) {
                roleSelect.addEventListener('change', updateFields);
                updateFields();
            }
            if (dobInput) dobInput.addEventListener('change', calcAgeFromDob);
        })();
    </script>
}
