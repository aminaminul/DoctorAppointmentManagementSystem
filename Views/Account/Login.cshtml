@model DoctorAppointmentManagementSystem.ViewModels.LoginViewModel   

@{
    Layout = "_Layout";
    ViewData["Title"] = "Login";
}

@{ ViewData["HideSidebar"] = true; }

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card rounded-4 shadow-sm" style="width:100%; max-width:480px;">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:64px; height:64px; background-color:#4DA8DA;">
                    <i class="bi bi-person-circle fs-2 text-white"></i>
                </div>
                <h2 class="fw-bold">Welcome Back</h2>
                <p class="text-muted">Please sign in to your account</p>
            </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger shadow-sm border-0" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
            </div>
        }

            <form method="post">
                <!-- Email -->
                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary small">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-envelope-fill text-muted"></i></span>
                        <input asp-for="Email" class="form-control form-control-lg rounded-3 border-start-0 ps-0" placeholder="name@example.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary small">Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock text-muted"></i></span>
                        <input asp-for="Password" type="password" class="form-control form-control-lg rounded-3 border-start-0 ps-0" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Button -->
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary w-100 py-3 d-flex align-items-center justify-content-center gap-2 rounded-3">
                        Login <i class="bi bi-box-arrow-in-right"></i>
                    </button>
                </div>
            </form>

            <p class="mt-4 text-center text-muted mb-0">
                Don't have an account?
                <a href="/Account/Register" class="fw-bold ms-1" style="color:#4DA8DA; text-decoration:none;">Sign Up</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}