@model DoctorAppointmentManagementSystem.ViewModels.LoginViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Login";
}

@{ ViewData["HideSidebar"] = true; }

<section class="position-relative" style="min-height:74vh;">
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background-image: linear-gradient(rgba(31,31,31,0.45), rgba(31,31,31,0.45)), url('@Url.Content("~/Images/doctor.jpg")'); background-size:cover; background-position:center;">
    </div>

    <div class="container h-100 d-flex align-items-center justify-content-center position-relative" style="z-index:2;">
        <div class="card rounded-4 shadow-lg w-100" style="max-width:520px; background: rgba(255,255,255,0.96); backdrop-filter: blur(6px);">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white" style="width:64px;height:64px;">
                        <i class="bi bi-person-circle fs-2" style="color:#4DA8DA;"></i>
                    </div>
                    <h3 class="mt-3 mb-1 fw-bold" style="color:#1F1F1F;">Welcome back</h3>
                    <p class="small text-muted mb-0">Sign in to access your dashboard</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger shadow-sm border-0" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                    </div>
                }

                <form asp-action="Login" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label small">Email</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" autofocus class="form-control form-control-lg rounded-3 border-start-0" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small">Password</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" type="password" class="form-control form-control-lg rounded-3 border-start-0" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <a asp-action="ForgotPassword" class="small text-decoration-none">Forgot password?</a>
                        </div>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-lg text-white rounded-3" style="background-color:#4DA8DA;">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Sign In
                        </button>
                    </div>

                    <div class="text-center small text-muted">
                        Don't have an account?
                        <a asp-action="Register" class="fw-semibold text-decoration-none" style="color:#4DA8DA;">Create one</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
