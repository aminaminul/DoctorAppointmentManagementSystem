@model DoctorAppointmentManagementSystem.ViewModels.LoginViewModel   

@{
    Layout = "_Layout";
    ViewData["Title"] = "Login";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="glass-card" style="width: 100%; max-width: 450px;">
        <div class="text-center mb-4">
            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                <i class="bi bi-person-circle fs-2"></i>
            </div>
            <h2 class="fw-bold">Welcome Back</h2>
            <p class="text-muted">Please sign in to your account</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger shadow-sm border-0" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
            </div>
        }

        <form method="post">
            <!-- Email -->
            <div class="mb-4">
                <label class="form-label fw-semibold text-secondary small">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                    <input asp-for="Email" class="form-control form-control-modern border-start-0 ps-0" placeholder="name@example.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Password -->
            <div class="mb-4">
                <label class="form-label fw-semibold text-secondary small">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                    <input asp-for="Password" type="password" class="form-control form-control-modern border-start-0 ps-0" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Button -->
            <div class="mt-4">
                <button type="submit" class="btn btn-modern w-100 py-3 d-flex align-items-center justify-content-center gap-2">
                    Login <i class="bi bi-box-arrow-in-right"></i>
                </button>
            </div>
        </form>

        <p class="mt-4 text-center text-muted">
            Don't have an account? 
            <a href="/Account/Register" class="text-primary fw-bold text-decoration-none">Sign Up</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}