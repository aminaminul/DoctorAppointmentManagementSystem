@* Razor View: Account/Login *@
<!-- HTML View: Account/Login -->
@model DoctorAppointmentManagementSystem.ViewModels.LoginViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Login";
    ViewData["HideSidebar"] = true;
}

<div class="login-wrapper">
    
    <div class="bubble bubble-1"><i class="bi bi-heart-pulse-fill"></i></div>
    <div class="bubble bubble-2"><i class="bi bi-activity"></i></div>
    <div class="bubble bubble-3"><i class="bi bi-shield-plus"></i></div>
    <div class="bubble bubble-4"><i class="bi bi-droplet-fill"></i></div>

    <div class="heartbeat-line">
        <svg viewBox="0 0 1440 200" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0,100 L500,100 L520,70 L540,140 L560,30 L585,170 L600,100 L610,120 L620,100 L1440,100" stroke="rgba(255,255,255,0.18)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
    </div>

    <div class="container d-flex align-items-center justify-content-center min-vh-100 position-relative" style="z-index: 10;">
        <div class="glass-card shadow-lg">
            <div class="text-center mb-5">
                <div class="logo-wrapper">
                    <i class="bi bi-heart-pulse-fill logo-icon"></i>
                </div>
                <h2 class="welcome-title mt-4">Welcome Back!</h2>
                <p class="welcome-subtitle">Access your Doctor Appointment Management portal</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger-custom d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>@ViewBag.Error</div>
                </div>
            }
<!-- Form Block -->
        <form asp-action="Login" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="input-field-group mb-4">
                    <label class="input-label" asp-for="Email">Email Address</label>
                    <div class="input-container">
                        <i class="bi bi-envelope input-icon"></i>
                        <input asp-for="Email" autofocus class="form-input" placeholder="Enter your email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="input-field-group mb-4">
                    <label class="input-label" asp-for="Password">Password</label>
                    <div class="input-container">
                        <i class="bi bi-lock input-icon"></i>
                        <input asp-for="Password" type="password" class="form-input" placeholder="Enter your password" id="loginPass" />
                        <button type="button" class="btn-toggle-pass" onclick="togglePassVisibility('loginPass')">
                            <i class="bi bi-eye" id="loginPassEye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="text-end mb-4">
                    <a asp-action="ForgotPassword" class="forgot-link">Forgot Password?</a>
                </div>

                <button type="submit" class="btn-submit w-100 mb-4">
                    SIGN IN
                </button>

                <div class="text-center mt-3">
                    <p class="signup-text">
                        Don't have an account? 
                        <a asp-action="Register" class="signup-link">Sign Up</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
<!-- JavaScript Block -->
        <script>
        function togglePassVisibility(id) {
            var input = document.getElementById(id);
            var eye = document.getElementById(id + 'Eye');
            if (input.type === 'password') {
                input.type = 'text';
                eye.classList.remove('bi-eye');
                eye.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                eye.classList.remove('bi-eye-slash');
                eye.classList.add('bi-eye');
            }
        }
    </script>
}
<!-- CSS Style Block -->
        <style>
    
    body.bg-white {
        background-color: #0b1727 !important;
    }
    main {
        padding: 0 !important;
        min-height: auto !important;
    }
    main .container-fluid {
        padding: 0 !important;
    }
    body > .container-fluid {
        padding: 0 !important;
    }
    body > .container-fluid > .row {
        margin: 0 !important;
    }
    body > .container-fluid > .row > main {
        padding: 0 !important;
    }

    .login-wrapper {
        min-height: calc(100vh - 76px);
        width: 100%;
        background: radial-gradient(circle at 10% 20%, rgba(26,107,154,1) 0%, rgba(30,136,156,1) 90.1%);
        position: relative;
        overflow: hidden;
        margin-top: 0;
        padding-top: 0;
    }

    .heartbeat-line {
        position: absolute;
        bottom: 5%;
        left: 0;
        width: 100%;
        opacity: 0.85;
        z-index: 1;
        pointer-events: none;
    }

    .bubble {
        position: absolute;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(255, 255, 255, 0.45);
        border: 1px solid rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(8px);
        pointer-events: none;
        z-index: 2;
        animation: floatBubble 6s ease-in-out infinite alternate;
    }

    .bubble-1 {
        width: 110px; height: 110px;
        top: 15%; left: 8%;
        font-size: 2.2rem;
        background: rgba(255, 255, 255, 0.05);
        animation-delay: 0s;
    }

    .bubble-2 {
        width: 130px; height: 130px;
        bottom: 20%; right: 10%;
        font-size: 2.5rem;
        background: rgba(255, 255, 255, 0.04);
        animation-delay: 1.5s;
    }

    .bubble-3 {
        width: 90px; height: 90px;
        top: 8%; right: 25%;
        font-size: 1.8rem;
        background: rgba(255, 255, 255, 0.03);
        animation-delay: 3s;
    }

    .bubble-4 {
        width: 80px; height: 80px;
        bottom: 12%; left: 22%;
        font-size: 1.6rem;
        background: rgba(255, 255, 255, 0.02);
        animation-delay: 4.5s;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.76);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 28px;
        width: 100%;
        max-width: 480px;
        padding: 3.5rem 3rem;
        z-index: 5;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
    }

    .logo-wrapper {
        width: 58px;
        height: 58px;
        background-color: #1a6b9a;
        color: #ffffff;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 20px rgba(26, 107, 154, 0.35);
    }

    .logo-icon {
        font-size: 1.8rem;
    }

    .welcome-title {
        font-weight: 800;
        font-size: 1.85rem;
        color: #0b1727;
        letter-spacing: -0.5px;
    }

    .welcome-subtitle {
        font-size: 0.88rem;
        color: #5c6b73;
        margin-top: 4px;
        font-weight: 500;
    }

    .input-field-group {
        position: relative;
    }

    .input-label {
        font-size: 0.82rem;
        font-weight: 700;
        color: #1a6b9a;
        margin-bottom: 6px;
        display: block;
        letter-spacing: 0.3px;
    }

    .input-container {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-icon {
        position: absolute;
        left: 0;
        color: #7f8c8d;
        font-size: 1.15rem;
        pointer-events: none;
        transition: color 0.25s;
    }

    .form-input {
        width: 100%;
        background: transparent;
        border: none;
        border-bottom: 2px solid rgba(0, 0, 0, 0.12);
        padding: 10px 35px 8px 26px;
        font-size: 0.95rem;
        color: #2c3e50;
        font-weight: 600;
        transition: border-color 0.25s;
        border-radius: 0;
    }

    .form-input::placeholder {
        color: #95a5a6;
        font-weight: 500;
    }

    .form-input:focus {
        outline: none;
        border-color: #1a6b9a;
    }

    .form-input:focus ~ .input-icon {
        color: #1a6b9a;
    }

    .btn-toggle-pass {
        position: absolute;
        right: 0;
        background: transparent;
        border: none;
        color: #7f8c8d;
        cursor: pointer;
        padding: 5px;
        font-size: 1.1rem;
        transition: color 0.2s;
    }
    .btn-toggle-pass:hover {
        color: #1a6b9a;
    }

    .forgot-link {
        font-size: 0.82rem;
        font-weight: 700;
        color: #1a6b9a;
        text-decoration: none;
        transition: color 0.2s;
    }
    .forgot-link:hover {
        color: #4DA8DA;
    }

    .btn-submit {
        background: linear-gradient(135deg, #1a6b9a 0%, #1e8cb0 100%);
        border: none;
        color: #ffffff;
        font-weight: 700;
        font-size: 0.95rem;
        padding: 14px;
        border-radius: 14px;
        cursor: pointer;
        letter-spacing: 0.5px;
        transition: all 0.25s ease;
        box-shadow: 0 4px 15px rgba(26, 107, 154, 0.3);
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(26, 107, 154, 0.45);
        background: linear-gradient(135deg, #1e7ba2 0%, #209ec7 100%);
    }

    .signup-text {
        font-size: 0.88rem;
        color: #5c6b73;
        font-weight: 600;
    }

    .signup-link {
        color: #1a6b9a;
        text-decoration: none;
        font-weight: 700;
        transition: color 0.2s;
    }
    .signup-link:hover {
        color: #4DA8DA;
    }

    .alert-danger-custom {
        background-color: rgba(220, 53, 69, 0.1);
        border: 1px solid rgba(220, 53, 69, 0.2);
        color: #dc3545;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 10px 14px;
        border-radius: 10px;
    }

    @@keyframes floatBubble {
        0% { transform: translateY(0) rotate(0deg); }
        100% { transform: translateY(-15px) rotate(10deg); }
    }
</style>

