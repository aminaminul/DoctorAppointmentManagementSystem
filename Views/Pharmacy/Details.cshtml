@* Razor View: Pharmacy/Details *@
<!-- HTML View: Pharmacy/Details -->
@model DoctorAppointmentManagementSystem.Models.Medicine

@{
    ViewData["Title"] = "Medicine Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Medicine Details - @Model.Name</h2>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Medicine Information</h5>
            </div>
            <div class="card-body">
<!-- Data Table Block -->
        <table class="table table-hover">
                    <tr>
                        <th style="width: 40%">Name</th>
                        <td>@Model.Name</td>
                    </tr>
                    <tr>
                        <th>Generic Name</th>
                        <td>@Model.GenericName</td>
                    </tr>
                    <tr>
                        <th>Category</th>
                        <td>@Model.Category</td>
                    </tr>
                    <tr>
                        <th>Manufacturer</th>
                        <td>@Model.Manufacturer</td>
                    </tr>
                    <tr>
                        <th>Price (BDT)</th>
                        <td>à§³@Model.Price</td>
                    </tr>
                    <tr>
                        <th>Stock Quantity</th>
                        <td>
                            @if (Model.StockQuantity <= 0)
                            {
                                <span class="badge bg-danger">Out of Stock</span>
                            }
                            else if (Model.StockQuantity < 20)
                            {
                                <span class="badge bg-warning text-dark">@Model.StockQuantity units (Low Stock)</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@Model.StockQuantity units</span>
                            }
                        </td>
                    </tr>
                </table>
            </div>
        </div>

        <div class="d-flex gap-2 justify-content-end">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit Medicine</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete @Model.Name?')">Delete Medicine</a>
        </div>
    </div>
</div>

