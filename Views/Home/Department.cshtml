@{
    ViewData["Title"] = ViewBag.DepartmentName + " Department";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["HideSidebar"] = true;

    string deptName = ViewBag.DepartmentName as string ?? "Cardiology";
    var doctors = ViewBag.Doctors as List<DoctorAppointmentManagementSystem.Models.Doctor> ?? new();
    var allDepts = ViewBag.AllDepartments as List<string> ?? new();

    // Department Metadata Dictionary
    var deptData = new Dictionary<string, (string Icon, string Description, string Tagline, List<string> Features, List<(string Metric, string Label)> Stats)>
    {
        ["Cardiology"] = (
            "bi-heart-pulse",
            "The Department of Cardiology is dedicated to clinical excellence in cardiovascular medicine, offering specialized diagnostic imaging, invasive cardiac procedures, arrhythmia management, and preventive heart disease research.",
            "Division of Cardiovascular Medicine & Clinical Research",
            new List<string> { "24/7 Emergency Cardiac Care & Coronary Care Unit (CCU)", "Coronary Angiography & Percutaneous Intervention", "Diagnostic Echocardiography & Cardiac MRI", "Heart Failure & Arrhythmia Clinic", "Preventive Cardiovascular Rehabilitation" },
            new List<(string, string)> { ("15,000+", "Clinical Procedures"), ("99.2%", "Success Rate"), ("24/7", "CCU Support"), ("15+", "Faculty Consultants") }
        ),
        ["Neurology"] = (
            "bi-activity",
            "The Department of Neurology conducts comprehensive clinical evaluation and treatment for central and peripheral nervous system disorders, utilizing electroencephalography (EEG), electromyography (EMG), and clinical neuro-rehabilitation protocols.",
            "Division of Neurological Sciences & Brain Health",
            new List<string> { "Acute Stroke Thrombolysis Unit", "Epilepsy & Seizure Management", "Movement Disorder & Parkinson's Clinic", "Clinical Neuro-pathology & Headache Therapy", "Pediatric & Adult Neuro-Rehabilitation" },
            new List<(string, string)> { ("8,500+", "Neuro Evaluations"), ("98.6%", "Clinical Outcome"), ("3D", "Neuro-Imaging"), ("12+", "Faculty Consultants") }
        ),
        ["Pediatrics"] = (
            "bi-emoji-smile",
            "The Department of Pediatrics provides specialized medical care for infants, children, and adolescents, integrating neonatal intensive care, immunization protocols, and developmental assessment programs.",
            "Division of Pediatric & Adolescent Medicine",
            new List<string> { "Level-III Neonatal Intensive Care Unit (NICU)", "Pediatric Immunization & Growth Tracking", "Pediatric Endocrinology & Metabolic Clinic", "Child Allergy & Pulmonary Care", "Pediatric Behavioral Assessment" },
            new List<(string, string)> { ("25,000+", "Pediatric Cases"), ("100%", "Immunization Care"), ("Level-III", "NICU Support"), ("10+", "Faculty Consultants") }
        ),
        ["Orthopedics"] = (
            "bi-clipboard-pulse",
            "The Department of Orthopedic Surgery specializes in musculoskeletal trauma, joint reconstruction, spinal disorders, and sports medicine using minimally invasive surgical techniques.",
            "Division of Orthopedic Surgery & Musculoskeletal Health",
            new List<string> { "Total Joint Reconstruction (Knee & Hip)", "Arthroscopic Surgery & Sports Traumatology", "Spinal Disorder Rehabilitation", "Complex Trauma & Fracture Surgery", "Osteoporosis & Bone Density Evaluation" },
            new List<(string, string)> { ("10,000+", "Surgeries Conducted"), ("99.5%", "Surgical Precision"), ("Robotic", "Reconstruction"), ("14+", "Faculty Consultants") }
        ),
        ["Dermatology"] = (
            "bi-droplet-half",
            "The Department of Dermatology focuses on dermatological diagnostics, dermatopathology, laser surgery, and medical treatment of complex cutaneous disorders.",
            "Division of Medical & Surgical Dermatology",
            new List<string> { "Diagnostic Skin Biopsy & Dermatopathology", "Medical Management of Psoriasis & Eczema", "Cutaneous Oncology Screening", "Advanced Laser Dermatology", "Cosmetic Dermatology & Phototherapy" },
            new List<(string, string)> { ("12,000+", "Clinical Consults"), ("98.9%", "Diagnostic Accuracy"), ("FDA", "Approved Laser Suite"), ("8+", "Faculty Consultants") }
        ),
        ["Ophthalmology"] = (
            "bi-eye",
            "The Department of Ophthalmology delivers advanced ocular healthcare, covering micro-surgical cataract extraction, glaucoma management, retinal surgery, and refractive correction.",
            "Division of Ophthalmic Surgery & Visual Sciences",
            new List<string> { "Micro-Incision Phacoemulsification Cataract Surgery", "Glaucoma Screening & Laser Trabeculoplasty", "Vitreoretinal Diagnostics & Therapy", "Pediatric Strabismus Correction", "Corneal Pathology & Dry Eye Services" },
            new List<(string, string)> { ("18,000+", "Visual Surgeries"), ("99.8%", "Visual Accuracy"), ("Laser", "Surgical Suite"), ("9+", "Faculty Consultants") }
        ),
        ["Gynaecologist"] = (
            "bi-gender-female",
            "The Department of Obstetrics and Gynaecology provides comprehensive clinical services in maternal-fetal medicine, minimally invasive gynaecological surgery, and reproductive endocrinology.",
            "Division of Obstetrics, Gynaecology & Reproductive Health",
            new List<string> { "Maternal-Fetal Care & Delivery Units", "Laparoscopic Gynaecological Surgery", "High-Risk Obstetrics Management", "Reproductive Endocrinology & Infertility", "Gynecologic Oncology Screening" },
            new List<(string, string)> { ("20,000+", "Deliveries & Cases"), ("99.7%", "Maternal Safety"), ("24/7", "Obstetric Unit"), ("11+", "Faculty Consultants") }
        ),
        ["Medicine Specialist"] = (
            "bi-hospital",
            "The Department of Internal Medicine specializes in multisystem disease diagnosis, chronic medical disorder management, and comprehensive inpatient medical care.",
            "Division of Internal Medicine & Multisystem Care",
            new List<string> { "Endocrine & Metabolic Care", "Hypertension & Nephrology Programs", "Infectious Disease Diagnostics", "Geriatric Medicine & Health Screenings", "Complex Multisystem Evaluation" },
            new List<(string, string)> { ("30,000+", "Clinical Evaluations"), ("99.0%", "Diagnostic Standards"), ("Full", "Laboratory Integration"), ("16+", "Faculty Consultants") }
        )
    };

    var currentInfo = deptData.ContainsKey(deptName) ? deptData[deptName] : deptData["Cardiology"];
}

<!-- Academic Style Header -->
<div class="bg-white border-bottom py-4 mb-4">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small text-muted mb-2">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-secondary">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" asp-fragment="servicesSection" class="text-decoration-none text-secondary">Academic Departments</a></li>
                <li class="breadcrumb-item active text-dark" aria-current="page">@deptName</li>
            </ol>
        </nav>

        <div class="d-flex align-items-center gap-3">
            <div class="rounded-3 bg-light border p-3 text-primary d-flex align-items-center justify-content-center fs-2" style="width: 60px; height: 60px;">
                <i class="bi @currentInfo.Icon"></i>
            </div>
            <div>
                <h2 class="fw-bold text-dark mb-1">Department of @deptName</h2>
                <p class="text-muted mb-0 small">@currentInfo.Tagline</p>
            </div>
        </div>

        <!-- Academic Navigation Tabs -->
        <div class="d-flex flex-wrap gap-2 mt-4 pt-2 border-top">
            @foreach (var d in allDepts)
            {
                <a asp-controller="Home" asp-action="Department" asp-route-name="@d"
                   class="btn btn-sm text-decoration-none px-3 py-1 rounded-1 @(d.Equals(deptName, StringComparison.OrdinalIgnoreCase) ? "btn-primary fw-semibold" : "btn-light text-secondary border")">
                    @d
                </a>
            }
        </div>
    </div>
</div>

<!-- Main Academic Content Container (Full Width Clean Layout) -->
<div class="container pb-5">
    
    <!-- Overview Section -->
    <div class="card border mb-4 rounded-3 shadow-sm">
        <div class="card-body p-4">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                <i class="bi bi-book me-2 text-primary"></i>Departmental Overview
            </h5>
            <p class="text-secondary lh-lg mb-4">
                @currentInfo.Description
            </p>

            <!-- Key Metrics Grid -->
            <div class="row g-3">
                @foreach (var stat in currentInfo.Stats)
                {
                    <div class="col-6 col-md-3">
                        <div class="p-3 border rounded-2 bg-light text-center">
                            <div class="fs-4 fw-bold text-primary">@stat.Metric</div>
                            <div class="small text-muted fw-medium">@stat.Label</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Clinical Services & Academic Research -->
    <div class="card border mb-4 rounded-3 shadow-sm">
        <div class="card-body p-4">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                <i class="bi bi-list-check me-2 text-primary"></i>Clinical Scope & Specialized Facilities
            </h5>
            <div class="row g-3">
                @foreach (var feat in currentInfo.Features)
                {
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-2 p-2 border rounded-2 bg-light">
                            <i class="bi bi-check2-square text-primary"></i>
                            <span class="small text-dark fw-medium">@feat</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Department Faculty & Specialists -->
    <div class="card border rounded-3 shadow-sm">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-dark mb-0">
                <i class="bi bi-person-workspace me-2 text-primary"></i>Faculty & Specialist Consultants
            </h5>
            <span class="badge bg-secondary">@doctors.Count Specialist(s)</span>
        </div>
        <div class="card-body p-4">
            @if (doctors.Any())
            {
                <div class="row g-3">
                    @foreach (var doc in doctors)
                    {
                        string docName = doc.User?.Username ?? "Doctor";
                        string initial = string.IsNullOrEmpty(docName) ? "D" : docName.Substring(0, 1).ToUpper();

                        <div class="col-md-6 col-lg-4">
                            <div class="border rounded-3 p-3 h-100 bg-light d-flex flex-column">
                                <div class="d-flex gap-3 align-items-center mb-3">
                                    <div class="rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px; font-size: 1.25rem;">
                                        @initial
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0 text-dark">@docName</h6>
                                        <div class="badge bg-light text-primary border me-1">@doc.Specialization</div>
                                        <div class="small text-muted">@doc.Qualification</div>
                                    </div>
                                </div>
                                <div class="border-top pt-2 mt-auto small text-muted d-flex justify-content-between align-items-center">
                                    <span>Experience: <strong>@doc.Experience Years</strong></span>
                                    <span class="text-dark fw-bold">৳@doc.ConsultationFee</span>
                                </div>
                                <div class="mt-3">
                                    <a asp-controller="Patient" asp-action="DoctorProfile" asp-route-id="@doc.Id" class="btn btn-outline-primary btn-sm w-100 rounded-1">
                                        View Profile & Schedule
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-folder-x display-6 d-block mb-2"></i>
                    No faculty members currently listed under this department.
                </div>
            }
        </div>
    </div>

</div>
