@* Razor View: Home/Privacy *@
<!-- HTML View: Home/Privacy -->
@{
    Layout = "_Layout";
    ViewData["Title"] = "Privacy Policy";
    ViewData["HideSidebar"] = true;
    ViewData["NavbarTheme"] = "white";
}

<div class="container py-5">
    <div class="card rounded-4 shadow-sm border-0">
        <div class="card-body p-4">
            <div class="d-flex align-items-start gap-3 mb-3">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center text-white" style="width:56px;height:56px;background-color:#0b1727;">
                    <i class="bi bi-shield-lock-fill fs-4"></i>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1 text-dark">Privacy Policy</h1>
                    <p class="mb-0 text-muted">Your privacy matters. This policy outlines how DAMS collects, secures, and manages medical information.</p>
                </div>
            </div>

            <hr class="my-4" />

            <div class="policy-content-area">
                @if (!string.IsNullOrEmpty(ViewBag.PrivacyContent as string))
                {
                    <div class="policy-body">
                        @Html.Raw(ViewBag.PrivacyContent)
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">No Privacy Policy details have been published yet.</div>
                }
            </div>

            <div class="mt-4 text-end">
                <a class="btn btn-outline-secondary me-2" asp-controller="Home" asp-action="PrintPrivacy" target="_blank"><i class="bi bi-box-arrow-up-right me-1"></i> Open Print View</a>
                <a class="btn btn-primary" asp-controller="Home" asp-action="PrintPrivacy" asp-route-autoprint="1" target="_blank"><i class="bi bi-printer me-1"></i> Print / Save as PDF</a>
            </div>
        </div>
    </div>
</div>
