@{
    Layout = "_Layout";
}

<div class="container mt-5 pt-5">
    <div class="row align-items-center">
        <div class="col-md-6">
            <h1 class="display-5 fw-bold">Welcome to DAMS</h1>
            <p class="lead text-muted">Doctor Appointment Management System — book appointments, manage schedules, and track medical records easily.</p>

            <div class="d-flex gap-2 mt-4">
                <a href="/Account/Login" class="btn btn-primary btn-lg">Login</a>
                <a href="/Account/Register" class="btn btn-outline-primary btn-lg">Register</a>
            </div>

            <div class="mt-5">
                <h5>Features</h5>
                <ul class="list-unstyled text-muted">
                    <li>• Simple appointment booking</li>
                    <li>• Role-based dashboards for Admin/Doctor/Patient</li>
                    <li>• Electronic medical records</li>
                </ul>
            </div>
        </div>
        <div class="col-md-6 d-none d-md-block text-center">
            <i class="bi bi-hospital-fill" style="font-size:140px;color:#4DA8DA"></i>
        </div>
    </div>
</div>