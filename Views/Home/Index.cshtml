    <!-- HTML Comment: Contact/Consultation Section -->
    <section class="consult-sec" id="contactSection">
        <div class="container-fluid px-5">
            <div class="consult-card">
                <div class="row align-items-center g-5">
                    <div class="col-lg-6">
                        <h2 class="fw-bold text-primary-dams mb-3">Consultation with our best doctors</h2>
                        <p class="text-muted mb-4">
                            Select a department and instantly schedule a slot. Or get in touch with our front desk team to receive manual guidance regarding a particular specialization.
                        </p>
<!-- Form Block -->
        <form class="consult-form row g-3" asp-controller="Account" asp-action="Login" method="get">
                            <div class="col-12">
                                <select class="form-select" name="department" aria-label="Select Speciality">
                                    <option value="" selected>Choose Medical Speciality...</option>
                                    <option value="Cardiologist">Cardiology</option>
                                    <option value="Neurologist">Neurology</option>
                                    <option value="Pediatrician">Pediatrics</option>
                                    <option value="Orthopedics">Orthopedics</option>
                                    <option value="Dermatologist">Dermatology</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <input type="date" class="form-control" name="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" placeholder="Choose Date" />
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-hero-primary w-100">
                                    <i class="bi bi-search me-2"></i> Find Schedules
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="col-lg-6">
                        <img src="~/Images/consultation_bg.png" alt="Medical consultation interface" class="consult-img img-fluid" />
                    </div>
                </div>
            </div>
        </div>
    </section>
